{
  "name": "game-steam",
  "version": "1.0.0",
  "private": true,
  "description": "Searchable Steam game catalog",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "import": "node scripts/import-games.js",
    "profiles:init": "node scripts/init-profiles.js",
    "profiles:research": "node --use-env-proxy scripts/research-steam.js",
    "search": "node bin/search-games.js",
    "start": "node src/server.js",
    "test": "node --test",
    "export:json": "python scripts/export_master_json.py",
    "content:fetch": "python scripts/enrich_game_content.py",
    "content:attach": "python scripts/enrich_game_content.py --attach-only",
    "content:translate": "python scripts/translate_game_content.py",
    "tags:fetch": "python scripts/enrich_steam_tags.py",
    "tags:attach": "python scripts/enrich_steam_tags.py --attach-only",
    "site:build": "python scripts/build_game_site.py",
    "site:local": "python local-site/serve.py",
    "site:local:build": "python scripts/build_game_site.py --output local-site",
    "site:html:build": "python scripts/build_html_package.py",
    "languages:fetch": "python scripts/enrich_steam_languages.py",
    "languages:attach": "python scripts/enrich_steam_languages.py --attach-only"
  }
}
