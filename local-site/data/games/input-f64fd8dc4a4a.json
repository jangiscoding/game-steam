onfidence":"high","status":"identified","verificationNotes":["The supplied name exactly matches the normalized official Steam name for the supplied App ID."],"research":{"steam":{"status":"success","checkedAt":"2026-10-15T10:57:54.742Z","error":null}},"steamMetadata":{"appId":"774181","links":{"store":"https://store.steampowered.com/app/774181/","officialWebsite":"https://rhythmdr.com/","support":"https://7thbe.at/"},"storageRequirements":{"kind":"required_free_space","windows":{"minimum":{"value":1,"unit":"GB","display":"1 GB","approximateBytes":1000000000,"evidenceText":"Storage: 1 GB"},"recommended":null},"macos":{"minimum":{"value":1,"unit":"GB","display":"1 GB","approximateBytes":1000000000,"evidenceText":"Storage: 1 GB"},"recommended":null},"linux":{"minimum":{"value":1,"unit":"GB","display":"1 GB","approximateBytes":1000000000,"evidenceText":"Storage: 1 GB"},"recommended":null},"note":"Steam publishes required free space, not the exact installed or download size."},"controllerSupport":{"level":"full","xboxCompatible":null,"xboxEvidence":null,"note":"Generic Steam controller support does not prove Xbox controller compatibility."},"playerModes":{"singlePlayer":true,"multiplayer":true,"coop":true,"onlineCoop":false,"localCoop":true,"lanCoop":false,"sharedOrSplitScreen":true,"pvp":false,"maximumPlayers":null,"maximumPlayersNote":"The public Steam app-details response does not provide a reliable exact player limit.","evidence":["Single-player","Multi-player","Co-op","Shared/Split Screen Co-op","Shared/Split Screen"]},"genres":["Action","Casual","Indie","Strategy","Free To Play"],"categories":[{"id":2,"description":"Single-player"},{"id":1,"description":"Multi-player"},{"id":9,"description":"Co-op"},{"id":39,"description":"Shared/Split Screen Co-op"},{"id":24,"description":"Shared/Split Screen"},{"id":22,"description":"Steam Achievements"},{"id":28,"description":"Full controller support"},{"id":30,"description":"Steam Workshop"},{"id":68,"description":"Custom Volume Controls"},{"id":78,"description":"Adjustable Difficulty"},{"id":71,"description":"Narrated Game Menus"},{"id":81,"description":"#category_playable_without_vision"},{"id":23,"description":"Steam Cloud"},{"id":17,"description":"Includes level editor"},{"id":44,"description":"Remote Play Together"},{"id":62,"description":"Family Sharing"}]}},"content":{"status":"success","steamAppId":"774181","steamName":"Rhythm Doctor","sourceUrl":"https://store.steampowered.com/app/774181/","fetchedAt":"2026-10-16T09:45:00.980252+00:00","locales":{"en":{"status":"source","provider":"steam","shortDescription":"Save patients with your rhythm mastery! Rhythm Doctor is a rhythm game where you heal patients by defibrillating in time to their heartbeats. Learn each patient's unique heartbeat and defeat boss viruses trying to sabotage your rhythm, all set to heart-pumping, soul-soothing music.","detailedDescription":"Save lives with your spacebar! \n\nRhythm Doctor is a rhythm game in a world where defibrillating patients' hearts in sync with their heartbeats has healing properties. Slam your spacebar in perfect time on the 7th beat, and they might just come out okay. But beware - every patient has unique illnesses based on complex music theory: polyrhythms, hemiolas, irregular time signatures...if you don't know what they mean, don't worry. Rhythm Doctor is designed to make you learn music and rhythm theory without even realising it!\n\n• 20+ handmade levels, each with their own story.\n\n• Every level introduces a different concept of rhythm theory in an accessible way\n\n• A large cast of doctors and patients feature in an overarching, character-centric storyline\n\n• Play the story solo or grab a friend for drop-in drop-out local multiplayer throughout the whole campaign!\n\n• Robust level editor to make, share, and play community levels! Use your own music, place notes snapped to the beat, and use 50+ different visual effects and backgrounds\n\n• Challenging \"Night Shift\" versions of each level for the brave\n\n(Note: 2P mode only works locally. Online 2P via Remote Play is enabled for this game, but it does not work that well right now due to varying latency)\n\nRhythm Doctor features flashing lights and colors. Please use caution if you have experience with epilepsy or any of its symptoms.","aboutGame":null},"vi":{"status":"translated","provider":"argos-translate-en_vi-1.9-ctranslate2-int8","translatedAt":"2026-10-16T13:24:50.797716+00:00","sourceHash":"7d72cf72effce0061a6ef46b3de73246a37d73a3c058c179fc2343e5ff0131b6","reviewStatus":"machine_translation_unreviewed","shortDescription":"Cứu các bệnh nhân bằng nhịp điệu của mình! Bác sĩ Rhythm là một trò chơi nhịp tim nơi bạn chữa lành bệnh nhân bằng cách khử trùng nhịp tim của họ. Hãy học nhịp tim độc đáo của mỗi bệnh nhân và những con virus đánh bại ông chủ cố gắng phá hoại nhịp điệu của bạn, tất cả được thiết lập để âm nhạc trái tim-xin, tâm hồn thư giãn.","detailedDescription":"Cứu mạng người với thanh vũ trụ của mình!\nRhythm Doctor là một trò chơi nhịp điệu trong một thế giới mà khử trùng tim bệnh nhân đồng bộ với nhịp tim của họ có tính chất chữa lành. Tập hợp thanh không gian của anh vào thời điểm hoàn hảo ở nhịp thứ 7, và chúng có thể sẽ ra được. Nhưng hãy cẩn thận - mỗi bệnh nhân đều có những căn bệnh đặc biệt dựa trên lý thuyết âm nhạc phức tạp: polyhythms, hemiolas, chữ ký không đều... nếu bạn không hiểu ý họ, đừng lo lắng. Bác sĩ thể dục được thiết kế để khiến bạn học âm nhạc và thuyết nhịp điệu mà thậm chí không cần phải nhận ra nó!\n• Mức độ làm thủ công 20+, mỗi cấp với câu chuyện riêng của họ.\n• Mỗi tầng đều đưa ra một khái niệm khác nhau về thuyết nhịp điệu theo cách có thể đạt được\n• Một nhóm lớn các bác sĩ và bệnh nhân trong một câu chuyện phóng đại, chủ nghĩa nhân cách\n• Chơi một mình hoặc tóm lấy một người bạn bỏ học nhiều người chơi trong suốt chiến dịch!\n• Người biên tập trình bày trình độ Robust để tạo, chia sẻ và chơi mức độ cộng đồng! Sử dụng âm nhạc riêng của bạn, ghi chú vị trí bị bẻ gãy theo nhịp, và sử dụng 50+ hiệu ứng hình ảnh và nền tảng khác nhau\n• Các phiên bản \"Night Shift\" của mỗi tầng dành cho những người dũng cảm\n(Tiếng Ý: chế độ 2P chỉ hoạt động tại địa phương. Trực tuyến 2P thông qua trò chơi từ xa được bật cho trò chơi này, nhưng nó không hoạt động tốt ngay bây giờ do sự khác biệt độ trễ\nKính thưa Tiến sĩ ánh sáng và màu sắc. Hãy cẩn thận nếu bạn bị động kinh hoặc triệu chứng nào của nó.","aboutGame":null}},"media":{"images":[{"role":"header","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/774181/header.jpg?t=1786548815"},{"role":"capsule","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/774181/capsule_231x87.jpg?t=1786548815"}],"screenshots":[{"id":0,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/774181/ss_e361a4f2de7594952b61522bb21a66713fe3f808.600x338.jpg?t=1786548815","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/774181/ss_e361a4f2de7594952b61522bb21a66713fe3f808.1920x1080.jpg?t=1786548815"},{"id":1,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/774181/ss_a8427224faf8062ed4eea2d3af9637934914a85c.600x338.jpg?t=1786548815","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/774181/ss_a8427224faf8062ed4eea2d3af9637934914a85c.1920x1080.jpg?t=1786548815"},{"id":2,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/774181/ss_0ad870eb7a1cc4315b17c2aaa2e54c0b5f220684.600x338.jpg?t=1786548815","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/774181/ss_0ad870eb7a1cc4315b17c2aaa2e54c0b5f220684.1920x1080.jpg?t=1786548815"},{"id":3,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/774181/ss_cb3a0ab6aaaf1bfb929e32bd8df05a3ffd7140e3.600x338.jpg?t=1786548815","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/774181/ss_cb3a0ab6aaaf1b