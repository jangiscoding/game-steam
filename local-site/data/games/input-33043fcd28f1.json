d App ID."],"research":{"steam":{"status":"success","checkedAt":"2026-10-15T11:22:04.019Z","error":null}},"steamMetadata":{"appId":"307110","links":{"store":"https://store.steampowered.com/app/307110/","officialWebsite":"http://weneedtogodeeper.com/","support":null},"storageRequirements":{"kind":"required_free_space","windows":{"minimum":{"value":1400,"unit":"MB","display":"1400 MB","approximateBytes":1400000000,"evidenceText":"Storage: 1400 MB"},"recommended":null},"macos":{"minimum":{"value":1400,"unit":"MB","display":"1400 MB","approximateBytes":1400000000,"evidenceText":"Storage: 1400 MB"},"recommended":null},"linux":{"minimum":null,"recommended":null},"note":"Steam publishes required free space, not the exact installed or download size."},"controllerSupport":{"level":"partial","xboxCompatible":null,"xboxEvidence":null,"note":"Generic Steam controller support does not prove Xbox controller compatibility."},"playerModes":{"singlePlayer":true,"multiplayer":true,"coop":true,"onlineCoop":true,"localCoop":false,"lanCoop":false,"sharedOrSplitScreen":false,"pvp":true,"maximumPlayers":null,"maximumPlayersNote":"The public Steam app-details response does not provide a reliable exact player limit.","evidence":["Single-player","Multi-player","PvP","Online PvP","Co-op","Online Co-op"]},"genres":["Action","Indie","Simulation"],"categories":[{"id":2,"description":"Single-player"},{"id":1,"description":"Multi-player"},{"id":49,"description":"PvP"},{"id":36,"description":"Online PvP"},{"id":9,"description":"Co-op"},{"id":38,"description":"Online Co-op"},{"id":27,"description":"Cross-Platform Multiplayer"},{"id":22,"description":"Steam Achievements"},{"id":29,"description":"Steam Trading Cards"},{"id":18,"description":"Partial Controller Support"},{"id":23,"description":"Steam Cloud"},{"id":25,"description":"Steam Leaderboards"},{"id":62,"description":"Family Sharing"}]}},"content":{"status":"success","steamAppId":"307110","steamName":"We Need To Go Deeper","sourceUrl":"https://store.steampowered.com/app/307110/","fetchedAt":"2026-10-16T08:53:18.443823+00:00","locales":{"en":{"status":"source","provider":"steam","shortDescription":"DIVE. DISCOVER. DIE. Crew a submarine with friends in We Need To Go Deeper - a 2-4-player cooperative submarine roguelike set in a Verne-inspired undersea universe.","detailedDescription":"MORE GAMES FROM DELI INTERACTIVE\n\nDELUXE EDITION\n\nAbout the Game\n\n DIVE. DISCOVER. DIE. Crew a submarine with friends in We Need To Go Deeper - a 2-4-player cooperative submarine roguelike set in a Verne-inspired undersea universe.\n2-4-Player Online Co-op\nDesigned with human interaction in mind, in We Need to Go Deeper you communicate or perish. Play with friends, strangers, or bots!\nCrew Your Submarine\nPilot, repair, load torpedoes and reroute power as you and your crew dash around one of several unlockable submarines on your voyage into the deep.\nExplore The Living Infinite\nThe Living Infinite is an ever-changing undersea trench – with randomized biomes, on-foot expeditions, loot, civilizations and a dynamic difficulty system to keep you guessing every time you take a dive.\nWield a Variety of Tools\nFrom wrenches, to wedding rings, to electricity-powered weaponry, a wide selection of tools and weapons await discovery.\nCustomize Your Adventurer\nChoose from a wide variety of era-specific outfits from the 19th century so you can dive in style! Non-gender-specific mustaches included.\n\nGo even deeper with the Buried Treasure Edition! Here's a look at what's included:\n\nA 197 Page Digital Art Book written by WNTGD artist Nick Lives. Including concept art, mockups, and scrapped content, even the ugly stuff for an authentic look behind the scenes.\n\nA 35 track Extended Soundtrack! Comes with the full in-game OST alongside 13 cut tracks from throughout development! Featuring the musical talents of Jake Lives, Jordan Farr, David Johnsen and Rebecca Mijares.","aboutGame":"DIVE. DISCOVER. DIE. Crew a submarine with friends in We Need To Go Deeper - a 2-4-player cooperative submarine roguelike set in a Verne-inspired undersea universe.\n2-4-Player Online Co-op\nDesigned with human interaction in mind, in We Need to Go Deeper you communicate or perish. Play with friends, strangers, or bots!\nCrew Your Submarine\nPilot, repair, load torpedoes and reroute power as you and your crew dash around one of several unlockable submarines on your voyage into the deep.\nExplore The Living Infinite\nThe Living Infinite is an ever-changing undersea trench – with randomized biomes, on-foot expeditions, loot, civilizations and a dynamic difficulty system to keep you guessing every time you take a dive.\nWield a Variety of Tools\nFrom wrenches, to wedding rings, to electricity-powered weaponry, a wide selection of tools and weapons await discovery.\nCustomize Your Adventurer\nChoose from a wide variety of era-specific outfits from the 19th century so you can dive in style! Non-gender-specific mustaches included.\n\nGo even deeper with the Buried Treasure Edition! Here's a look at what's included:\n\nA 197 Page Digital Art Book written by WNTGD artist Nick Lives. Including concept art, mockups, and scrapped content, even the ugly stuff for an authentic look behind the scenes.\n\nA 35 track Extended Soundtrack! Comes with the full in-game OST alongside 13 cut tracks from throughout development! Featuring the musical talents of Jake Lives, Jordan Farr, David Johnsen and Rebecca Mijares."},"vi":{"status":"pending_translation","provider":null,"shortDescription":null,"detailedDescription":null,"aboutGame":null}},"media":{"images":[{"role":"header","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/307110/header.jpg?t=1691439811"},{"role":"capsule","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/307110/capsule_231x87.jpg?t=1691439811"},{"role":"description","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/307110/extras/98974da57fbf