r the supplied App ID."],"research":{"steam":{"status":"success","checkedAt":"2026-10-15T09:57:43.498Z","error":null}},"steamMetadata":{"appId":"1449500","links":{"store":"https://store.steampowered.com/app/1449500/","officialWebsite":null,"support":"https://dovetailgames.freshdesk.com/support/home"},"storageRequirements":{"kind":"required_free_space","windows":{"minimum":{"value":21,"unit":"GB","display":"21 GB","approximateBytes":21000000000,"evidenceText":"Storage: 21 GB"},"recommended":null},"macos":{"minimum":null,"recommended":null},"linux":{"minimum":null,"recommended":null},"note":"Steam publishes required free space, not the exact installed or download size."},"controllerSupport":{"level":"full","xboxCompatible":null,"xboxEvidence":null,"note":"Generic Steam controller support does not prove Xbox controller compatibility."},"playerModes":{"singlePlayer":true,"multiplayer":true,"coop":false,"onlineCoop":false,"localCoop":false,"lanCoop":false,"sharedOrSplitScreen":false,"pvp":false,"maximumPlayers":null,"maximumPlayersNote":"The public Steam app-details response does not provide a reliable exact player limit.","evidence":["Single-player","Multi-player"]},"genres":["Simulation","Sports"],"categories":[{"id":2,"description":"Single-player"},{"id":1,"description":"Multi-player"},{"id":27,"description":"Cross-Platform Multiplayer"},{"id":28,"description":"Full controller support"},{"id":62,"description":"Family Sharing"}]}},"content":{"status":"success","steamAppId":"1449500","steamName":"Bassmaster® Fishing","sourceUrl":"https://store.steampowered.com/app/1449500/","fetchedAt":"2026-10-16T08:04:22.326700+00:00","locales":{"en":{"status":"source","provider":"steam","shortDescription":"Bassmaster® Fishing, the official video game is OUT NOW, bringing the thrill of competitive big bass fishing to PC. Dive into the fully licensed content from the Bassmaster series from amateur to elite events.","detailedDescription":"Bassmaster Fishing 2022, the official video game of B.A.S.S. is coming this Fall, bringing the thrill of competitive big bass fishing to PC. Dive into the fully licensed content from the Bassmaster series from amateur to elite events. Manage your sponsors, equip your dream setup, and customise the look of your angler to tackle the Bassmaster series.\n\nFor the first time ever, compete as or challenge pro anglers from the Elite tour across 8 different real-world venues. Climb the ranks, earn your sponsors, and progress through your B.A.S.S. career to become the Bassmaster Classic Champion. Or take to the water and compete with other players in a variety of all-new massive multiplayer modes to conquer the global leader boards.\n\nPowered by the Unreal Engine, you’ll lose yourself in beautiful environments, with a variety of fish species and a diverse range of equipment that will immerse you in the world of Bassmaster. The challenge doesn’t stop at the Bassmaster Classic, master in-game seasonal challenges to collect cosmetic items & equipment so you can show off your skill when fishing on the lake.\nKey Features: \n \n\n•  Exclusive B.A.S.S. Content - Equip and use a vast selection of licensed content such as Yamaha Outboard motors, Skeeter Boats, Missile Baits, and much more!\n\n•  10 Pro Anglers – Play as or compete against legends like Scott Martin, Hank Cherry and 8 other official pro anglers.\n\n•  8 Official venues – Take to the water on 8 real-world venues and explore everything from Sabine Rivers back waters to the huge open horizons on Lake Hamilton.\n\n•  Our Largest Multiplayer – Take on the vast Bassmaster Fishing 2022 online modes. Climb the global leader boards, jump into cross play modes, or be the champion in Bassmaster Royale.\n\n•  Career Mode - Compete throughout the College Series, Opens and Elite Series and progress to the Bassmaster Classic to become the champion. With Dave Mercer the official tournament announcer to host your weigh ins as you chart your course for success, increasing your following with big catches and bigger partners with the new sponsors system.\n\n•  Gameplay fundamentals – Fish from a new perspective with the underwater camera, explore and mark up venues with the new GPS map system, and finesse fishing around weeds with the right equipment to avoid snagging.\n\n•  Fish AI and movement – Be the best bass angler by hunting out those lunkers. Fish will move around the water looking for points of interest and also at different depths due to the dynamic time of day system.","aboutGame":null},"vi":{"status":"pending_translation","provider":null,"shortDescription":null,"detailedDescription":null,"aboutGame":null}},"media":{"images":[{"role":"header","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1449500/header.jpg?t=1750778165"},{"role":"capsule","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1449500/capsule_231x87.jpg?t=1750778165"},{"role":"description","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1449500/extras/f576ecd87ff03c971b2ebc360bf400d9.avif?t=1750778165","alt":""},{"role":"description","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1449500/extras/a271ea4b793aa1d4fc7036f9d52d1186.avif?t=1750778165","alt":""},{"role":"description","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1449500/extras/9563786c8abba0bdff6beeda35614be0.avif?t=1750778165","alt":""},{"role":"description","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1449500/extras/485f2ac8355252168365b2f53499757b.avif?t=1750778165","alt":""},{"role":"description","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1449500/extras/54e71883a2d055e82c9b4365f76b6ec4.avif?t=1750778165","alt":""},{"role":"description","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1449500/extras/a730beb7daf0f60c4e75a482e8c13a81.avif?t=1750778165","alt":""},{"role":"description","url":"https: