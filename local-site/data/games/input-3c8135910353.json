rmalized official Steam name for the supplied App ID."],"research":{"steam":{"status":"success","checkedAt":"2026-10-15T10:01:25.339Z","error":null}},"steamMetadata":{"appId":"686200","links":{"store":"https://store.steampowered.com/app/686200/","officialWebsite":"https://inthekillhouse.com/actionsquad/","support":"https://inthekillhouse.com/contact"},"storageRequirements":{"kind":"required_free_space","windows":{"minimum":{"value":100,"unit":"MB","display":"100 MB","approximateBytes":100000000,"evidenceText":"Storage: 100 MB"},"recommended":{"value":100,"unit":"MB","display":"100 MB","approximateBytes":100000000,"evidenceText":"Storage: 100 MB"}},"macos":{"minimum":null,"recommended":null},"linux":{"minimum":null,"recommended":null},"note":"Steam publishes required free space, not the exact installed or download size."},"controllerSupport":{"level":"full","xboxCompatible":null,"xboxEvidence":null,"note":"Generic Steam controller support does not prove Xbox controller compatibility."},"playerModes":{"singlePlayer":true,"multiplayer":true,"coop":true,"onlineCoop":true,"localCoop":true,"lanCoop":false,"sharedOrSplitScreen":true,"pvp":false,"maximumPlayers":null,"maximumPlayersNote":"The public Steam app-details response does not provide a reliable exact player limit.","evidence":["Single-player","Multi-player","Co-op","Online Co-op","Shared/Split Screen Co-op","Shared/Split Screen"]},"genres":["Action","Casual","Indie","Simulation","Strategy"],"categories":[{"id":2,"description":"Single-player"},{"id":1,"description":"Multi-player"},{"id":9,"description":"Co-op"},{"id":38,"description":"Online Co-op"},{"id":39,"description":"Shared/Split Screen Co-op"},{"id":24,"description":"Shared/Split Screen"},{"id":22,"description":"Steam Achievements"},{"id":28,"description":"Full controller support"},{"id":29,"description":"Steam Trading Cards"},{"id":30,"description":"Steam Workshop"},{"id":23,"description":"Steam Cloud"},{"id":15,"description":"Stats"},{"id":25,"description":"Steam Leaderboards"},{"id":17,"description":"Includes level editor"},{"id":43,"description":"Remote Play on TV"},{"id":44,"description":"Remote Play Together"},{"id":62,"description":"Family Sharing"}]}},"content":{"status":"success","steamAppId":"686200","steamName":"Door Kickers: Action Squad","sourceUrl":"https://store.steampowered.com/app/686200/","fetchedAt":"2026-10-16T09:38:15.948325+00:00","locales":{"en":{"status":"source","provider":"steam","shortDescription":"Rescue hostages, disarm bombs and save the day in this old school, side-scroller action game with retro graphics and retro sensibilities. Online and Couch Coop Included.","detailedDescription":"Door Kickers: Action Squad is a crazy old school side-scroller action game that puts you in the role of a SWAT trooper and sends you to deal with the bad guys in Nowhere City USA.\n\nChoose your gear, then kick the doors down and face the action. Adapt and react by the seat of your pants, and if needed - restart without a care and rethink. Master weapons recoil and time your reloads, use distance and cover to your advantage and use the in-game Strategic Abilities to decide for yourself when healthpacks or gear refills are needed, or if that team-mate of yours is worth saving. Or just save up the Points earned and unleash your Ultimate to waltz through that tricky final room.  \n\nAnd when it gets too hard, bring over a friend to help. \n\nQuick Points:\n\n• High detail retro graphics\n\n• 6 playable characters, each with unique gameplay and level up options\n\n• Unique in-game Strategic Abilities system\n\n• 84 non linear levels to complete \n\n• 60 weapons and gear items\n\n• 20+ enemy types and 4 mission objectives\n\n• Zombie invasion mode allowing you to play the game again in a new way\n\n• Couch and Online Cooperative Multiplayer","aboutGame":null},"vi":{"status":"translated","provider":"argos-translate-en_vi-1.9-ctranslate2-int8","translatedAt":"2026-10-16T13:20:00.773713+00:00","sourceHash":"4678cc3143509c14448a241b55e4ba594e4c42439964f648b99919c0693ee435","reviewStatus":"machine_translation_unreviewed","shortDescription":"Giải cứu con tin, gỡ bom và cứu lấy cái ngày ở cái trường cũ kỹ này, trò chơi hành động bên lề với đồ họa ngược và sự nhạy cảm ngược. Trực tuyến và Coch Coop đã bao gồm.","detailedDescription":"Đội Hành Động là một trò chơi hành động điên rồ mà đặt bạn vào vai của một đội SWAT và gửi bạn đến để đối phó với những kẻ xấu ở Không Thành phố Mỹ.\nChọn đồ nghề, rồi đạp cửa xuống và đối mặt với hành động. Thích nghi và phản ứng theo chỗ ngồi của quần bạn, và nếu cần khởi động lại mà không cần phải suy nghĩ lại. Vũ khí hạng nặng làm giảm tải và thời gian nạp đạn, sử dụng khoảng cách và che đậy lợi thế của bạn và sử dụng các yếu tố chiến lược trong trò chơi để tự quyết định khi cần thiết cho các hộp y tế hoặc thiết bị cung cấp lại, hoặc nếu đồng đội của bạn là đáng cứu. Hoặc chỉ cần tiết kiệm cho các điểm kiếm được và giải phóng khả năng tối thượng của bạn để nhảy qua căn phòng cuối cùng khó khăn đó.\nVà khi mọi chuyện trở nên quá khó khăn, hãy mang đến một người bạn để giúp đỡ.\nĐiểm nhanh:\n• Đồ họa nhiều chi tiết được mô tả lại\n• 6 ký tự có thể nghịch, mỗi ký tự chơi một trò chơi và nâng cao các tùy chọn\n• Hệ thống các khả năng chiến lược độc đáo\n• 84 cấp không tuyến tính cần hoàn tất\n• 60 vũ khí và dụng cụ\n• 20+ Kiểu kẻ thù và 4 mục tiêu nhiệm vụ\n• Chế độ xâm lược của thây ma cho phép bạn chơi lại trò chơi theo một cách mới\n• Nhiều người chơi hợp tác trên mạng và couch","aboutGame":null}},"media":{"images":[{"role":"header","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/686200/header.jpg?t=1725308354"},{"role":"capsule","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/686200/capsule_231x87.jpg?t=1725308354"}],"screenshots":[{"id":0,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/686200/ss_8d0c35098d1c4036f0dd7f9cd8d7c9c41ed6e374.600x338.jpg?t=1725308354","