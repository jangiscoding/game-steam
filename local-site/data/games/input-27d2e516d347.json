{"id":"input-27d2e516d347","steamAppId":"1078000","name":"Gamecraft","imageUrl":"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/1078000/library_600x900.jpg","imageStatus":"downloaded","steamUrl":"https://store.steampowered.com/app/1078000/","genres":["Indie","Simulation","Early Access"],"platforms":["windows"],"controllerSupport":"unknown","playerModes":{"singlePlayer":true,"multiplayer":false,"coop":false,"localCoop":false,"sharedOrSplitScreen":false,"onlineCoop":false,"maximumPlayers":null},"storage":{"windowsMinimumGB":2.0,"windowsMinimumDisplay":"2 GB"},"verificationStatus":"identified","custom":{},"sourceProfile":{"inputRecordId":"input-27d2e516d347","canonicalId":"steam-app-1078000","suppliedName":"Gamecraft","suppliedImageUrl":"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/1078000/library_600x900.jpg","officialName":"Gamecraft","aliases":[],"series":null,"franchise":null,"productType":"game","editionName":null,"originalReleaseYear":null,"identifiedVersionReleaseYear":2019,"developers":["Freejam"],"publishers":["Freejam"],"platforms":["windows"],"genres":["Indie","Simulation","Early Access"],"shortDescription":"Make your own games in this powerful sandbox building engine. Vehicle simulators, first person shooters! No coding knowledge required, create games using blocks and then publish them online for others to play. BUILD IT, PLAY IT, SHARE IT!","confusingWith":[],"candidateIdentifiers":{"steamAppId":"1078000"},"sources":[{"label":"Steam Store","url":"https://store.steampowered.com/app/1078000/","accessedAt":"2026-10-15T10:28:50.901Z","supports":["officialName","productType","identifiedVersionReleaseYear","developers","publishers","platforms","genres","shortDescription","steamMetadata.links","steamMetadata.storageRequirements","steamMetadata.controllerSupport","steamMetadata.playerModes"]}],"confidence":"high","status":"identified","verificationNotes":["The supplied name exactly matches the normalized official Steam name for the supplied App ID."],"research":{"steam":{"status":"success","checkedAt":"2026-10-15T10:28:50.901Z","error":null}},"steamMetadata":{"appId":"1078000","links":{"store":"https://store.steampowered.com/app/1078000/","officialWebsite":null,"support":"https://support.freejamgames.com/hc/en-us"},"storageRequirements":{"kind":"required_free_space","windows":{"minimum":{"value":2,"unit":"GB","display":"2 GB","approximateBytes":2000000000,"evidenceText":"Storage: 2 GB"},"recommended":{"value":2,"unit":"GB","display":"2 GB","approximateBytes":2000000000,"evidenceText":"Storage: 2 GB"}},"macos":{"minimum":null,"recommended":null},"linux":{"minimum":null,"recommended":null},"note":"Steam publishes required free space, not the exact installed or download size."},"controllerSupport":{"level":"unknown","xboxCompatible":null,"xboxEvidence":null,"note":"Generic Steam controller support does not prove Xbox controller compatibility."},"playerModes":{"singlePlayer":true,"multiplayer":false,"coop":false,"onlineCoop":false,"localCoop":false,"lanCoop":false,"sharedOrSplitScreen":false,"pvp":false,"maximumPlayers":null,"maximumPlayersNote":"The public Steam app-details response does not provide a reliable exact player limit.","evidence":["Single-player"]},"genres":["Indie","Simulation","Early Access"],"categories":[{"id":2,"description":"Single-player"},{"id":30,"description":"Steam Workshop"},{"id":17,"description":"Includes level editor"},{"id":62,"description":"Family Sharing"}]}},"content":{"status":"success","steamAppId":"1078000","steamName":"Gamecraft","sourceUrl":"https://store.steampowered.com/app/1078000/","fetchedAt":"2026-10-16T07:40:49.461455+00:00","locales":{"en":{"status":"source","provider":"steam","shortDescription":"Make your own games in this powerful sandbox building engine. Vehicle simulators, first person shooters! No coding knowledge required, create games using blocks and then publish them online for others to play. BUILD IT, PLAY IT, SHARE IT!","detailedDescription":"Just Updated\n\nA super-powerful new sandbox building game from the creators of Robocraft.\n\nBuild complete working games from blocks and parts without the need to code using one of the most powerful sandbox building engines available. Build games in minutes and publish them to the cloud for others to play with the click of a button. Play many games created by the Gamecraft community, rate them, comment on them, subscribe to them, with new games being published every day.\n\nAbout the Game\n\nA super-powerful new sandbox building game from the creators of Robocraft.\n\nGamecraft is one of the most powerful sandbox building engines available. Build complete working games from blocks and parts without the need to code! \n\nBuild games in minutes and publish them to the cloud for others to play with the click of a button. Play many games created by the Gamecraft community, rate them, comment on them and subscribe to them. Build it, play it, share it!\nBUILD GAMES\n\nDriving simulators, first person shooters, pinball machines, 3D platformers and anything in between! A versatile block building engine lets you create games of all kinds without needing to code.\nNO CODING REQUIRED\n\nOur intuitive wiring system makes it easy to wire complex contraptions, vehicles, logic and so much more, all with a few simple clicks. You can duplicate and modify these creations in no time at all.\n\nThe recently added blueprints system lets you download sets from the community drop into your own games! Making it easier than ever to build and create games.\nSTUPENDOUS PHYSICS\n\nOne of the most powerful and open sandbox physics engines on the market. Thousands of rigid-bodies, complex physics simulated joints, and an immensely powerful and optimised destruction system open up so many possibilities for sandbox building fans.\nPLAY GAMES MADE BY THE COMMUNITY\n\nPlay hundreds of games created by the Gamecraft community. Pick from Platformers, Shooters, Racing, Puzzle, Adventure and many more genres. Rate them, comment on them, subscribe to them. New games are published every day.\nSHARE YOUR CREATIONS\n\nWith Workshop integration you can publish your games and other amazing creations for the Gamecraft community. Share your incredible contraptions, levels and vehicles with others to create large scale projects together.\nPLANNED FEATURES\n\n• MULTIPLAYER - Craft and Play PvP, Co-op online and locally hosted multiplayer games\n\n• CO-OP CRAFTING - Collaborate and build in real-time with friends\n\n• AI UNITS - AI enemies and AI-controlled vehicles for PVE games\n\n• BUILD EM UPS - Support for multiplayer games where players battle and race with their own purpose-built machines","aboutGame":"A super-powerful new sandbox building game from the creators of Robocraft.\n\nGamecraft is one of the most powerful sandbox building engines available. Build complete working games from blocks and parts without the need to code! \n\nBuild games in minutes and publish them to the cloud for others to play with the click of a button. Play many games created by the Gamecraft community, rate them, comment on them and subscribe to them. Build it, play it, share it!\nBUILD GAMES\n\nDriving simulators, first person shooters, pinball machines, 3D platformers and anything in between! A versatile block building engine lets you create games of all kinds without needing to code.\nNO CODING REQUIRED\n\nOur intuitive wiring system makes it easy to wire complex contraptions, vehicles, logic and so much more, all with a few simple clicks. You can duplicate and modify these creations in no time at all.\n\nThe recently added blueprints system lets you download sets from the community drop into your own games! Making it easier than ever to build and create games.\nSTUPENDOUS PHYSICS\n\nOne of the most powerful and open sandbox physics engines on the market. Thousands of rigid-bodies, complex physics simulated joints, and an immensely powerful and optimised destruction system open up so many possibilities for sandbox building fans.\nPLAY GAMES MADE BY THE COMMUNITY\n\nPlay hundreds of games created by the Gamecraft community. Pick from Platformers, Shooters, Racing, Puzzle, Adventure and many more genres. Rate them, comment on them, subscribe to them. New games are published every day.\nSHARE YOUR CREATIONS\n\nWith Workshop integration you can publish your games and other amazing creations for the Gamecraft community. Share your incredible contraptions, levels and vehicles with others to create large scale projects together.\nPLANNED FEATURES\n\n• MULTIPLAYER - Craft and Play PvP, Co-op online and locally hosted multiplayer games\n\n• CO-OP CRAFTING - Collaborate and build in real-time with friends\n\n• AI UNITS - AI enemies and AI-controlled vehicles for PVE games\n\n• BUILD EM UPS - Support for multiplayer games where players battle and race with their own purpose-built machines"},"vi":{"status":"pending_translation","provider":null,"shortDescription":null,"detailedDescription":null,"aboutGame":null}},"media":{"images":[{"role":"header","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1078000/header.jpg?t=1611187828"},{"role":"capsule","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1078000/capsule_231x87.jpg?t=1611187828"},{"role":"description","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1078000/extras/f320176794bd8d954bd1166a8acb6b7a.avif?t=1611187828","alt":""}],"screenshots":[{"id":0,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1078000/ss_fb09298da06e2a03c9b462ae22c806f3a731fbe1.600x338.jpg?t=1611187828","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1078000/ss_fb09298da06e2a03c9b462ae22c806f3a731fbe1.1920x1080.jpg?t=1611187828"},{"id":1,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1078000/ss_4109455dba2f4e6788b6c783bf183f4affcdd80d.600x338.jpg?t=161