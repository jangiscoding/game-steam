{"id":"input-5fa7a90ad189","steamAppId":"233860","name":"Kenshi","imageUrl":"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/233860/589fd26c9c30421a7472a1b9934098c9affd439b/library_capsule.jpg","imageStatus":"downloaded","steamUrl":"https://store.steampowered.com/app/233860/","genres":["Action","Indie","RPG","Simulation","Strategy"],"platforms":["windows"],"controllerSupport":"unknown","playerModes":{"singlePlayer":true,"multiplayer":false,"coop":false,"localCoop":false,"sharedOrSplitScreen":false,"onlineCoop":false,"maximumPlayers":null},"storage":{"windowsMinimumGB":14.0,"windowsMinimumDisplay":"14 GB"},"verificationStatus":"identified","custom":{},"sourceProfile":{"inputRecordId":"input-5fa7a90ad189","canonicalId":"steam-app-233860","suppliedName":"Kenshi","suppliedImageUrl":"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/233860/589fd26c9c30421a7472a1b9934098c9affd439b/library_capsule.jpg","officialName":"Kenshi","aliases":[],"series":null,"franchise":null,"productType":"game","editionName":null,"originalReleaseYear":null,"identifiedVersionReleaseYear":2018,"developers":["Lo-Fi Games"],"publishers":["Lo-Fi Games"],"platforms":["windows"],"genres":["Action","Indie","RPG","Simulation","Strategy"],"shortDescription":"A free-roaming squad based RPG. Focusing on open-ended sandbox gameplay features rather than a linear story. Be a trader, a thief, a rebel, a warlord, an adventurer, a farmer, a slave, or just food for the cannibals. Train your men up from puny victims to master warriors.","confusingWith":[],"candidateIdentifiers":{"steamAppId":"233860"},"sources":[{"label":"Steam Store","url":"https://store.steampowered.com/app/233860/","accessedAt":"2026-10-15T10:38:16.819Z","supports":["officialName","productType","identifiedVersionReleaseYear","developers","publishers","platforms","genres","shortDescription","steamMetadata.links","steamMetadata.storageRequirements","steamMetadata.controllerSupport","steamMetadata.playerModes"]}