{"id":"input-69da5131f6c2","steamAppId":"402710","name":"Osiris: New Dawn","imageUrl":"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/402710/library_600x900.jpg","imageStatus":"downloaded","steamUrl":"https://store.steampowered.com/app/402710/","genres":["Action","Adventure","Indie","RPG"],"platforms":["windows"],"controllerSupport":"partial","playerModes":{"singlePlayer":true,"multiplayer":true,"coop":true,"localCoop":false,"sharedOrSplitScreen":false,"onlineCoop":true,"maximumPlayers":null},"storage":{"windowsMinimumGB":4.0,"windowsMinimumDisplay":"4 GB"},"verificationStatus":"identified","custom":{},"sourceProfile":{"inputRecordId":"input-69da5131f6c2","canonicalId":"steam-app-402710","suppliedName":"Osiris: New Dawn","suppliedImageUrl":"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/402710/library_600x900.jpg","officialName":"Osiris: New Dawn","aliases":[],"series":null,"franchise":null,"productType":"game","editionName":null,"originalReleaseYear":null,"identifiedVersionReleaseYear":2023,"developers":["Fenix Fire Entertainment"],"publishers":["Fenix Fire Entertainment"],"platforms":["windows"],"genres":["Action","Adventure","Indie","RPG"],"shortDescription":"Osiris: New Dawn is an unforgiving near future space survival game with a cinematic feel and elements of horror. Play as a Mission Specialist in single or multiplayer to build your planetary base, pilotable vehicles, and controllable drones as you explore a dangerous solar system far from Earth.","confusingWith":[],"candidateIdentifiers":{"steamAppId":"402710"},"sources":[{"label":"Steam Store","url":"https://store.steampowered.com/app/402710/","accessedAt":"2026-10-15T10:50:51.130Z","supports":["officialName","productType","identifiedVersionReleaseYear","developers","publishers","platforms","genres","shortDescription","steamMetadata.links","steamMetadata.storageRequirements","steamMetadata.controllerSupport","steamMetadata.playerModes"]}],"confidence":"high","status":"identified","verificationNotes":["The supplied name exactly matches the normalized official Steam name for the supplied App ID."],"research":{"steam":{"status":"success","checkedAt":"2026-10-15T10:50:51.130Z","error":null}},"steamMetadata":{"appId":"402710","links":{"store":"https://store.steampowered.com/app/402710/","officialWebsite":"https://www.osirisnewdawn.com/","support":"https://www.osirisnewdawn.com/"},"storageRequirements":{"kind":"required_free_space","windows":{"minimum":{"value":4,"unit":"GB","display":"4 GB","approximateBytes":4000000000,"evidenceText":"Storage: 4 GB"},"recommended":{"value":4,"unit":"GB","display":"4 GB","approximateBytes":4000000000,"evidenceText":"Storage: 4 GB"}},"macos":{"minimum":null,"recommended":null},"linux":{"minimum":null,"recommended":null},"note":"Steam publishes required free space, not the exact installed or download size."},"controllerSupport":{"level":"partial","xboxCompatible":null,"xboxEvidence":null,"note":"Generic Steam controller support does not prove Xbox controller compatibility."},"playerModes":{"singlePlayer":true,"multiplayer":true,"coop":true,"onlineCoop":true,"localCoop":false,"lanCoop":false,"sharedOrSplitScreen":false,"pvp":true,"maximumPlayers":null,"maximumPlayersNote":"The public Steam app-details response does not provide a reliable exact player limit.","evidence":["Single-player","Multi-player","PvP","Online PvP","Co-op","Online Co-op"]},"genres":["Action","Adventure","Indie","RPG"],"categories":[{"id":2,"description":"Single-player"},{"id":1,"description":"Multi-player"},{"id":49,"description":"PvP"},{"id":36,"description":"Online PvP"},{"id":9,"description":"Co-op"},{"id":38,"description":"Online Co-op"},{"id":18,"description":"Partial Controller Support"},{"id":62,"description":"Family Sharing"}]}},"content":{"status":"success","steamAppId":"402710","steamName":"Osiris: New Dawn","sourceUrl":"https://store.steampowered.com/app/402710/","fetchedAt":"2026-10-16T09:11:02.210382+00:00","locales":{"en":{"status":"source","provider":"steam","shortDescription":"Osiris: New Dawn is an unforgiving near future space survival game with a cinematic feel and elements of horror. Play as a Mission Specialist in single or multiplayer to build your planetary base, pilotable vehicles, and controllable drones as you explore a dangerous solar system far from Earth.","detailedDescription":"An open world, hard science, survival game inspired by the edgier side of sci fi. Also includes our Experimental Build, which is used for public testing.\nYour Mission For Mankind\nYou are on a resupply mission in the far reaches of space in hopes of finding and colonizing habitable planets to replace our dying Earth. Space is dangerous. Anything can, and likely will, go wrong. All of mankind is counting on your success.\nStrategize Your Survival\nExplore and build by day and brace yourself for the night. Bunker down or stage weaponized attacks. Survival is not guaranteed, and you will be tested to your limits.\nExplore, Build, Research\nGather resources and materials to survive, build modular structures to grow food and create manufacturing bays, research new technologies to upgrade gear and build new vehicles, and explore new worlds to discover the unknown in this harsh alien solar system.\nVast Atmospheric Worlds\nDiscover strange and terrifying alien creatures, each unique to its ecosystem and planet. Dynamic and dangerous weather patterns can help or harm your survival efforts. Strange foliage populates unique biomes across the solar system.\nChoose Your Playstyle\nPlay in single player Story, Sandbox, or Challenge modes. Or set up your own free server with your rules and play how you want.","aboutGame":null},"vi":{"status":"translated","provider":"argos-translate-en_vi-1.9-ctranslate2-int8","translatedAt":"2026-10-16T12:59:21.542799+00:00","sourceHash":"d9f62d6d18401a2be851bcd8be1f6ab76a9bddd26feda7e52a68abcf1aba2442","reviewStatus":"machine_translation_unreviewed","shortDescription":"“ Bình minh mới ” là một trò chơi sống sót không khoan dung gần như không tha thứ với cảm giác của phim ảnh và yếu tố của sự kinh hoàng. Hãy chơi với tư cách là chuyên gia của một hoặc nhiều người chơi để xây dựng căn cứ hành tinh của bạn, những phương tiện điều khiển được, và máy bay không người lái có thể điều khiển khi bạn khám phá một hệ mặt trời nguy hiểm xa Trái đất.","detailedDescription":"Một thế giới mở, khoa học cứng rắn, cuộc sống sót lấy cảm hứng từ phía edgier của sci fi. Cũng bao gồm việc xây dựng thử nghiệm, được dùng để thử nghiệm công cộng. Nhiệm vụ của bạn đối với nhân loại Các bạn đang thực hiện một nhiệm vụ dự phòng ở những vùng xa xôi của không gian với hy vọng tìm ra và định cư để thay thế Trái Đất đang chết dần. Không gian rất nguy hiểm. Bất cứ điều gì có thể, và rất có thể sẽ xảy ra. Cả nhân loại đang trông chờ vào sự thành công của bạn. Hãy chiến đấu để sống sót Khám phá và xây dựng vào ban ngày và chuẩn bị tinh thần cho đêm nay. Đang bị hạ hoặc bị vũ khí hóa. Không bảo đảm là bạn sẽ được sống sót, và bạn sẽ bị thử thách đến cùng. Khám phá, xây dựng, nghiên cứu Thu thập tài nguyên và vật liệu để tồn tại, xây dựng các cấu trúc mô-đun để trồng trọt thực phẩm và tạo ra các vịnh sản xuất, nghiên cứu công nghệ mới để nâng cấp thiết bị và xây dựng các phương tiện mới, và khám phá các thế giới mới để khám phá những điều chưa biết trong hệ mặt trời khắc nghiệt này. Thế giới đa vũ trụ Khám phá những sinh vật lạ lùng và đáng sợ của người ngoài hành tinh, mỗi sinh vật có hệ sinh thái và hành tinh riêng. Những thời tiết khắc nghiệt và nguy hiểm có thể giúp bạn sống sót hoặc gây tổn hại. Lá cây lạ thường sinh sôi nảy nở một cách độc đáo trên thái dương hệ. Chọn kiểu chơi Chơi trong trò chơi độc lập Story, Sandbox, hay trong chế độ thách thức. Hoặc tự lập ra máy chủ miễn phí với luật lệ của bạn và chơi theo cách bạn muốn.","aboutGame":null}},"media":{"images":[{"role":"header","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/402710/header.jpg?t=1745496432"},{"role":"capsule","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/402710/capsule_231x87.jpg?t=1745496432"}],"screenshots":[{"id":0,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/402710/ss_ec3b32b89d1667489ba4df6c9f818e7675780ff8.600x338.jpg?t=1745496432","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/402710/ss_ec3b32b89d1667489ba4df6c9f818e7675780ff8.1920x1080.jpg?t=1745496432"},{"id":1,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/402710/ss_1d19147157c5b061b3307b4bfee2d4ad34ade0be.600x338.jpg?t=1745496432","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/402710/ss_1d19147157c5b061b3307b4bfee2d4ad34ade0be.1920x1080.jpg?t=1745496432"},{"id":2,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/402710/ss_941b0910f11e2b62227f9b6a8019c6138af56a4a.600x338.jpg?t=1745496432","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/402710/ss_941b0910f11e2b62227f9b6a8019c6138af56a4a.1920x1080.jpg?t=1745496432"},{"id":3,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/402710/ss_694b83983c6b5bf00e8b6371334b84a320e941b4.600x338.jpg?t=1745496432","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/402710/ss_694b83983c6b5bf00e8b6371334b84a320e941b4.1920x1080.jpg?t=1745496432"},{"id":4,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/402710/ss_b5253b01f734ff7b317aaea208fdf6852d397169.600x338.jpg?t=1745496432","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/402710/ss_b5253b01f734ff7b317aaea208fdf6852d397169.1920x1080.jpg?t=1745496432"},{"id":5,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/402710/ss_c639d571a4d48ac20feb34449ea38d7fcfac08a5.600x338.jpg?t=1745496432","url":"https://shared.akamai.steamstatic.com