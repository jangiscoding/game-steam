plied App ID."],"research":{"steam":{"status":"success","checkedAt":"2026-10-15T11:07:50.060Z","error":null}},"steamMetadata":{"appId":"978780","links":{"store":"https://store.steampowered.com/app/978780/","officialWebsite":"http://www.storyofseasons.com/fomt/","support":"https://marvelous-usa.com/contact/"},"storageRequirements":{"kind":"required_free_space","windows":{"minimum":{"value":2,"unit":"GB","display":"2 GB","approximateBytes":2000000000,"evidenceText":"Storage: 2 GB"},"recommended":null},"macos":{"minimum":null,"recommended":null},"linux":{"minimum":null,"recommended":null},"note":"Steam publishes required free space, not the exact installed or download size."},"controllerSupport":{"level":"partial","xboxCompatible":null,"xboxEvidence":null,"note":"Generic Steam controller support does not prove Xbox controller compatibility."},"playerModes":{"singlePlayer":true,"multiplayer":false,"coop":false,"onlineCoop":false,"localCoop":false,"lanCoop":false,"sharedOrSplitScreen":false,"pvp":false,"maximumPlayers":null,"maximumPlayersNote":"The public Steam app-details response does not provide a reliable exact player limit.","evidence":["Single-player"]},"genres":["Casual","RPG","Simulation"],"categories":[{"id":2,"description":"Single-player"},{"id":22,"description":"Steam Achievements"},{"id":29,"description":"Steam Trading Cards"},{"id":55,"description":"DualShock Controller Support"},{"id":56,"description":"DualShock Controller Support"},{"id":57,"description":"DualSense Controller Support"},{"id":58,"description":"DualSense Controller Support"},{"id":18,"description":"Partial Controller Support"},{"id":23,"description":"Steam Cloud"},{"id":42,"description":"Remote Play on Tablet"},{"id":62,"description":"Family Sharing"}]}},"content":{"status":"success","steamAppId":"978780","steamName":"STORY OF SEASONS: Friends of Mineral Town","sourceUrl":"https://store.steampowered.com/app/978780/","fetchedAt":"2026-10-16T09:57:31.551509+00:00","locales":{"en":{"status":"source","provider":"steam","shortDescription":"Experience the joys of life on the farm in this reimagining of a timeless STORY OF SEASONS classic!","detailedDescription":"Your farming life begins in Mineral Town, a charming village surrounded by nature. You've returned after many years to restore your late grandfather's farm to its former glory. Care for crops, livestock, and more as your very own story of seasons unfolds.\n\nTend to the Farm!\nA menagerie of fruits, veggies, and livestock are waiting for you. Raise them all with love and care, and you'll have plenty of products to harvest, sell, or cook with!\n\nStroll Down Memory Lane!\nMineral Town is full of friendly faces, both old and new! Head into town, give gifts, and learn all about your neighbors as you befriend them.\n\nFall in Love!\nMineral Town is home to several eligible bachelors and bachelorettes. Get to know the boy or girl of your dreams, and you might be able to date them, get married, and even start a family!\n\nThere's More to Explore!\nGo fishing, cook fresh meals, and when your work's all said and done, take a dip in the local hot spring. Experience the farmer's life like never before!","aboutGame":null},"vi":{"status":"translated","provider":"argos-translate-en_vi-1.9-ctranslate2-int8","translatedAt":"2026-10-16T13:34:05.211412+00:00","sourceHash":"1c71d9fda1a170567ba482d5900d44885d6257090ba7812af640153950676641","reviewStatus":"machine_translation_unreviewed","shortDescription":"Hãy trải nghiệm niềm vui của đời sống ở nông trại trong quá trình tưởng tượng lại một câu chuyện cổ điển vô tận của những người lạc thú!","detailedDescription":"Cuộc sống nông nghiệp của bạn bắt đầu từ thị trấn Miral, một ngôi làng duyên dáng được bao quanh bởi thiên nhiên. Ngươi đã trở về sau nhiều năm để phục hồi lại nông trại của ông nội ngươi cho vinh quang trước đây. Chăm sóc cây trồng, gia súc, và nhiều hơn nữa khi câu chuyện của bạn về mùa mở ra.\nChăm sóc trang trại! Một vườn rau, rau quả, và súc vật đang chờ đợi các ngươi. Nuôi chúng với tình yêu và sự chăm sóc, và bạn sẽ có rất nhiều sản phẩm để thu hoạch, bán, hoặc nấu ăn với!\nĐường bộ nhớ chớp nhoáng! Thị trấn Miral đầy những gương mặt thân thiện, cả cũ lẫn mới! Vào thị trấn, tặng quà, và tìm hiểu mọi thứ về những người hàng xóm của bạn khi bạn kết bạn với họ.\nHãy yêu nhau! Thị trấn mỏ là nhà của một số người độc thân và độc thân đủ tư cách. Tìm hiểu về cậu bé hay cô gái trong mơ của bạn, và bạn có thể hẹn hò với họ, kết hôn, và thậm chí lập gia đình!\nCòn nhiều thứ để khám phá! Đi câu cá, nấu những bữa ăn tươi ngon, và khi công việc của anh xong xuôi, hãy ngâm mình trong mùa xuân nóng bức địa phương. Hãy trải nghiệm cuộc sống của người nông dân hơn bao giờ hết!","aboutGame":null}},"media":{"images":[{"role":"header","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/978780/header.jpg?t=1743091853"},{"role":"capsule","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/978780/capsule_231x87.jpg?t=1743091853"}],"screenshots":[{"id":0,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/978780/ss_ccc9ae5cf9f9e303399137a41dca952190b239d8.600x338.jpg?t=1743091853","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/978780/ss_ccc9ae5cf9f9e303399137a41dca952190b239d8.1920x1080.jpg?t=1743091853"},{"id":1,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/978780/ss_35056591d0b87b29517905b760fb20942b35a723.600x338.jpg?t=1743091853","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/978780/ss_35056591d0b87b29517905b760fb20942b35a723.1920x1080.jpg?t=1743091853"},{"id":2,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/978780/ss_13a2f34f57b24077e88cd90e49d5e9c89ea3f705.600x338.jpg?t=1743091853","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/978780/ss_13a2f34f57b24077e88cd90e49d5e9c89ea3f705.1920x1080.jpg?t=1743091853