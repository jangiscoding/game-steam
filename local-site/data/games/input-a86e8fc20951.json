":["The supplied name exactly matches the normalized official Steam name for the supplied App ID."],"research":{"steam":{"status":"success","checkedAt":"2026-10-15T11:07:18.443Z","error":null}},"steamMetadata":{"appId":"2272400","links":{"store":"https://store.steampowered.com/app/2272400/","officialWebsite":null,"support":null},"storageRequirements":{"kind":"required_free_space","windows":{"minimum":{"value":7,"unit":"GB","display":"7 GB","approximateBytes":7000000000,"evidenceText":"Storage: 7 GB"},"recommended":{"value":7,"unit":"GB","display":"7 GB","approximateBytes":7000000000,"evidenceText":"Storage: 7 GB"}},"macos":{"minimum":null,"recommended":null},"linux":{"minimum":null,"recommended":null},"note":"Steam publishes required free space, not the exact installed or download size."},"controllerSupport":{"level":"partial","xboxCompatible":null,"xboxEvidence":null,"note":"Generic Steam controller support does not prove Xbox controller compatibility."},"playerModes":{"singlePlayer":true,"multiplayer":false,"coop":false,"onlineCoop":false,"localCoop":false,"lanCoop":false,"sharedOrSplitScreen":false,"pvp":false,"maximumPlayers":null,"maximumPlayersNote":"The public Steam app-details response does not provide a reliable exact player limit.","evidence":["Single-player"]},"genres":["Casual","Indie","Simulation","Strategy"],"categories":[{"id":2,"description":"Single-player"},{"id":22,"description":"Steam Achievements"},{"id":18,"description":"Partial Controller Support"},{"id":23,"description":"Steam Cloud"},{"id":17,"description":"Includes level editor"},{"id":62,"description":"Family Sharing"}]}},"content":{"status":"success","steamAppId":"2272400","steamName":"Station to Station","sourceUrl":"https://store.steampowered.com/app/2272400/","fetchedAt":"2026-10-16T08:32:18.397609+00:00","locales":{"en":{"status":"source","provider":"steam","shortDescription":"‘Station to Station’ is a minimalist & relaxing game about building railway connections. Grab your conductor’s hat and bring the voxel-art world to life through the magic of trains!","detailedDescription":"Join our Discord!\n\nAbout the Game\nAttention all passengers! We are thrilled to announce the highly anticipated arrival of 'Station to Station' on your PCs!\n\nFEATURES\n\n• A relaxing and peaceful experience\n\n• Beautiful, colorful voxel art\n\n• Optional strategic gameplay to earn high scores\n\nCONNECT THE WORLD\n\nIn Station to Station, your world starts small with a handful of rural structures. Place stations and create connections to foster growth and expansion. As you build more connections, your area will grow, transforming into a vibrant, lush environment full of life and color! To keep you on your toes, the game also features engaging puzzle elements, challenging you to optimize routes and solve logistical conundrums.\n\nADMIRE VOXEL-ART VIEWS\n\nHop on board and steam through colorful biomes. Breathe life into the dry desert sands, and transform the untamed mountain terrain. Build and watch your tranquil world come to life with an ever-widening tapestry of flora and fauna!\n\nTHRIVE\n\nFor those eager to put their management and planning skills to the test, each level offers optional challenges, stack bonuses, and unique mechanics tied to every biome! Whether you seek relaxation or mental stimulation, 'Station to Station' has something for everyone!\n\nGET ON BOARD AND RELAX\n\nFollow us, join the community, and choo-choo with the devs. Check the external links to join our Twitter and Discord!\n\nStation to Station is inspired by titles, such as Mini Metro, Train Valley, Dorfromantik, Terra Nil and Islanders.","aboutGame":"Attention all passengers! We are thrilled to announce the highly anticipated arrival of 'Station to Station' on your PCs!\n\nFEATURES\n\n• A relaxing and peaceful experience\n\n• Beautiful, colorful voxel art\n\n• Optional strategic gameplay to earn high scores\n\nCONNECT THE WORLD\n\nIn Station to Station, your world starts small with a handful of rural structures. Place stations and create connections to foster growth and expansion. As you build more connections, your area will grow, transforming into a vibrant, lush environment full of life and color! To keep you on your toes, the game also features engaging puzzle elements, challenging you to optimize routes and solve logistical conundrums.\n\nADMIRE VOXEL-ART VIEWS\n\nHop on board and steam through colorful biomes. Breathe life into the dry desert sands, and transform the untamed mountain terrain. Build and watch your tranquil world come to life with an ever-widening tapestry of flora and fauna!\n\nTHRIVE\n\nFor those eager to put their management and planning skills to the test, each level offers optional challenges, stack bonuses, and unique mechanics tied to every biome! Whether you seek relaxation or mental stimulation, 'Station to Station' has something for everyone!\n\nGET ON BOARD AND RELAX\n\nFollow us, join the community, and choo-choo with the devs. Check the external links to join our Twitter and Discord!\n\nStation to Station is inspired by titles, such as Mini Metro, Train Valley, Dorfromantik, Terra Nil and Islanders."},"vi":{"status":"pending_translation","provider":null,"shortDescription":null,"detailedDescription":null,"aboutGame":null}},"media":{"images":[{"role":"header","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2272400/85f64d6c43191948745c20d37105d8edef289b9d/header.jpg?t=1779879894"},{"role":"capsule","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2272400/6b6b1915b4aec70315e7e1833675802e16fb779a/capsule_231x87.jpg?t=1779879894"}],"screenshots":[{"id":0,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2272400/f8bfceb180408ea2b9d47ac2bc7fd11f4cd7565c/ss_f8bfceb180408ea2b9d47ac2bc7fd11f4cd7565c.600x338.jpg?t=1779879894","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2272400/f8bfceb180408ea2b9d47ac2bc7fd11f4cd7