Metadata.playerModes"]}],"confidence":"medium","status":"needs_verification","verificationNotes":["The supplied name does not exactly match Steam's official name “Arma: Cold War Assault Remastered” for App ID 65790.","Confirm the edition or alias using another authoritative source before linking a canonical ID."],"research":{"steam":{"status":"success","checkedAt":"2026-10-15T09:57:10.898Z","error":null}},"steamMetadata":{"appId":"65790","links":{"store":"https://store.steampowered.com/app/65790/","officialWebsite":"https://github.com/BohemiaInteractive/cwr","support":null},"storageRequirements":{"kind":"required_free_space","windows":{"minimum":{"value":20,"unit":"GB","display":"20 GB","approximateBytes":20000000000,"evidenceText":"Hard Drive: 20 GB"},"recommended":{"value":20,"unit":"GB","display":"20 GB","approximateBytes":20000000000,"evidenceText":"Hard Drive: 20 GB"}},"macos":{"minimum":null,"recommended":null},"linux":{"minimum":{"value":20,"unit":"GB","display":"20 GB","approximateBytes":20000000000,"evidenceText":"Hard Drive: 20 GB"},"recommended":{"value":20,"unit":"GB","display":"20 GB","approximateBytes":20000000000,"evidenceText":"Hard Drive: 20 GB"}},"note":"Steam publishes required free space, not the exact installed or download size."},"controllerSupport":{"level":"full","xboxCompatible":null,"xboxEvidence":null,"note":"Generic Steam controller support does not prove Xbox controller compatibility."},"playerModes":{"singlePlayer":true,"multiplayer":true,"coop":true,"onlineCoop":true,"localCoop":false,"lanCoop":true,"sharedOrSplitScreen":false,"pvp":true,"maximumPlayers":null,"maximumPlayersNote":"The public Steam app-details response does not provide a reliable exact player limit.","evidence":["Single-player","Multi-player","PvP","Online PvP","LAN PvP","Co-op","Online Co-op","LAN Co-op"]},"genres":["Action","Simulation","Strategy"],"categories":[{"id":2,"description":"Single-player"},{"id":1,"description":"Multi-player"},{"id":49,"description":"PvP"},{"id":36,"description":"Online PvP"},{"id":47,"description":"LAN PvP"},{"id":9,"description":"Co-op"},{"id":38,"description":"Online Co-op"},{"id":48,"description":"LAN Co-op"},{"id":28,"description":"Full controller support"},{"id":55,"description":"DualShock Controller Support"},{"id":56,"description":"DualShock Controller Support"},{"id":57,"description":"DualSense Controller Support"},{"id":58,"description":"DualSense Controller Support"},{"id":17,"description":"Includes level editor"},{"id":62,"description":"Family Sharing"}]}},"content":{"status":"success","steamAppId":"65790","steamName":"Arma: Cold War Assault Remastered","sourceUrl":"https://store.steampowered.com/app/65790/","fetchedAt":"2026-10-16T09:36:23.874394+00:00","locales":{"en":{"status":"source","provider":"steam","shortDescription":"The genre-defining military sim that began as Operation Flashpoint (2001), now a modernized, 64-bit, cross-platform build for Windows and Linux, with its engine released as open source. Over 2 million copies sold. The Cold War battlefield of Everon and Nogova, remastered for today's hardware.","detailedDescription":"A 2001 classic, modernized, and now open source\n\nArma: Cold War Assault now runs on a modernized version of its original Poseidon engine: native 64-bit, Windows and Linux, support for ultrawide and high-refresh displays, full game-controller support, and a modern audio and networking stack, while it still plays exactly like the genre-defining original.\n\nThe engine is now open source\n\nBohemia Interactive has released the engine and game source code under the GNU GPL v3.0-or-later, in the spirit of id Software's classic source releases. Anyone can study it, build it, port it, and create with it. Game data and assets remain under Bohemia's Arma Public License Share Alike (APL-SA).\n\nA free Demo is available on Steam if you want to try the engine before buying the full data and campaigns.\n\nThe full engine source code is available on GitHub — search for BohemiaInteractive/cwr\n\nWhat's new in the Remastered engine\n\n• \nWindows & Linux, 64-bit: native cross-platform build (Steam Deck / SteamOS friendly)\n\n• \nUltrawide & any resolution: aspect-correct field of view; borderless, windowed, or fullscreen; selectable refresh rate and V-Sync\n\n• \nModern rendering: new OpenGL 3.3 renderer with crisp scalable (TrueType) fonts\n\n• \nFull controller support: gamepad with deadzone/response tuning, plus fully rebindable keyboard, mouse and controller bindings\n\n• \nModern audio: OpenAL backend with integrated voice chat (VON)\n\n• \nIn-game mod manager: enable, order and download community mods from within the game (Bohemia's own catalog), no command line needed\n\n• \nNew multiplayer back end: modern master server and in-game server browser (replacing the retired GameSpy service)\n\n• \nOpen toolchain for creators: bundled tools for PBO archives, models, terrain, textures, sound and config, plus a standalone scripting evaluator and a Blender import addon\n\nThe original game\n\nBohemia Interactive's debut game, published by Codemasters as Operation Flashpoint in 2001, became a genre-defining combat military simulation and the No. 1 bestselling PC game around the world, winning many international awards, including \"Game of the Year\" and \"Best Action Game\". Over 2 million copies have been sold since its release.\n\nStoryline\n\nThe horrors of WWIII are imminent.\n\nThere are clashes over the Malden Islands from dusk to dawn, and you are caught in between. You must use every resource in your arsenal to hold back the incoming darkness. Victor Troska came back to Nogovo, thinking the pain of war was buried in his past.\n\nBut his dream lies broken now.\n\nHis worst nightmare returns when military forces land near Nogovo.\n\nKey Features\n\nCold War Assault\n\n• \nCommand a squad of fully equipped troops\n\n• \nOver 40 authentic vehicles and aircraft\n\n• \nImmersive campaign and single missions\n\n• \nLAN/Internet multiplay\n\n• \nVast 100km² battlezones\n\nResistance\n\n• \nStory-driven 20-mission campaign\n\n• \nNogova, the new 100km² island\n\n• \nNew vehicles, weapons and equipment\n\n• \nDetailed urban environments\n\nOpen source & modding\n\nThe full engine and game source code is available under GNU GPL v3.0-or-later: fork it, build it, port it, or contribute back. Game assets remain under the Arma Public License Share Alike (APL-SA). Mods can be browsed and installed directly through the in-game mod manager, and a free Demo lets you try the remastered engine before buying.\n\nThe full engine source code is available on GitHub - search for BohemiaInteractive/cwr","aboutGame":null},"vi":{"status":"pending_translation","provider":null,"shortDescription":null,"detailedDescription":null,"aboutGame":null}},"media":{"images":[{"role":"header","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/65790/1d9756ea883a0f4a7af31d400bc0b29f2b3f75c9/header.jpg?t=1787041982"},{"role":"capsule","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/65790/3fbf61972b42cf7bebe53f8ebf670c304b41433e/capsule_231x87.jpg?t=1787041982"}],"screenshots":[{"id":0,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/65790/ss_03e5ce6a2c984ff3141ad6eaa2d50d0b7ff5b617.600x338.jpg?t=1787041982","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/65790/ss_03e5ce6a2c984ff3141ad6eaa2d50d0b7ff5b617.1920x1080.jpg?t=1787041982"},{"id":1,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/65790/ss_47f87862b2d329ba86097eecc0af22d45822063a.600x338.jpg?t=1787041982","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/65790/ss_47f87862b2d329ba86097eecc0af22d45822063a.1920x1080.jpg?t=1787041982"},{"id":2,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/65790/ss_70a2b4f5d1e37314e34565f86de30a0bddc323ce.600x338.jpg?t=1787041982","url":"https: