{"id":"input-4483066168ff","steamAppId":"2060870","name":"Invincible Presents: Atom Eve","imageUrl":"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/2060870/library_600x900.jpg","imageStatus":"downloaded","steamUrl":"https://store.steampowered.com/app/2060870/","genres":["Adventure"],"platforms":["windows"],"controllerSupport":"full","playerModes":{"singlePlayer":true,"multiplayer":false,"coop":false,"localCoop":false,"sharedOrSplitScreen":false,"onlineCoop":false,"maximumPlayers":null},"storage":{"windowsMinimumGB":2.0,"windowsMinimumDisplay":"2 GB"},"verificationStatus":"identified","custom":{},"sourceProfile":{"inputRecordId":"input-4483066168ff","canonicalId":"steam-app-2060870","suppliedName":"Invincible Presents: Atom Eve","suppliedImageUrl":"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/2060870/library_600x900.jpg","officialName":"Invincible Presents: Atom Eve","aliases":[],"series":null,"franchise":null,"productType":"game","editionName":null,"originalReleaseYear":null,"identifiedVersionReleaseYear":2023,"developers":["Terrible Posture Games"],"publishers":["Skybound Games"],"platforms":["windows"],"genres":["Adventure"],"shortDescription":"Become Atom Eve and take control of your own path as one of the most powerful superheroes in the Invincible universe! Unravel a mystery and balance the dangers and responsibilities of being a superhero with the relatable challenges of everyday life.","confusingWith":[],"candidateIdentifiers":{"steamAppId":"2060870"},"sources":[{"label":"Steam Store","url":"https://store.steampowered.com/app/2060870/","accessedAt":"2026-10-15T10:37:05.037Z","supports":["officialName","productType","identifiedVersionReleaseYear","developers","publishers","platforms","genres","shortDescription","steamMetadata.links","steamMetadata.storageRequirements","steamMetadata.controllerSupport","steamMetadata.playerModes"]}],"confidence":"high","status":"identified","verificationNotes":["The supplied name exactly matches the normalized official Steam name for the supplied App ID."],"research":{"steam":{"status":"success","checkedAt":"2026-10-15T10:37:05.037Z","error":null}},"steamMetadata":{"appId":"2060870","links":{"store":"https://store.steampowered.com/app/2060870/","officialWebsite":null,"support":"https://www.terribleposture.com/contact/"},"storageRequirements":{"kind":"required_free_space","windows":{"minimum":{"value":2,"unit":"GB","display":"2 GB","approximateBytes":2000000000,"evidenceText":"Storage: 2 GB"},"recommended":{"value":2,"unit":"GB","display":"2 GB","approximateBytes":2000000000,"evidenceText":"Storage: 2 GB"}},"macos":{"minimum":null,"recommended":null},"linux":{"minimum":null,"recommended":null},"note":"Steam publishes required free space, not the exact installed or download size."},"controllerSupport":{"level":"full","xboxCompatible":null,"xboxEvidence":null,"note":"Generic Steam controller support does not prove Xbox controller compatibility."},"playerModes":{"singlePlayer":true,"multiplayer":false,"coop":false,"onlineCoop":false,"localCoop":false,"lanCoop":false,"sharedOrSplitScreen":false,"pvp":false,"maximumPlayers":null,"maximumPlayersNote":"The public Steam app-details response does not provide a reliable exact player limit.","evidence":["Single-player"]},"genres":["Adventure"],"categories":[{"id":2,"description":"Single-player"},{"id":22,"description":"Steam Achievements"},{"id":28,"description":"Full controller support"},{"id":55,"description":"DualShock Controller Support"},{"id":57,"description":"DualSense Controller Support"},{"id":23,"description":"Steam Cloud"},{"id":62,"description":"Family Sharing"}]}},"content":{"status":"success","steamAppId":"2060870","steamName":"Invincible Presents: Atom Eve","sourceUrl":"https://store.steampowered.com/app/2060870/","fetchedAt":"2026-10-16T08:24:21.142092+00:00","locales":{"en":{"status":"source","provider":"steam","shortDescription":"Become Atom Eve and take control of your own path as one of the most powerful superheroes in the Invincible universe! Unravel a mystery and balance the dangers and responsibilities of being a superhero with the relatable challenges of everyday life.","detailedDescription":"Invincible Presents: Atom Eve is the first original Invincible game from Skybound Games, the creator-led company behind Invincible and The Walking Dead. Experience an original story with striking art directed by Rossi Gifford and creative direction by award-winning writer Jill Murray, and explore the life of Atom Eve in a world filled with beloved characters. Based on the comic book by Robert Kirkman, Cory Walker, and Ryan Ottley.\nAtomic, With Agency\nPlay as Atom Eve, the fan-favorite superhero from the Invincible universe! Get to know Eve like never before as she navigates her life with the Teen Team, her family, and her friends while figuring out the best way to use her incredible powers as a force for good.\nDetermine Your Destiny\nDoing the right thing sounds easy until you’re the one making the decisions. Your choices shape your relationships with the people around you and will define what kind of hero you want to be. \n\nChoose how to develop Atom Eve’s skills and increase her power, unlock special combat skills, or choose to unlock unique dialogue options to further play your story, your way.\nComic Book Combat\nTake on new and familiar foes in light, turn-based combat woven into visual novel gameplay and wield the powers of Atom Eve as your story flows seamlessly into vivid action that feels like a comic book come to life.","aboutGame":null},"vi":{"status":"translated","provider":"argos-translate-en_vi-1.9-ctranslate2-int8","translatedAt":"2026-10-16T12:22:32.404760+00:00","sourceHash":"d918a4a113241a985f22daaf24ea858acb06afa64fb1899ac5a13e0d26eb32aa","reviewStatus":"machine_translation_unreviewed","shortDescription":"Trở thành Atom Eve và nắm quyền kiểm soát con đường của chính mình như một trong những siêu anh hùng mạnh mẽ nhất trong vũ trụ bất khả chiến bại! Giải quyết một bí ẩn và cân bằng mối nguy hiểm và trách nhiệm của một siêu anh hùng với những thách thức có thể liên quan đến cuộc sống hàng ngày.","detailedDescription":"Atom Eve là trò chơi bất khả xâm phạm đầu tiên từ các trò chơi Skybound, công ty được tạo ra phía sau Invithlied and The Walking Dead. Kinh nghiệm ban đầu với nghệ thuật nổi bật được đạo diễn bởi Rossi Gifford và sự hướng dẫn sáng tạo của nhà văn Jill Murray, và khám phá cuộc sống của Atom Eve trong một thế giới đầy những nhân vật đáng yêu. Dựa trên truyện tranh của Robert Kirkman, Cori Walker, và Ryan Ottley. Nguyên tử, với cơ quan Hãy chơi như Atom Eve, siêu anh hùng hâm mộ từ vũ trụ bất khả chiến bại! Hãy biết rõ về Eve hơn bao giờ hết khi cô ấy định hướng cuộc sống của mình với Đội Thanh niên, gia đình và bạn bè trong khi tìm ra cách tốt nhất để sử dụng sức mạnh phi thường của mình như một sức mạnh tốt đẹp. Quyết định vận mệnh của bạn Làm điều đúng nghe có vẻ dễ cho đến khi bạn quyết định. Những lựa chọn của bạn định hình mối quan hệ của bạn với những người xung quanh bạn và sẽ xác định loại anh hùng mà bạn muốn trở thành.\nHãy chọn cách phát triển kỹ năng của Atom Ê - va và gia tăng sức mạnh, mở khóa kỹ năng chiến đấu đặc biệt, hoặc chọn cách mở ra những lựa chọn độc đáo để tiếp tục câu chuyện của bạn. Trò chơi Sách truyện tranh Đưa những kẻ thù mới và quen thuộc vào ánh sáng, những trận đấu dựa trên sự thay đổi được dệt thành những trò chơi mới lạ và sử dụng sức mạnh của Atom Eve khi câu chuyện của bạn trôi chảy một cách không ngừng vào những hành động sống động có cảm giác như một cuốn truyện tranh sống động.","aboutGame":null}},"media":{"images":[{"role":"header","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2060870/header.jpg?t=1731368197"},{"role":"capsule","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2060870/capsule_231x87.jpg?t=1731368197"}],"screenshots":[{"id":0,"thumbnailUrl":"https://shared.akamai.steamstatic.com