m":{"status":"success","checkedAt":"2026-10-15T10:37:24.705Z","error":null}},"steamMetadata":{"appId":"57740","links":{"store":"https://store.steampowered.com/app/57740/","officialWebsite":"http://www.jaggedalliance.com/","support":null},"storageRequirements":{"kind":"required_free_space","windows":{"minimum":{"value":3,"unit":"GB","display":"3 GB","approximateBytes":3000000000,"evidenceText":"Hard Disk Space: 3GB"},"recommended":null},"macos":{"minimum":{"value":13,"unit":"GB","display":"13 GB","approximateBytes":13000000000,"evidenceText":"Hard Disk Space: 13 GB"},"recommended":null},"linux":{"minimum":{"value":13,"unit":"GB","display":"13 GB","approximateBytes":13000000000,"evidenceText":"Hard Disk Space: 13 GB"},"recommended":null},"note":"Steam publishes required free space, not the exact installed or download size."},"controllerSupport":{"level":"unknown","xboxCompatible":null,"xboxEvidence":null,"note":"Generic Steam controller support does not prove Xbox controller compatibility."},"playerModes":{"singlePlayer":true,"multiplayer":false,"coop":false,"onlineCoop":false,"localCoop":false,"lanCoop":false,"sharedOrSplitScreen":false,"pvp":false,"maximumPlayers":null,"maximumPlayersNote":"The public Steam app-details response does not provide a reliable exact player limit.","evidence":["Single-player"]},"genres":["RPG","Simulation","Strategy"],"categories":[{"id":2,"description":"Single-player"},{"id":22,"description":"Steam Achievements"},{"id":29,"description":"Steam Trading Cards"},{"id":15,"description":"Stats"},{"id":62,"description":"Family Sharing"}]}},"content":{"status":"success","steamAppId":"57740","steamName":"Jagged Alliance - Back in Action","sourceUrl":"https://store.steampowered.com/app/57740/","fetchedAt":"2026-10-16T09:29:19.377713+00:00","locales":{"en":{"status":"source","provider":"steam","shortDescription":"A contemporary remake of the much-loved series of turn-based mercenary-themed strategy games.","detailedDescription":"Jagged Alliance Back in Action is a contemporary remake of the latest title in the much-loved Jagged Alliance series of turn-based mercenary-themed strategy games.\n\t\t\t\t\t\t\nDesigned from the ground up to offer a modern gaming experience, Back in Action showcases an updated isometric 3D look and interface, highly detailed character models and a variety of new gameplay features.\n\t\t\t\t\t\tBack in Action takes players to the fictitious country of Arulco, where a ruthless dictator has seized power and only a small group of rebels stand to resist her. Tasked with freeing the island from the dictator’s iron grip, players will command rebel and mercenary forces while using tactical, diplomatic and economic tools to keep troops supplied and ready for the next flight, all while commanding them directly in nail-biting battles.\n\t\t\t\t\t\t\nBack in Action’s innovative “plan & go” combat system combines real-time strategy (RTS) with turn-based elements to guarantee that the intricacies of tactical warfare are rendered in dynamic, exciting gameplay. This challenges would-be commanders to master not only strategy and tactical combat, but also to maximize their team’s capabilities through RPG-like character advancement.\n\t\t\t\t\t\t\nKey features:\n\t\t\t\t\t\t\n\n• Unrivaled mix of combat (tactics), roleplay, business and strategy\n\t\t\t\t\t\t\n\n• Innovative “Plan & Go” combat system combines RTS gameplay with turn-based elements\n\t\t\t\t\t\t\n\n• Realistic war setting with authentic-looking firearms\n\t\t\t\t\t\t\n\n• Laptop/computer menu as a central anchor point for the player\n\t\t\t\t\t\t\n\n• Assemble your own unit of mercenaries from numerous unique mercenaries\n\t\t\t\t\t\t\n\n• Simultaneous control of multiple squads using a strategic map\n\t\t\t\t\t\t\n\n• Convincing characters who interact with and comment on the game events\n\t\t\t\t\t\t\n\n• All the dialog has audio\n\t\t\t\t\t\t\n\n• Acquire resources by capturing mines and encampments","aboutGame":null},"vi":{"status":"translated","provider":"argos-translate-en_vi-1.9-ctranslate2-int8","translatedAt":"2026-10-16T13:13:28.819186+00:00","sourceHash":"e1e7e01ea3360b8752e72d021e92edfcabf63a9c8472549cb5b409925caa682f","reviewStatus":"machine_translation_unreviewed","shortDescription":"Một loạt các trò chơi chiến thuật theo kiểu lính đánh thuê được xây dựng lại hiện đại.","detailedDescription":"Jak Union Ree in Action là một sự tái tạo hiện đại của danh hiệu mới nhất trong loạt các trò chơi chiến thuật được yêu thích bởi quân đội.\nĐược thiết kế từ mặt đất để cung cấp một trải nghiệm trò chơi hiện đại, Back in Action shows một hình thức và giao diện loại hình 3D cập nhật, mô hình tính năng chi tiết cao và nhiều tính năng chơi game mới. Trở lại hành động đưa những người chơi đến đất nước Arusco tưởng tượng, nơi mà một nhà độc tài tàn nhẫn đã nắm lấy quyền lực và chỉ một nhóm nhỏ phản loạn đứng lên chống lại bà. Được giao nhiệm vụ giải phóng hòn đảo khỏi sự kìm kẹp sắt của nhà độc tài, các cầu thủ sẽ chỉ huy quân nổi dậy và các lực lượng đánh thuê trong khi sử dụng chiến thuật, ngoại giao và các công cụ kinh tế để giữ cho quân đội được cung cấp và sẵn sàng cho chuyến bay tiếp theo, trong khi ra lệnh trực tiếp cho họ trong các trận chiến chặt đinh.\nTrở lại với cuộc cách mạng “kế hoạch và đi tới hệ thống chiến đấu bằng phương pháp thời gian thực kết hợp với các yếu tố dựa trên lượt để đảm bảo rằng những sự phức tạp của chiến thuật chiến thuật được thực hiện trong các trò chơi năng động và thú vị. Những thách thức này sẽ trở thành những người chỉ huy không chỉ nắm vững chiến lược và chiến thuật, mà còn để tối đa hóa khả năng của đội họ thông qua sự tiến bộ của tính cách như RPG.\nCác tính năng khóa:\n\n• Sự pha trộn không ai sánh bằng (chiến thuật), đóng vai, kinh doanh và chiến thuật\n\n• Hệ thống chiến đấu của người phát triển “Plan & Go và Go, kết hợp trò chơi RTS với các yếu tố dựa trên lượt\n\n• Thiết lập chiến tranh thực tế với những vũ khí trông thật\n\n• Trình đơn máy tính và máy tính là điểm neo trung tâm cho người chơi\n\n• Tập hợp đơn vị đánh thuê riêng của bạn từ nhiều lính đánh thuê độc đáo\n\n• Việc đồng thời kiểm soát nhiều đội sử dụng bản đồ chiến lược\n\n• Những nhân vật gợi cảm hứng khi tương tác và bình luận về các sự kiện trò chơi\n\n• Tất cả các cuộc đối thoại đều có âm thanh\n\n• Thu thập tài nguyên qua việc bắt giữ mìn và trại","aboutGame":null}},"media":{"images":[{"role":"header","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/57740/header.jpg?t=1725004826"},{"role":"capsule","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/57740/capsule_231x87.jpg?t=1725004826"}],"screenshots":[{"id":0,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/57740/ss_4417a4d7b30836f9235c61fc6b1b385f6a7be973.600x338.jpg?t=1725004826","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/57740/ss_4417a4d7b30836f9235c61fc6b1b385f6a7be973.1920x1080.jpg?t=1725004826"},{"id":1,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/57740/ss_913ce26a2e63132aced07389d8afee4488e734f0.600x338.jpg?t=1725004826","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/57740/ss_913ce26a2e63132aced07389d8afee4488e734f0.1920x1080.jpg?t=1725004826"},{"id":2,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/57740/ss_6f3109f1729600e34a560e8e4839f63623580c3b.600x338.jpg?t=1725004826","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/57740/ss_6f3109f1729600e34a560e8e4839f63623580c3b.1920x1080.jpg?t=1725004826"},{"id":3,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/57740/ss_c147463e3a22a480f8d52787271d206d1cd42481.600x338.jpg?t=1725004826","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/57740/ss_c147463e3a22a480f8d52787271d206d1cd42481.1920x1080.jpg?t=1725004826"},{"id":4,"thumbnailUrl":"https://shared.aka