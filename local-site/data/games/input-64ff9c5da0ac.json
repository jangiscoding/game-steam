tem_assets/steam/apps/3494520/f76213be8c849d88ed4c475a63453a600b929fb5/ss_f76213be8c849d88ed4c475a63453a600b929fb5.600x338.jpg?t=1774014823","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3494520/f76213be8c849d88ed4c475a63453a600b929fb5/ss_f76213be8c849d88ed4c475a63453a600b929fb5.1920x1080.jpg?t=1774014823"},{"id":14,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3494520/0e1ed30f401f2bc2401e654ab9dd75b8d9985890/ss_0e1ed30f401f2bc2401e654ab9dd75b8d9985890.600x338.jpg?t=1774014823","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3494520/0e1ed30f401f2bc2401e654ab9dd75b8d9985890/ss_0e1ed30f401f2bc2401e654ab9dd75b8d9985890.1920x1080.jpg?t=1774014823"},{"id":15,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3494520/ebe6719e882bff50de1f20c5fefeb87783bef747/ss_ebe6719e882bff50de1f20c5fefeb87783bef747.600x338.jpg?t=1774014823","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3494520/ebe6719e882bff50de1f20c5fefeb87783bef747/ss_ebe6719e882bff50de1f20c5fefeb87783bef747.1920x1080.jpg?t=1774014823"},{"id":16,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3494520/698669be68aa9fc3e275dac89a60144eba92bd8e/ss_698669be68aa9fc3e275dac89a60144eba92bd8e.600x338.jpg?t=1774014823","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3494520/698669be68aa9fc3e275dac89a60144eba92bd8e/ss_698669be68aa9fc3e275dac89a60144eba92bd8e.1920x1080.jpg?t=1774014823"},{"id":17,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3494520/770f24abbad9156b438cc7328b9011901ea16291/ss_770f24abbad9156b438cc7328b9011901ea16291.600x338.jpg?t=1774014823","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3494520/770f24abbad9156b438cc7328b9011901ea16291/ss_770f24abbad9156b438cc7328b9011901ea16291.1920x1080.jpg?t=1774014823"},{"id":18,"thumbnailUrl":"https://sh