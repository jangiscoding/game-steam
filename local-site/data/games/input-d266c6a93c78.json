ay đổi trọng lực chỉ sau khi chạm vào bề mặt; Chế độ thứ hai - bạn luôn có thể thay đổi trọng lực.\n▪ 70 mức+ ▪ 2 chế độ chơi ▪ NHỮNG NGƯỜI ĐỂ học tập, HARD to Master ▪ Cat! ▪ Sẽ tăng mức độ mới trong việc cập nhật ▪ Thẻ tham quan ▪ Lợi ích ▪ Hỗ trợ xe lăn Thẻ trao đổi\nXúc tác"}},"media":{"images":[{"role":"header","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/491000/header.jpg?t=1575410544"},{"role":"capsule","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/491000/capsule_231x87.jpg?t=1575410544"},{"role":"description","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/491000/extras/4e24e118e592dad6805a217a1f775113.avif?t=1575410544","alt":""},{"role":"description","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/491000/extras/bd99c32b8c6f644dbeaf2c3a174cabf3.avif?t=1575410544","alt":""},{"role":"description","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/491000/extras/16d76446c6010f6be2e29106abc92447.avif?t=1575410544","alt":""}],"screenshots":[{"id":0,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/491000/ss_36b832e6947e38ce313fa3cbf290cc40d8903774.600x338.jpg?t=1575410544","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/491000/ss_36b832e6947e38ce313fa3cbf290cc40d8903774.1920x1080.jpg?t=1575410544"},{"id":1,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/491000/ss_c907b3a9511008d0f88827ddf9577d0dcae438c8.600x338.jpg?t=1575410544","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/491000/ss_c907b3a9511008d0f88827ddf9577d0dcae438c8.1920x1080.jpg?t=1575410544"},{"id":2,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/491000/ss_efa9a84ad440f682bf58a99bca821a5d42b89318.600x338.jpg?t=1575410544","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/491000/ss_efa9a84ad440f6