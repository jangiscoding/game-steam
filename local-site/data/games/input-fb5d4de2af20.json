{"id":"input-fb5d4de2af20","steamAppId":"426790","name":"Grow Up","imageUrl":"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/426790/portrait.png","imageStatus":"downloaded","steamUrl":"https://store.steampowered.com/app/426790/","genres":["Adventure","Casual","Indie"],"platforms":["windows"],"controllerSupport":"full","playerModes":{"singlePlayer":true,"multiplayer":false,"coop":false,"localCoop":false,"sharedOrSplitScreen":false,"onlineCoop":false,"maximumPlayers":null},"storage":{"windowsMinimumGB":1.0,"windowsMinimumDisplay":"1 GB"},"verificationStatus":"identified","custom":{},"sourceProfile":{"inputRecordId":"input-fb5d4de2af20","canonicalId":"steam-app-426790","suppliedName":"Grow Up","suppliedImageUrl":"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/426790/portrait.png","officialName":"Grow Up","aliases":[],"series":null,"franchise":null,"productType":"game","editionName":null,"originalReleaseYear":null,"identifiedVersionReleaseYear":2016,"developers":["Reflections, a Ubisoft Studio"],"publishers":["Infogrames","Atari"],"platforms":["windows"],"genres":["Adventure","Casual","Indie"],"shortDescription":"Leaping from mind-boggling heights, bouncing off Champolines, soaring inches from floating islands, BUD can do it all - that look of mild terror, that’s his daredevil face. Help the adorable little robot collect MOM’s scattered ship parts and return them to the moon.","confusingWith":[],"candidateIdentifiers":{"steamAppId":"426790"},"sources":[{"label":"Steam Store","url":"https://store.steampowered.com/app/426790/","accessedAt":"2026-10-15T10:31:24.291Z","supports":["officialName","productType","identifiedVersionReleaseYear","developers","publishers","platforms","genres","shortDescription","steamMetadata.links","steamMetadata.storageRequirements","steamMetadata.controllerSupport","steamMetadata.playerModes"]}],"confidence":"high","status":"identified","verificationNotes":["The supplied name exactly matches the normalized