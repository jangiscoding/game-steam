p ID."],"research":{"steam":{"status":"success","checkedAt":"2026-10-15T10:35:45.746Z","error":null}},"steamMetadata":{"appId":"307230","links":{"store":"https://store.steampowered.com/app/307230/","officialWebsite":"http://www.facebook.com/AwesomeGamesStudio","support":"https://www.awesomegamesstudio.com/"},"storageRequirements":{"kind":"required_free_space","windows":{"minimum":{"value":350,"unit":"MB","display":"350 MB","approximateBytes":350000000,"evidenceText":"Storage: 350 MB"},"recommended":null},"macos":{"minimum":null,"recommended":null},"linux":{"minimum":null,"recommended":null},"note":"Steam publishes required free space, not the exact installed or download size."},"controllerSupport":{"level":"full","xboxCompatible":null,"xboxEvidence":null,"note":"Generic Steam controller support does not prove Xbox controller compatibility."},"playerModes":{"singlePlayer":true,"multiplayer":false,"coop":false,"onlineCoop":false,"localCoop":false,"lanCoop":false,"sharedOrSplitScreen":false,"pvp":false,"maximumPlayers":null,"maximumPlayersNote":"The public Steam app-details response does not provide a reliable exact player limit.","evidence":["Single-player"]},"genres":["Casual","Indie","Strategy"],"categories":[{"id":2,"description":"Single-player"},{"id":22,"description":"Steam Achievements"},{"id":28,"description":"Full controller support"},{"id":29,"description":"Steam Trading Cards"},{"id":30,"description":"Steam Workshop"},{"id":23,"description":"Steam Cloud"},{"id":25,"description":"Steam Leaderboards"},{"id":17,"description":"Includes level editor"},{"id":43,"description":"Remote Play on TV"},{"id":62,"description":"Family Sharing"}]}},"content":{"status":"success","steamAppId":"307230","steamName":"I, Zombie","sourceUrl":"https://store.steampowered.com/app/307230/","fetchedAt":"2026-10-16T08:53:20.011877+00:00","locales":{"en":{"status":"source","provider":"steam","shortDescription":"Quite a different zombie game - this time YOU are the zombie! Command your infested comrades, fight your way to freedom and let the zombie kind dominate the world! Oh, and you're able to create your own scenarios!","detailedDescription":"TRY OUR LATEST GAME! (FREE DEMO AVAILABLE)\n\nAbout the Game\n\nNOW WITH IN-GAME LEVEL EDITOR!\n\nQuite a different zombie game - this time YOU are the zombie! Command your infested comrades, fight your way to freedom and let the zombie kind dominate the world!\n\nIn I, Zombie you play as the leader of a zombie horde and your goal is to infect all humans on the map. Whenever you infect a human you turn him into a one of your kind, and you can use him against armed soldiers. You're also able to command your horde to either attack the enemies, follow you or wait for orders. Each scenario requires tactical approach and careful planning to achieve success.","aboutGame":"NOW WITH IN-GAME LEVEL EDITOR!\n\nQuite a different zombie game - this time YOU are the zombie! Command your infested comrades, fight your way to freedom and let the zombie kind dominate the world!\n\nIn I, Zombie you play as the leader of a zombie horde and your goal is to infect all humans on the map. Whenever you infect a human you turn him into a one of your kind, and you can use him against armed soldiers. You're also able to command your horde to either attack the enemies, follow you or wait for orders. Each scenario requires tactical approach and careful planning to achieve success."},"vi":{"status":"translated","provider":"argos-translate-en_vi-1.9-ctranslate2-int8","translatedAt":"2026-10-16T12:45:31.890438+00:00","sourceHash":"868b2d12f132a7c7fe5eac316e70e6e7dd38cccefef10d2d7d8aea54caaf2cc6","reviewStatus":"machine_translation_unreviewed","shortDescription":"Một trò chơi thây ma khá khác - Lần này bạn là zombie! Chỉ huy các đồng đội của ngươi, chiến đấu để tự do và để lũ xác sống thống trị thế giới! Oh, và bạn có thể tạo ra kịch bản của riêng mình!","detailedDescription":"Hãy thử trò chơi của chúng ta! (Tiếng nhạc)\nGiới thiệu về trò chơi\nBây giờ với bên trong mục tiêu!\nMột trò chơi thây ma khá khác - Lần này bạn là zombie! Chỉ huy các đồng đội của ngươi, chiến đấu để tự do và để lũ xác sống thống trị thế giới!\nTrong tôi, Zombie anh đóng vai kẻ cầm đầu một đám thây ma và mục tiêu của anh là lây nhiễm tất cả con người trên bản đồ. Bất cứ khi nào anh lây nhiễm vào con người, anh biến hắn thành một trong những người như anh, và anh có thể dùng hắn chống lại những người lính có vũ trang. Anh cũng có thể ra lệnh cho quân mình tấn công kẻ thù, theo anh hoặc chờ lệnh. Mỗi kịch bản đòi hỏi phương pháp chiến thuật và kế hoạch cẩn thận để đạt được thành công.","aboutGame":"Bây giờ với bên trong mục tiêu!\nMột trò chơi thây ma khá khác - Lần này bạn là zombie! Chỉ huy các đồng đội của ngươi, chiến đấu để tự do và để lũ xác sống thống trị thế giới!\nTrong tôi, Zombie anh đóng vai kẻ cầm đầu một đám thây ma và mục tiêu của anh là lây nhiễm tất cả con người trên bản đồ. Bất cứ khi nào anh lây nhiễm vào con người, anh biến hắn thành một trong những người như anh, và anh có thể dùng hắn chống lại những người lính có vũ trang. Anh cũng có thể ra lệnh cho quân mình tấn công kẻ thù, theo anh hoặc chờ lệnh. Mỗi kịch bản đòi hỏi phương pháp chiến thuật và kế hoạch cẩn thận để đạt được thành công."}},"media":{"images":[{"role":"header","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/307230/header.jpg?t=1773911907"},{"role":"capsule","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/307230/capsule_231x87.jpg?t=1773911907"},{"role":"description","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/307230/extras/d0bbd4f01f773080f405ee15c593a207.avif?t=1773911907","alt":""}],"screenshots":[{"id":0,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/307230/ss_31c28baca8839d5815b0ddca5ad645ee85b5858b.600x338.jpg?t=1773911907","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/307230/ss_31c28baca8839