ial Steam name for the supplied App ID."],"research":{"steam":{"status":"success","checkedAt":"2026-10-15T11:00:22.435Z","error":null}},"steamMetadata":{"appId":"268870","links":{"store":"https://store.steampowered.com/app/268870/","officialWebsite":"http://www.satellitereign.com/","support":"http://satellitereign.com/"},"storageRequirements":{"kind":"required_free_space","windows":{"minimum":{"value":2,"unit":"GB","display":"2 GB","approximateBytes":2000000000,"evidenceText":"Storage: 2 GB"},"recommended":{"value":2,"unit":"GB","display":"2 GB","approximateBytes":2000000000,"evidenceText":"Storage: 2 GB"}},"macos":{"minimum":{"value":2,"unit":"GB","display":"2 GB","approximateBytes":2000000000,"evidenceText":"Storage: 2 GB"},"recommended":{"value":2,"unit":"GB","display":"2 GB","approximateBytes":2000000000,"evidenceText":"Storage: 2 GB"}},"linux":{"minimum":{"value":2,"unit":"GB","display":"2 GB","approximateBytes":2000000000,"evidenceText":"Storage: 2 GB"},"recommended":{"value":2,"unit":"GB","display":"2 GB","approximateBytes":2000000000,"evidenceText":"Storage: 2 GB"}},"note":"Steam publishes required free space, not the exact installed or download size."},"controllerSupport":{"level":"unknown","xboxCompatible":null,"xboxEvidence":null,"note":"Generic Steam controller support does not prove Xbox controller compatibility."},"playerModes":{"singlePlayer":true,"multiplayer":true,"coop":true,"onlineCoop":true,"localCoop":false,"lanCoop":true,"sharedOrSplitScreen":false,"pvp":true,"maximumPlayers":null,"maximumPlayersNote":"The public Steam app-details response does not provide a reliable exact player limit.","evidence":["Single-player","Multi-player","PvP","Online PvP","LAN PvP","Co-op","Online Co-op","LAN Co-op"]},"genres":["Action","Indie","Strategy"],"categories":[{"id":2,"description":"Single-player"},{"id":1,"description":"Multi-player"},{"id":49,"description":"PvP"},{"id":36,"description":"Online PvP"},{"id":47,"description":"LAN PvP"},{"id":9,"description":"Co-op"},{"id":38,"description":"Online Co-op"},{"id":48,"description":"LAN Co-op"},{"id":27,"description":"Cross-Platform Multiplayer"},{"id":22,"description":"Steam Achievements"},{"id":29,"description":"Steam Trading Cards"},{"id":23,"description":"Steam Cloud"},{"id":25,"description":"Steam Leaderboards"},{"id":62,"description":"Family Sharing"}]}},"content":{"status":"success","steamAppId":"268870","steamName":"Satellite Reign","sourceUrl":"https://store.steampowered.com/app/268870/","fetchedAt":"2026-10-16T08:45:27.402057+00:00","locales":{"en":{"status":"source","provider":"steam","shortDescription":"Satellite Reign is a real-time, class-based strategy game, set in an open-world cyberpunk city. You command a group of 4 agents through rain-soaked, neon-lit streets, where the law is the will of mega-corporations.","detailedDescription":"Important Note Regarding Online Play\n\nSatellite Reign was developed using Unity's now-retired online networking solution UNET. UNET was shut down in 2025, and so Satellite Reign's co-op multiplayer now only works via local LAN. If you still want to play with friends online, you will need to use LAN connection over a VPN.\n\nDeluxe Edition\n\nContains the game, original soundtrack, 'Satellite Reign: Reboot' e-book and 'The Art of Satellite Reign' e-book.\n\nCo-Op Multiplayer\n\nPlay the entirety of Satellite Reign with your friends in co-op multiplayer.  Up to four players can each control their own agent, opening up a whole new level of strategic and co-ordinated play.\n\nWith full drop-in/drop-out support (LAN play only), and customisable agent assignment, get ready to experience Satellite Reign like never before. \n\nStrategic Cyberpunk Action\n\nSatellite Reign is a real-time, class-based strategy game, set in an open-world cyberpunk city.  You command a group of 4 agents through rain-soaked, neon-lit streets, where the law is the will of mega-corporations.  Use your agents to sneak, shoot, steal, and sabotage your way up the corporate ladder, and take control of the most powerful monopoly of all time.\n\nEach of your agents can be tailored toward your favoured play-style, while still maintaining their own unique specialisations.  Shape your team into an offensive war machine, or an elite covert spec-ops outfit, and take the open-world city as your own.\n\nOpen World\n\nThe city of Satellite Reign is one big, open playground.  No individual levels to pick between, the whole world can be explored seamlessly.  Uncover new missions while you explore, and pick and choose which objectives you want to tackle.\n\nCustomise your Team\n\nEach of your four agents can be tailored to suit your play style.  Choose their skills, weapons, gear, augmentations, and even their genetic base by cloning exceptional individuals from the general population.\n\nMultiple Strategies\n\nThere's no 'right-way' to complete your objectives.  The world has been designed to facilitate emergent gameplay, allowing you to choose from and combine a wide range of strategic options.  Sneak in through ventilation shafts, hack doors, take out power generators, hijack the minds of guards, or just blow the front door down.  Countless opportunities await.","aboutGame":null},"vi":{"status":"pending_translation","provider":null,"shortDescription":null,"detailedDescription":null,"aboutGame":null}},"media":{"images":[{"role":"header","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/268870/header.jpg?t=1768784532"},{"role":"capsule","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/268870/capsule_231x87.jpg?t=1768784532"}],"screenshots":[{"id":0,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/268870/ss_872dafd837c5a10979e80feb37379ac97f737215.600x338.jpg?t=1768784532","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/268870/ss_872dafd837c5a10979e80feb37379ac97f737215.1920x1080.jpg?t=1768784532"},{"id":1,"thumbnailUrl":"https:/