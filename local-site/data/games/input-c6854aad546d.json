{"id":"input-c6854aad546d","steamAppId":"454100","name":"Dungeon Escape","imageUrl":"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/454100/library_600x900.jpg","steamUrl":"https://store.steampowered.com/app/454100/","genres":["Action","Adventure","Indie"],"platforms":["windows","mac","linux"],"controllerSupport":"full","playerModes":{"singlePlayer":true,"multiplayer":false,"coop":false,"localCoop":false,"sharedOrSplitScreen":false,"onlineCoop":false,"maximumPlayers":null},"storage":{"windowsMinimumGB":0.2,"windowsMinimumDisplay":"200 MB"},"verificationStatus":"identified","steamTags":["Precision Platformer","Difficult","2D Platformer","Platformer","Retro","Action","Singleplayer","Soundtrack","Old School","2D","Controller","Adventure","Minimalist","Arcade","Pixel Graphics","Gore","Indie","Great Soundtrack","Casual","Side Scroller"],"sourceProfile":{"shortDescription":"A challenging 2D precision platformer with minimalist graphics and a great chiptune soundtrack. Escape a dangerous dungeon filled with enemies and deadly traps.","developers":["Roenko Games"]},"content":{"status":"success","fetchedAt":"2026-10-16T09:18:08.523570+00:00","identityStatus":"verified","locales":{"en":{"status":"source","shortDescription":"A challenging 2D precision platformer with minimalist graphics and a great chiptune soundtrack. Escape a dangerous dungeon filled with enemies and deadly traps.","detailedDescription":"Dungeon Escape is a challenging 2D precision platformer with minimalist graphics and a great chiptune soundtrack. Make your way through a dangerous dungeon filled with enemies and deadly traps.\n\nFeatures:\n\n• \nMinimalist graphics\n\n• \nHardcore gameplay\n\n• \nGreat original soundtrack\n\n• \n50 challenging levels\n\n• \nCoins! Who doesn't like coins?\n\nCan you overcome all the challenges and escape the dungeon?"},"vi":{"status":"translated","shortDescription":"Một nền tảng chính xác 2D thách thức với đồ họa tối thiểu và một hệ thống âm thanh chiptun