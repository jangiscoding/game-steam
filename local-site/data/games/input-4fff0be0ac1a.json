ata.playerModes"]}],"confidence":"high","status":"identified","verificationNotes":["The supplied name exactly matches the normalized official Steam name for the supplied App ID."],"research":{"steam":{"status":"success","checkedAt":"2026-10-15T11:15:26.194Z","error":null}},"steamMetadata":{"appId":"1084020","links":{"store":"https://store.steampowered.com/app/1084020/","officialWebsite":"https://theotown.com/","support":"https://forum.theotown.com/app.php/contactadmin"},"storageRequirements":{"kind":"required_free_space","windows":{"minimum":{"value":200,"unit":"MB","display":"200 MB","approximateBytes":200000000,"evidenceText":"Storage: 200 MB"},"recommended":{"value":500,"unit":"MB","display":"500 MB","approximateBytes":500000000,"evidenceText":"Storage: 500 MB"}},"macos":{"minimum":null,"recommended":null},"linux":{"minimum":{"value":200,"unit":"MB","display":"200 MB","approximateBytes":200000000,"evidenceText":"Storage: 200 MB"},"recommended":{"value":500,"unit":"MB","display":"500 MB","approximateBytes":500000000,"evidenceText":"Storage: 500 MB"}},"note":"Steam publishes required free space, not the exact installed or download size."},"controllerSupport":{"level":"unknown","xboxCompatible":null,"xboxEvidence":null,"note":"Generic Steam controller support does not prove Xbox controller compatibility."},"playerModes":{"singlePlayer":true,"multiplayer":true,"coop":false,"onlineCoop":false,"localCoop":false,"lanCoop":false,"sharedOrSplitScreen":false,"pvp":false,"maximumPlayers":null,"maximumPlayersNote":"The public Steam app-details response does not provide a reliable exact player limit.","evidence":["Single-player","Multi-player"]},"genres":["Adventure","Casual","Indie","Simulation","Strategy","Free To Play"],"categories":[{"id":2,"description":"Single-player"},{"id":1,"description":"Multi-player"},{"id":27,"description":"Cross-Platform Multiplayer"},{"id":22,"description":"Steam Achievements"},{"id":23,"description":"Steam Cloud"},{"id":62,"description":"Family Sharing"}]}},"content":{"status":"success","steamAppId":"1084020","steamName":"TheoTown","sourceUrl":"https://store.steampowered.com/app/1084020/","fetchedAt":"2026-10-16T07:40:51.242651+00:00","locales":{"en":{"status":"source","provider":"steam","shortDescription":"Build and manage your dream city in this captivating simulation game. Create unique urban landscapes and enjoy compatibility with the mobile versions. Unleash your creativity and shape the metropolis of your dreams.","detailedDescription":"TheoTown is a detailed city-building simulation where you design, manage, and expand multiple cities across large regions.\n\nStart with a small settlement and develop it into a complex metropolis. Zone residential, commercial, and industrial districts, provide power and water infrastructure, manage traffic, and respond to evolving demands as your population grows.\n\nDesign extensive transportation systems including bus networks, railways, airports, and highways. Control routes, manage vehicle types, and optimize mobility across your city.\n\nHandle challenges such as fires, crime, pollution, disease outbreaks, and natural disasters. Invest in education, public services, and infrastructure to improve living standards and support long-term growth.\n\nBuild iconic landmarks and world wonders, or extend the game with community-created plugins that add new buildings, mechanics, and customization options.\n\nThe Steam edition is the complete premium version of TheoTown: no ads, no in-app purchases, and all additional content included in a single purchase.","aboutGame":null},"vi":{"status":"translated","provider":"argos-translate-en_vi-1.9-ctranslate2-int8","translatedAt":"2026-10-16T10:41:14.136031+00:00","sourceHash":"8fa5cfe8edd22339358981fe5393146c2f9d6b0d2e895fa7d7a581b495ab30ae","reviewStatus":"machine_translation_unreviewed","shortDescription":"Xây dựng và quản lý thành phố mơ ước của bạn trong trò chơi mô phỏng hấp dẫn này.  Tạo ra những phong cảnh đô thị độc đáo và thích hợp với các bản dịch di động.  Giải phóng sự sáng tạo của bạn và định hình thành thành phố giấc mơ của bạn.","detailedDescription":"TheoTkin là một mô phỏng xây dựng thành phố chi tiết nơi bạn thiết kế, quản lý, và mở rộng nhiều thành phố khắp các khu vực lớn.\nBắt đầu với một khu định cư nhỏ và phát triển nó thành một thành phố phức tạp.  Khu dân cư, thương mại và các khu công nghiệp, cung cấp điện và nước cơ sở hạ tầng, quản lý giao thông, và đáp ứng nhu cầu phát triển khi dân số của bạn tăng lên.\nThiết kế các hệ thống vận chuyển rộng rãi bao gồm mạng lưới xe buýt, đường sắt, sân bay và đường cao tốc.  Các tuyến đường điều khiển, các loại phương tiện điều khiển, và tối ưu hóa sự di chuyển khắp thành phố.\nGiải quyết những thách thức như lửa, tội ác, ô nhiễm, dịch bệnh và thiên tai.  Đầu tư vào giáo dục, dịch vụ cộng đồng, và cơ sở hạ tầng để cải thiện tiêu chuẩn sống và hỗ trợ tăng trưởng lâu dài.\nXây dựng những mốc mốc và kỳ quan thế giới, hoặc mở rộng trò chơi với bổ sung cộng đồng để thêm vào những tòa nhà, cơ học, và tùy chỉnh tùy chọn.\nPhiên bản Steam là phiên bản hoàn chỉnh của TheoTown: không quảng cáo, không mua thêm, và tất cả các nội dung bổ sung bao gồm trong một lần mua duy nhất.","aboutGame":null}},"media":{"images":[{"role":"header","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1084020/498b6c8a80fc83db395b2cdfdff22f946680c726/header.jpg?t=1790151438"},{"role":"capsule","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1084020/71573eed1508e1b49b9b82b2d66cae0bb8845a3b/capsule_231x87.jpg?t=1790151438"}],"screenshots":[{"id":0,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1084020/ss_dcd088e25a0339ebcf2f1e2d6c403a1cc1fc396b.600x338.jpg?t=1790151438","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1084020/ss_dcd088e25a0339ebcf2f1e2d6c403a1cc1fc396b.1920x1080.jpg?t=1790151438"},{"id":1,"thumbnailUrl":"https://shared.akamai.steamstat