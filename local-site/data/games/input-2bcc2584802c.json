i.steamstatic.com/store_item_assets/steam/apps/638850/ss_c5c0c9567b807431cbde7499fceebcad7d56fcee.600x338.jpg?t=1773104170","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/638850/ss_c5c0c9567b807431cbde7499fceebcad7d56fcee.1920x1080.jpg?t=1773104170"},{"id":15,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/638850/ss_ea78d5c1529645ad8ba3c5173c0ab52723d0354b.600x338.jpg?t=1773104170","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/638850/ss_ea78d5c1529645ad8ba3c5173c0ab52723d0354b.1920x1080.jpg?t=1773104170"},{"id":16,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/638850/ss_72a6d317c41e57fbf56507e31059b5fd74cd656b.600x338.jpg?t=1773104170","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/638850/ss_72a6d317c41e57fbf56507e31059b5fd74cd656b.1920x1080.jpg?t=1773104170"},{"id":17,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/638850/ss_8d78b8777bf328bbc8e8f7f36f7527992a23ce12.600x338.jpg?t=1773104170","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/638850/ss_8d78b8777bf328bbc8e8f7f36f7527992a23ce12.1920x1080.jpg?t=1773104170"},{"id":18,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/638850/ss_f7039bff48859dc0b12fc0d90ee8be5fa2e8c662.600x338.jpg?t=1773104170","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/638850/ss_f7039bff48859dc0b12fc0d90ee8be5fa2e8c662.1920x1080.jpg?t=1773104170"},{"id":19,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/638850/ss_c922064a5222baa36576c2c0ef11ab9c67f1d2fd.600x338.jpg?t=1773104170","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/638850/ss_c922064a5222baa36576c2c0ef11ab9c67f1d2fd.1920x1080.jpg?t=1773104170"},{"id":20,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/638850/ss_71a66