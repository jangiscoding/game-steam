{"id":"input-d8bc6c65a307","steamAppId":"357070","name":"UBERMOSH","imageUrl":"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/357070/library_600x900.jpg","steamUrl":"https://store.steampowered.com/app/357070/","genres":["Action","Indie"],"platforms":["windows","linux"],"controllerSupport":"full","playerModes":{"singlePlayer":true,"multiplayer":false,"coop":false,"localCoop":false,"sharedOrSplitScreen":false,"onlineCoop":false,"maximumPlayers":null},"storage":{"windowsMinimumGB":0.39,"windowsMinimumDisplay":"390 MB"},"verificationStatus":"identified","supportsVietnamese":true,"vietnameseSupportStatus":"listed","steamTags":["Cyberpunk","Pixel Graphics","Action","Great Soundtrack","Indie","Arcade","Fast-Paced","Female Protagonist","Retro","Bullet Hell","Twin Stick Shooter","Isometric","Procedural Generation","Difficult","Sci-fi","Top-Down","Top-Down Shooter","Singleplayer","Casual","Roguelike"],"sourceProfile":{"shortDescription":"UBERMOSH is an arcade game about cutting bullets with a sword, in a gun-filled cyberpunk mosh pit.","developers":["Walter Machado"]},"content":{"status":"success","fetchedAt":"2026-10-16T09:03:50.622532+00:00","identityStatus":"verified","locales":{"en":{"status":"source","shortDescription":"UBERMOSH is an arcade game about cutting bullets with a sword, in a gun-filled cyberpunk mosh pit.","detailedDescription":"\"UBERMOSH is an arcade game about cutting bullets with a sword, in a gun-filled cyberpunk mosh pit.\"\n\r\n\n\r\nLike a pinball table or a coin-op arcade machine, UBERMOSH was made to give you a shot of adrenaline in a couple of minutes. Each time you play a new level is generated for you to beat your score in 90 seconds."},"vi":{"status":"translated","shortDescription":"UBERMOH là một trò chơi điện tử về việc cắt đạn bằng một thanh kiếm, trong một hố chứa đầy súng.","detailedDescription":"\"BERMOH là một trò chơi điện tử về việc cắt đạn bằng một thanh kiếm, trong một hố chứa đầy súng.\"\n\n\nGiống như một cái bàn