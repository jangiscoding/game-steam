t":null},"storageRequirements":{"kind":"required_free_space","windows":{"minimum":{"value":150,"unit":"MB","display":"150 MB","approximateBytes":150000000,"evidenceText":"Storage: 150 MB"},"recommended":{"value":200,"unit":"MB","display":"200 MB","approximateBytes":200000000,"evidenceText":"Storage: 200 MB"}},"macos":{"minimum":null,"recommended":null},"linux":{"minimum":null,"recommended":null},"note":"Steam publishes required free space, not the exact installed or download size."},"controllerSupport":{"level":"unknown","xboxCompatible":null,"xboxEvidence":null,"note":"Generic Steam controller support does not prove Xbox controller compatibility."},"playerModes":{"singlePlayer":true,"multiplayer":false,"coop":false,"onlineCoop":false,"localCoop":false,"lanCoop":false,"sharedOrSplitScreen":false,"pvp":false,"maximumPlayers":null,"maximumPlayersNote":"The public Steam app-details response does not provide a reliable exact player limit.","evidence":["Single-player"]},"genres":["Casual","Indie"],"categories":[{"id":2,"description":"Single-player"},{"id":22,"description":"Steam Achievements"},{"id":29,"description":"Steam Trading Cards"},{"id":62,"description":"Family Sharing"}]}},"content":{"status":"success","steamAppId":"539460","steamName":"Puzzle Cube","sourceUrl":"https://store.steampowered.com/app/539460/","fetchedAt":"2026-10-16T09:25:43.289568+00:00","locales":{"en":{"status":"source","provider":"steam","shortDescription":"Three in a row, but in 3d!","detailedDescription":"THREE IN A ROW, BUT IN 3D!\nThis puzzle game has a \"Easy to Learn - Hard to Master\"-concept to it. Each level has a number of movable boxes, with different colors, within the playable area. Slide all boxes towards one of the six edges of the playable area to get three or more in a row. Boxes that are on a row will disappear and make it possible to continue. Planning and logical sense is required to make all boxes disappear and thereby clearing the level.\n\nAll the 120 levels are handcrafted and has a progressive difficulty curve. There are also special boxes\n\n    \n• Frozen Blocks that starts out frozen as a hidering in the level.\n    \n\n• Exploding Blocks that, when hit, will destroys all blocks around them.","aboutGame":null},"vi":{"status":"translated","provider":"argos-translate-en_vi-1.9-ctranslate2-int8","translatedAt":"2026-10-16T13:10:40.194466+00:00","sourceHash":"a94a0553452c9a6bde6463e2d1cf16b9a283495f989a6050f70c7bae8070fe15","reviewStatus":"machine_translation_unreviewed","shortDescription":"3 cái liên tiếp, nhưng 3D!","detailedDescription":"3 giờ trong 1 giờ, nhưng 3 chiều! Trò chơi giải đố này có một câu đố \"Hãy học hỏi - khó để làm chủ\" ngoại trừ nó. Mỗi tầng có một số hộp xếp hạng, với màu sắc khác nhau, trong khu vực có thể chơi được. Trượt tất cả các hộp hướng về một trong sáu cạnh của khu vực chơi để có được ba hoặc nhiều hơn trong một hàng. Những chiếc hộp xếp hàng sẽ biến mất và làm cho nó có thể tiếp tục. Cần phải lập kế hoạch và hợp lý để làm cho tất cả các hộp biến mất và do đó làm sạch cấp độ.\nTất cả 120 tầng đều được chế tạo thủ công và có một đường cong khó khăn dần dần. Cũng có những hộp đặc biệt\n\n• Những khối đá đóng băng bắt đầu đóng băng lại như một chỗ ẩn nấp ở cấp độ.\n\n• Việc khai phá những khối đá, khi bị tấn công, sẽ phá hủy tất cả các tòa nhà xung quanh.","aboutGame":null}},"media":{"images":[{"role":"header","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/539460/header.jpg?t=1782169599"},{"role":"capsule","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/539460/capsule_231x87.jpg?t=1782169599"}],"screenshots":[{"id":0,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/539460/ss_be831cf99ed994690ede9236f45813bdf6dd2613.600x338.jpg?t=1782169599","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/539460/ss_be831cf99ed994690ede9236f45813bdf6dd2613.1920x1080.jpg?t=1782169599"},{"id":1,"thumbnailUrl":"htt