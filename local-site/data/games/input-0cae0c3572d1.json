eamMetadata.playerModes"]}],"confidence":"high","status":"identified","verificationNotes":["The supplied name exactly matches the normalized official Steam name for the supplied App ID."],"research":{"steam":{"status":"success","checkedAt":"2026-10-15T10:24:52.538Z","error":null}},"steamMetadata":{"appId":"4570720","links":{"store":"https://store.steampowered.com/app/4570720/","officialWebsite":"https://dragonsword-awakening.hound13.com/","support":null},"storageRequirements":{"kind":"required_free_space","windows":{"minimum":{"value":25,"unit":"GB","display":"25 GB","approximateBytes":25000000000,"evidenceText":"Storage: 25 GB"},"recommended":{"value":25,"unit":"GB","display":"25 GB","approximateBytes":25000000000,"evidenceText":"Storage: 25 GB"}},"macos":{"minimum":null,"recommended":null},"linux":{"minimum":null,"recommended":null},"note":"Steam publishes required free space, not the exact installed or download size."},"controllerSupport":{"level":"partial","xboxCompatible":null,"xboxEvidence":null,"note":"Generic Steam controller support does not prove Xbox controller compatibility."},"playerModes":{"singlePlayer":true,"multiplayer":true,"coop":true,"onlineCoop":true,"localCoop":false,"lanCoop":false,"sharedOrSplitScreen":false,"pvp":false,"maximumPlayers":null,"maximumPlayersNote":"The public Steam app-details response does not provide a reliable exact player limit.","evidence":["Single-player","Multi-player","Co-op","Online Co-op"]},"genres":["Action","Adventure","RPG"],"categories":[{"id":2,"description":"Single-player"},{"id":1,"description":"Multi-player"},{"id":9,"description":"Co-op"},{"id":38,"description":"Online Co-op"},{"id":22,"description":"Steam Achievements"},{"id":67,"description":"Camera Comfort"},{"id":82,"description":"#category_contrast_controls"},{"id":68,"description":"Custom Volume Controls"},{"id":78,"description":"Adjustable Difficulty"},{"id":55,"description":"DualShock Controller Support"},{"id":56,"description":"DualShock Controller Support"},{"id":57,"description":"DualSense Controller Support"},{"id":58,"description":"DualSense Controller Support"},{"id":69,"description":"Stereo Sound"},{"id":70,"description":"Surround Sound"},{"id":18,"description":"Partial Controller Support"},{"id":23,"description":"Steam Cloud"},{"id":15,"description":"Stats"},{"id":62,"description":"Family Sharing"}]}},"content":{"status":"success","steamAppId":"4570720","steamName":"DragonSword : Awakening","sourceUrl":"https://store.steampowered.com/app/4570720/","fetchedAt":"2026-10-16T09:18:10.113099+00:00","locales":{"en":{"status":"source","provider":"steam","shortDescription":"Explore the anime-style open world of the Continent of Orbis, brought to life with Unreal Engine 5! Recruit unique companions, unleash spectacular Status Ailment tag-team action, and embark on an epic journey to save the world from the threat of a Dragon reawakened after 60 years.","detailedDescription":"[ A Boy's Breathtaking Journey to Save the World Begins ]\n\nLute, a young boy traveling toward Orbis—the first kingdom built by humankind—finds himself swept up in the lives of Johnny, a mercenary, and Castella, an Elf, stumbling headfirst into the chaotic life of a mercenary.\n\nAmid hectic days spent with his colorful companions, a massive shadow looms over the peaceful continent, and Lute's destiny begins to spiral.\n\nCan the boy become the Dragon Sword—the Hero destined to save the continent?\n\n[ A Wondrous Adventure in an Anime-Style Open World ]\n\nExplore the Continent of Orbis—a radiant, warmly colored fantasy world brought to life with Unreal Engine 5!\n\n■ A Living, Breathing Open World\n\nVenture across beautiful meadows, secret cellars beneath watchtowers, treasure-filled deep seas, and hidden caves and dungeons—all yours to explore on foot.\n\n■ Reliable Adventure Companions\n\nTravel with trusty allies and adorable collectible companions called Familiars that aid you on your journey.\n\n■ Where Everyday Life Becomes an Adventure\n\nCombine ingredients found across the continent to create new dishes through Cooking, solve the problems of local residents, and become a true member of Orbis.\n\n[ Thrilling Tag-Team Action Using Status Ailments ]\n\nExperience the spectacular tag-team action unique to Dragon Sword.\n\n■ Status Ailments and Signal Skills\n\nEach of the 19 Heroes possesses distinct Status Ailment abilities. Stack Status Ailments with Active Skills, then chain devastating combos with powerful Signal Skills for an exhilarating combat experience.\n\n■ Endless Signal Switching\n\nHeroes weave in and out of battle in endless combo chains through Switching Signals! Build your own team with diverse combinations and craft your ultimate stylish combat.\n\n[ Precious Bonds and Their Stories ]\n\nFrom allies who fight alongside you to village guards, every character in Orbis carries a story of their own.\n\n■ Heroes with Deep Narratives\n\nDiscover factions entangled in complex interests and the hidden depths of the Heroes within them.\n\n■ Characters Brimming with Personality\n\nFrom an eccentric Elf who studies archaeology to a mysterious girl who traverses dimensions—forge bonds with a colorful cast and draw closer to the truth of the world.\n\n[ The Dragon Awakened After 60 Years and the Legacy of Six Heroes ]\n\nLong ago, a Dragon brought the continent to the brink of destruction, and six Heroes rose to save it.\n\nNow, 60 years later, a Dragon has appeared once more on the peaceful Continent of Orbis.\n\nYou will take on a critical quest to find the Heroes of old and confront the returning Dragon's threat. Tracing the footsteps of the legendary Heroes across the continent, you will uncover their hidden secrets.\n\nUntil the boy Lute and his mercenary band rise to become the Heroes who will save the continent—\n\nCan they truly become the Dragon Sword, saviors of the continent, or will fate lead them down a different path?\n\nJoin them on this arduous journey and find out!","aboutGame":null},"vi":{"status":"translated","provider":"argos-translate-en_vi-1.9-ctranslate2-int8","translatedAt":"2026-10-16T13:04:57.404917+00:00","sourceHash":"52fd9ddc94328ec09e2282bfc59b694d957e0f47fd2c1a7e7d7ba6099c2863d5","reviewStatus":"machine_translation_unreviewed","shortDescription":"Khám phá thế giới mở theo hàng mét của Lục địa Orbis, làm sống lại với động cơ không thật số 5! Những người bạn độc nhất vô nhị, giải phóng trạng thái chiến đấu đầy ngoạn mục, và bắt tay vào một hành trình vĩ đại để cứu thế giới khỏi mối đe dọa của một con rồng đã được đánh thức sau 60 năm.","detailedDescription":"[Tiếng thở của một cậu bé, hành trình cứu thế giới bắt đầu]\nLute, một cậu bé đi đến Orbis - vương quốc đầu tiên do loài người xây dựng - tìm thấy chính mình bị cuốn hút trong cuộc sống của Johnny, một lính đánh thuê, và Castella, một Tiên nhân, vấp ngã đầu tiên vào cuộc sống hỗn loạn của một lính đánh thuê.\nGiữa những ngày bận rộn với những người đồng hành đầy màu sắc của mình, một cái bóng khổng lồ bao trùm lục địa hòa bình, và vận mệnh của Lute bắt đầu hình thành xoắn ốc.\nLiệu cậu bé có thể trở thành Thần Long Kiếm, người anh hùng được định sẵn để cứu lục địa?\n[Một cuộc phiêu lưu nổi tiếng trong một thế giới mở Anime-Stle]\nKhám phá lục địa Orbis - một thế giới ảo tưởng màu sắc nồng nhiệt và rực rỡ mang lại sự sống cho động cơ không thật số 5!\n▪ Một thế giới mới mở rộng và mở rộng\nXâm nhập qua những cánh đồng cỏ xinh đẹp, những hầm bí mật bên dưới tháp canh, những vùng biển đầy kho báu, những hang động và hầm ngục bí mật... tất cả những gì các bạn có thể khám phá bằng chân.\n▪ Những người bạn đáng tin cậy trong cuộc phiêu lưu\nDu lịch với những đồng minh đáng tin cậy và những người bạn thu nhặt đáng yêu gọi là quen thuộc giúp bạn trong cuộc hành trình.\n▪ Cuộc sống hằng ngày trở thành một cuộc phiêu lưu\nCác thành phần được tìm thấy trên khắp lục địa để tạo ra các món ăn mới qua nấu ăn, giải quyết các vấn đề của cư dân địa phương, và trở thành một thành viên thực sự của Orbis.\n[ Hành động kích thích thẻ tín dụng sử dụng trạng thái an toàn]\nHãy trải nghiệm một hành động ngoạn mục độc nhất vô nhị của Long Kiếm.\n▪ Phụ thuộc vào trạng thái và kỹ năng nhận tín hiệu\nMỗi anh hùng đều có những khả năng khác nhau về trạng thái an toàn. Các tập hợp với kỹ năng tích cực, rồi chuỗi các kết hợp tàn phá với các kỹ năng tín hiệu mạnh mẽ cho một kinh nghiệm chiến đấu đầy phấn khởi.\n▪ Chuyển đổi tín hiệu không có hồi kết\nNhững anh hùng đã kéo vào và ra khỏi cuộc chiến trong một chuỗi liên kết vô tận thông qua các tín hiệu chuyển đổi! Hãy xây dựng đội của riêng bạn với sự kết hợp đa dạng và tạo ra chiến đấu tinh xảo nhất của bạn.\n[Những trái phiếu quý giá và những câu chuyện của họ]\nTừ những đồng minh chiến đấu bên cạnh bạn đến những người bảo vệ làng, mỗi nhân vật ở Orbis đều có một câu chuyện riêng.\n▪ Anh hùng với những người có lòng quan tâm sâu xa\nPhát hiện ra các phe phái dính líu vào những lợi ích phức tạp và những bí mật của anh hùng bên trong họ.\n▪ Các ký tự hối lộ về nhân cách\nTừ một Tiên nhân lập dị nghiên cứu khảo cổ học đến một cô gái bí ẩn người đã đi qua các chiều không gian với một khuôn đúc đầy màu sắc và đến gần hơn với sự thật của thế giới.\n[Những con rồng thức giấc sau 60 năm và di sản của 6 anh hùng]\nTrước đây rất lâu, một con rồng đã mang lục địa đến bờ vực của sự hủy diệt, và sáu anh hùng đã sống lại để cứu lấy nó.\n60 năm sau, một con rồng lại xuất hiện trên Lục địa hòa bình của Orbis.\nNgươi sẽ phải chịu một cuộc hành trình quan trọng để tìm ra anh hùng thời xưa và đối mặt với mối đe dọa của Rồng trở về. Đi theo bước chân của những anh hùng huyền thoại xuyên lục địa, các bạn sẽ khám phá ra bí mật bí mật của họ.\nCho đến khi cậu bé Lute và nhóm lính đánh thuê của anh ta nổi lên để trở thành anh hùng sẽ cứu lục địa\nLiệu họ có thể thật sự trở thành Thần Kiếm Rồng, vị cứu tinh của lục địa, hay định mệnh sẽ dẫn dắt họ đi theo con đường khác?\nHãy tham gia cùng họ trong chuyến đi gian khổ này và tìm hiểu!","aboutGame":null}},"media":{"images":[{"role":"header","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4570720/96a897e98f4472e656fbe6681191b3066cab6056/header.jpg?t=1792049718"},{"role":"capsule","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4570720/ad4778acc2facf46b58f6c66492e925c9efd5cb7/capsule_231x87.jpg?t=1792049718"}],"screenshots":[{"id":0,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4570720/3465ef4d24f71d133cd345f7e6dcf3df89ff051a/ss_3465ef4d24f71d133cd345f7e6dcf3df89ff051a.600x338.jpg?t=1792049718","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4570720/3465ef4d24f71d133cd345f7e6dcf3df89ff051a/ss_3465ef4d24f71d133cd345f7e6dcf3df89ff051a.1920x1080.jpg?t=1792049718"},{"id":1,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4570720/54fe2d824299bf877d9db3b013184b4f6c3b5e80/ss_54fe2d824299bf877d9db3b013184b4f6c3b5e80.600x338.jpg?t=1792049718","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4570720/54fe2d824299bf877d9db3b013184b4f6c3b5e80/ss_54fe2d824299bf877d9db3b013184b4f6c3b5e80.1920x1080.jpg?t=1792049718"},{"id":2,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4570720/54e15b9fe0c6c57f1e0c31df0572729ae5108ec8/ss_54e15b9fe0c6c57f1e0c31df0572729ae5108ec8.600x338.jpg?t=1792049718","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4570720/54e15b9fe0c6c57f1e0c31df0572729ae5108ec8/ss_54e15b9fe0c6c57f1e0c31df0572729ae5108ec8.1920x1080.jpg?t=1792049718"},{"id":3,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4570720/31e4fcb6d3398d96a98a3f63024b0e6176364147/ss_31e4fcb6d3398d96a98a3f63024b0e6176364147.600x338.jpg?t=1792049718","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4570720/31e4fcb6d3398d96a98a3f63024b0e6176364147/ss_31e4fcb6d3398d96a98a3f63024b0e6176364147.1920x1080.j