adata":{"appId":"1227690","links":{"store":"https://store.steampowered.com/app/1227690/","officialWebsite":"https://www.greylockgamesstudio.com/","support":"https://www.greylockgamesstudio.com/"},"storageRequirements":{"kind":"required_free_space","windows":{"minimum":null,"recommended":null},"macos":{"minimum":null,"recommended":null},"linux":{"minimum":null,"recommended":null},"note":"Steam publishes required free space, not the exact installed or download size."},"controllerSupport":{"level":"full","xboxCompatible":null,"xboxEvidence":null,"note":"Generic Steam controller support does not prove Xbox controller compatibility."},"playerModes":{"singlePlayer":true,"multiplayer":false,"coop":false,"onlineCoop":false,"localCoop":false,"lanCoop":false,"sharedOrSplitScreen":false,"pvp":false,"maximumPlayers":null,"maximumPlayersNote":"The public Steam app-details response does not provide a reliable exact player limit.","evidence":["Single-player"]},"genres":["Action","Indie"],"categories":[{"id":2,"description":"Single-player"},{"id":22,"description":"Steam Achievements"},{"id":28,"description":"Full controller support"},{"id":30,"description":"Steam Workshop"},{"id":23,"description":"Steam Cloud"},{"id":25,"description":"Steam Leaderboards"},{"id":17,"description":"Includes level editor"},{"id":62,"description":"Family Sharing"}]}},"content":{"status":"success","steamAppId":"1227690","steamName":"Severed Steel","sourceUrl":"https://store.steampowered.com/app/1227690/","fetchedAt":"2026-10-16T07:53:27.565976+00:00","locales":{"en":{"status":"source","provider":"steam","shortDescription":"An intense single-player FPS featuring a stylish movement system, completely destructible levels, and an acclaimed OST.","detailedDescription":"Severed Steel is a single-player FPS featuring a fluid stunt system, destructible voxel environments, loads of bullet time, and a unique one-armed protagonist. It's you, your trigger finger, and a steel-toed boot against a superstructure full of bad guys. Chain together wall runs, dives, flips, and slides to take every last enemy down.\n\nKey Features\nA Unique Fighter\n\nPlay as Steel, a nimble, one-armed sharpshooter on a mission. There is no reloading – pick your shots well and be ready to pry a loaded weapon from your enemies' cold dead hands.\nStylish Combat\n\nDodge bullets, leap off walls, slide kick, throw weapons – do whatever it takes to come out on top in intense and frenzied firefights.\nFully Destructible Environment\n\nPunch through thick concrete with .50 cal slugs, or make big holes in things with your arm cannon. Carve your own path through completely destructible levels.\n\nDynamic AI\nNo two battles are the same thanks to dynamic, unscripted, squad-based AI.\nFirefight Mode\nChase high scores and fast times for leaderboard acclaim in this arcade-styled mode. Features 42 levels, each with their own sub-challenges, and over 20 unlockable, game modifying 'Mutators'.\nCampaign Mode\nBlast through six compact story chapters as you battle against the forces of nefarious mega-corporation, EdenSys. Finish the campaign and want more? Try New Game + mode which mixes up the campaign for a fresh playthrough.\nRogue Mode\nSevered Steel with Rogue-lite elements. Click the Rogue Steel button on the main menu to start a short, randomly generated, 10 level campaign. Features unlockable perks, skins, and more.\nAccessibility\nA range of adjustable settings for features such as difficulty, visuals, audio, controls, navigation, and more.\nLevel Editor (with Steam Workshop support)\nBuild levels and share them with the community. Note: This feature is in beta and will continue to be updated post-launch.","aboutGame":null},"vi":{"status":"pending_translation","provider":null,"shortDescription":null,"detailedDescription":null,"aboutGame":null}},"media":{"images":[{"role":"header","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1227690/header.jpg?t=1723920018"},{"role":"capsule","url"