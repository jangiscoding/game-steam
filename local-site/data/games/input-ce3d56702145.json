{"id":"input-ce3d56702145","steamAppId":"1351210","name":"Gord","imageUrl":"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/1351210/library_600x900.jpg","imageStatus":"downloaded","steamUrl":"https://store.steampowered.com/app/1351210/","genres":["Adventure","Indie","Simulation","Strategy"],"platforms":["windows"],"controllerSupport":"full","playerModes":{"singlePlayer":true,"multiplayer":false,"coop":false,"localCoop":false,"sharedOrSplitScreen":false,"onlineCoop":false,"maximumPlayers":null},"storage":{"windowsMinimumGB":20.0,"windowsMinimumDisplay":"20 GB"},"verificationStatus":"identified","custom":{},"sourceProfile":{"inputRecordId":"input-ce3d56702145","canonicalId":"steam-app-1351210","suppliedName":"Gord","suppliedImageUrl":"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/1351210/library_600x900.jpg","officialName":"Gord","aliases":[],"series":null,"franchise":null,"productType":"game","editionName":null,"originalReleaseYear":null,"identifiedVersionReleaseYear":2023,"developers":["Covenant.dev"],"publishers":["Team17"],"platforms":["windows"],"genres":["Adventure","Indie","Simulation","Strategy"],"shortDescription":"Gord is a single-player adventure strategy. To survive, you must build, but to prevail, you must conquer the darkness beyond the gates. In this dark fantasy world, you must complete quests while managing a populace whose personal stories and well-being decide the fate of your tribe.","confusingWith":[],"candidateIdentifiers":{"steamAppId":"1351210"},"sources":[{"label":"Steam Store","url":"https://store.steampowered.com/app/1351210/","accessedAt":"2026-10-15T10:30:30.300Z","supports":["officialName","productType","identifiedVersionReleaseYear","developers","publishers","platforms","genres","shortDescription","steamMetadata.links","steamMetadata.storageRequirements","steamMetadata.controllerSupport","steamMetadata.playerModes"]}],"confidence":"high","status":"identified","verificationNotes":["The supplied name