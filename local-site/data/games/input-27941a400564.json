7.1920x1080.jpg?t=1726064636"},{"id":18,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2520410/ss_fecd7e966adcaa093e10290cbf243b2ac1fd0017.600x338.jpg?t=1726064636","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2520410/ss_fecd7e966adcaa093e10290cbf243b2ac1fd0017.1920x1080.jpg?t=1726064636"},{"id":19,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2520410/ss_4ac67fce539480291625156fced15e26d09e03d2.600x338.jpg?t=1726064636","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2520410/ss_4ac67fce539480291625156fced15e26d09e03d2.1920x1080.jpg?t=1726064636"},{"id":20,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2520410/ss_3137c42a7fa1748a24667a1bd600ab6c37d3caeb.600x338.jpg?t=1726064636","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2520410/ss_3137c42a7fa1748a24667a1bd600ab6c37d3caeb.1920x1080.jpg?t=1726064636"},{"id":21,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2520410/ss_f6776551dfac88b41d7e6de98779c11e80fc1dde.600x338.jpg?t=1726064636","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2520410/ss_f6776551dfac88b41d7e6de98779c11e80fc1dde.1920x1080.jpg?t=1726064636"},{"id":22,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2520410/ss_4ea19142dfa018419a0b5f7a8162e8c0693e9b85.600x338.jpg?t=1726064636","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2520410/ss_4ea19142dfa018419a0b5f7a8162e8c0693e9b85.1920x1080.jpg?t=1726064636"},{"id":23,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2520410/ss_d1811919edf109c021cc59b9a36e81d96181613f.600x338.jpg?t=1726064636","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2520410/ss_d1811919edf109c021cc59b9a36e81d96181613f.1920x1080.jpg?t=1726064636"},{"id":24,"thumbnail