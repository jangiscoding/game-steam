38.jpg?t=1782168871","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/449300/ss_88d172446b84322b5ec516eb2f24e27399cd844f.1920x1080.jpg?t=1782168871"}],"videos":[{"id":256662104,"name":"Planar Conquest intro","thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/256662104/movie.293x165.jpg?t=1460047925","highlight":true,"sources":[{"format":"hls_h264","url":"https://video.akamai.steamstatic.com/store_trailers/449300/55027/28fd1456155436eb0cbff800dc7f3d0112cb6323/1751286896/hls_264_master.m3u8?t=1460047925"}]},{"id":256664760,"name":"Planar Conquest Launch Trailer","thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/256664760/movie.293x165.jpg?t=1464534252","highlight":true,"sources":[{"format":"hls_h264","url":"https://video.akamai.steamstatic.com/store_trailers/449300/60749/7a6905793d1361e4cf659b253625986c320c41af/1751286897/hls_264_master.m3u8?t=1464534252"}]},{"id":256664813,"name":"Planar Conquest Tutorial 01","thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/256664813/movie.293x165.jpg?t=1464611124","highlight":true,"sources":[{"format":"hls_h264","url":"https://video.akamai.steamstatic.com/store_trailers/449300/60876/0acdf8b6ee3e61de1d7153c58609c33fa68ed472/1751286897/hls_264_master.m3u8?t=1464611124"}]},{"id":256664814,"name":"Planar Conquest Tutorial 02","thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/256664814/movie.293x165.jpg?t=1464611133","highlight":true,"sources":[{"format":"hls_h264","url":"https://video.akamai.steamstatic.com/store_trailers/449300/60879/0f2e9bf6d63aef95b61e5b7d94e7bfcd953d8756/1751286904/hls_264_master.m3u8?t=1464611133"}]},{"id":256664817,"name":"Planar Conquest Tutorial 03","thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/256664817/movie.293x165.jpg?t=1464611142","highlight":true,"sources":[{"format":"hls_h264","url":"https://video.akamai.steamstati