g another authoritative source before linking a canonical ID."],"research":{"steam":{"status":"success","checkedAt":"2026-10-15T10:32:24.695Z","error":null}},"steamMetadata":{"appId":"98400","links":{"store":"https://store.steampowered.com/app/98400/","officialWebsite":"http://www.hardresetgame.com/","support":null},"storageRequirements":{"kind":"required_free_space","windows":{"minimum":{"value":4,"unit":"GB","display":"4 GB","approximateBytes":4000000000,"evidenceText":"Hard Disk Space: 4 GB"},"recommended":{"value":4,"unit":"GB","display":"4 GB","approximateBytes":4000000000,"evidenceText":"Hard Disk Space: 4 GB"}},"macos":{"minimum":null,"recommended":null},"linux":{"minimum":null,"recommended":null},"note":"Steam publishes required free space, not the exact installed or download size."},"controllerSupport":{"level":"partial","xboxCompatible":null,"xboxEvidence":null,"note":"Generic Steam controller support does not prove Xbox controller compatibility."},"playerModes":{"singlePlayer":true,"multiplayer":false,"coop":false,"onlineCoop":false,"localCoop":false,"lanCoop":false,"sharedOrSplitScreen":false,"pvp":false,"maximumPlayers":null,"maximumPlayersNote":"The public Steam app-details response does not provide a reliable exact player limit.","evidence":["Single-player"]},"genres":["Action","Indie"],"categories":[{"id":2,"description":"Single-player"},{"id":22,"description":"Steam Achievements"},{"id":18,"description":"Partial Controller Support"},{"id":15,"description":"Stats"},{"id":25,"description":"Steam Leaderboards"},{"id":62,"description":"Family Sharing"}]}},"content":{"status":"success","steamAppId":"98400","steamName":"Hard Reset Extended Edition","sourceUrl":"https://store.steampowered.com/app/98400/","fetchedAt":"2026-10-16T09:57:54.197018+00:00","locales":{"en":{"status":"source","provider":"steam","shortDescription":"Over-the-top destruction, loads of enemies & a beautifully realized cyberpunk setting. Hard Reset is here to shake up the shooter scene. Try the demo now.","detailedDescription":"In the only remaining human city of Bezoar, Major Fletcher, an Army Combat Veteran and soldier of the CLN, is dragged into a conflict between two of mankind's greatest enemies. He is to discover that nothing is what it seems to be.\n\t\t\t\t\t\t\tHard Reset is an action-packed, single-player shooter for the PC. With over-the-top destruction, loads of enemies, great weapon variety and a beautifully realized cyberpunk setting, Hard Reset is sure to shake up the shooter scene.\n\t\t\t\t\t\t\t\nKey features:\n\t\t\t\t\t\t\t\n\n• A haunting cyberpunk / dark sci-fi setting\n\t\t\t\t\t\t\t\n\n• Fast-paced, old-school shooter gameplay\n\t\t\t\t\t\t\t\n\n• Hordes of enemies to destroy\n\t\t\t\t\t\t\t\n\n• Epic boss fights \n\t\t\t\t\t\t\t\n\n• A deep, experience-based weapon upgrade system\n\t\t\t\t\t\t\t\n\n• High-fidelity graphics with full dynamic lighting\n\t\t\t\t\t\t\t\n\n• Extensive use of physics and dynamic environments","aboutGame":null},"vi":{"status":"translated","provider":"argos-translate-en_vi-1.9-ctranslate2-int8","translatedAt":"2026-10-16T13:34:23.714560+00:00","sourceHash":"54ddeb7cea526fb7853521768971befe0d0433886a74eec6f9e4238a40537e5d","reviewStatus":"machine_translation_unreviewed","shortDescription":"Trên đỉnh sự hủy diệt, rất nhiều kẻ thù và một thiết lập mạng đẹp đã nhận ra. Đặt lại ở đây để làm rung chuyển hiện trường vụ án. Thử làm bản thử nghiệm ngay bây giờ.","detailedDescription":"Trong thành phố còn lại của con người Bezoar, Thiếu tá Fletcher, một quân đội của Veteran và những người lính của CLN, bị kéo vào một cuộc xung đột giữa hai kẻ thù lớn nhất của nhân loại. Anh ta sẽ khám phá ra rằng không có gì là như thế cả. Thiết lập lại là một trò chơi hành động, đơn người chơi cho máy tính. Với sự phá hủy trên đỉnh cao, hàng loạt kẻ thù, vũ khí đa dạng tuyệt vời và một thiết lập công nghệ cao, thiết lập lại là chắc chắn sẽ làm rung chuyển cảnh bắn súng.\nCác tính năng khóa:\n\n• Một trò chơi ảo ám ảnh / trò chơi điện tử viễn tưởng\n\n• Trò chơi bắn súng nhanh, kiểu cũ\n\n• Những kẻ thù đáng bị hủy diệt\n\n• Người chủ đấu võ thuật\n\n• Một hệ thống nâng cấp vũ khí dựa trên kinh nghiệm sâu sắc\n\n• Đồ họa có độ sáng cao với đầy đủ năng động\n\n• Dùng nhiều vật lý và môi trường sống động","aboutGame":null}},"media":{"images":[{"role":"header","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/98400/header.jpg?t=1709567916"},{"role":"capsule","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/98400/capsule_231x87.jpg?t=1709567916"}],"screenshots":[{"id":0,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/98400/ss_05cd75b8fcce8fc7c971de61484fd404d8863867.600x338.jpg?t=1709567916","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/98400/ss_05cd75b8fcce8fc7c971de61484fd404d8863867.1920x1080.jpg?t=1709567916"},{"id":1,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/98400/ss_be52db660a46617361ba3e39089878f371acc4cd.600x338.jpg?t=1709567916","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/98400/ss_be52db660a46617361ba3e39089878f371acc4cd.1920x1080.jpg?t=1709567916"},{"id":2,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/98400/ss_976ad056190f446551a19358fb9dae0cfe235de3.600x338.jpg?t=1709567916","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/98400/ss_976ad056190f446551a19358fb9dae0cfe235de3.1920x1080.jpg?t=1709567916"},{"id":3,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/98400/ss_ed4f7640221c4956167054f12ac30e3e4204f8f1.600x338.jpg?t=1709567916","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/98400/ss_ed4f7640221c4956167054f12ac30e3e4204f8f1.1920x1080.jpg?t=1709567916"},{"id":4,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/98400/ss_c4f78914e7f49f64ec90f232