data.playerModes"]}],"confidence":"high","status":"identified","verificationNotes":["The supplied name exactly matches the normalized official Steam name for the supplied App ID."],"research":{"steam":{"status":"success","checkedAt":"2026-10-15T11:09:24.453Z","error":null}},"steamMetadata":{"appId":"541300","links":{"store":"https://store.steampowered.com/app/541300/","officialWebsite":"https://www.survivethenights.net/","support":"https://www.survivethenights.net/"},"storageRequirements":{"kind":"required_free_space","windows":{"minimum":{"value":15,"unit":"GB","display":"15 GB","approximateBytes":15000000000,"evidenceText":"Storage: 15 GB"},"recommended":{"value":20,"unit":"GB","display":"20 GB","approximateBytes":20000000000,"evidenceText":"Storage: 20 GB"}},"macos":{"minimum":{"value":10,"unit":"GB","display":"10 GB","approximateBytes":10000000000,"evidenceText":"Storage: 10 GB"},"recommended":{"value":10,"unit":"GB","display":"10 GB","approximateBytes":10000000000,"evidenceText":"Storage: 10 GB"}},"linux":{"minimum":null,"recommended":null},"note":"Steam publishes required free space, not the exact installed or download size."},"controllerSupport":{"level":"full","xboxCompatible":null,"xboxEvidence":null,"note":"Generic Steam controller support does not prove Xbox controller compatibility."},"playerModes":{"singlePlayer":true,"multiplayer":true,"coop":true,"onlineCoop":true,"localCoop":false,"lanCoop":true,"sharedOrSplitScreen":false,"pvp":true,"maximumPlayers":null,"maximumPlayersNote":"The public Steam app-details response does not provide a reliable exact player limit.","evidence":["Single-player","Multi-player","PvP","Online PvP","LAN PvP","Co-op","Online Co-op","LAN Co-op"]},"genres":["Action","Adventure","Indie","Massively Multiplayer","Simulation"],"categories":[{"id":2,"description":"Single-player"},{"id":1,"description":"Multi-player"},{"id":49,"description":"PvP"},{"id":36,"description":"Online PvP"},{"id":47,"description":"LAN PvP"},{"id":9,"description":"Co-op"},{"id":38,"description":"Online Co-op"},{"id":48,"description":"LAN Co-op"},{"id":22,"description":"Steam Achievements"},{"id":28,"description":"Full controller support"},{"id":30,"description":"Steam Workshop"},{"id":35,"description":"In-App Purchases"},{"id":64,"description":"Adjustable Text Size"},{"id":68,"description":"Custom Volume Controls"},{"id":78,"description":"Adjustable Difficulty"},{"id":74,"description":"Playable without Timed Input"},{"id":55,"description":"DualShock Controller Support"},{"id":57,"description":"DualSense Controller Support"},{"id":79,"description":"Save Anytime"},{"id":59,"description":"Steam Input API Support"},{"id":69,"description":"Stereo Sound"},{"id":23,"description":"Steam Cloud"},{"id":15,"description":"Stats"},{"id":41,"description":"Remote Play on Phone"},{"id":42,"description":"Remote Play on Tablet"},{"id":43,"description":"Remote Play on TV"},{"id":62,"description":"Family Sharing"}]}},"content":{"status":"success","steamAppId":"541300","steamName":"Survive the Nights","sourceUrl":"https://store.steampowered.com/app/541300/","fetchedAt":"2026-10-16T09:25:56.112136+00:00","locales":{"en":{"status":"source","provider":"steam","shortDescription":"Hardcore open-world survival where preparation is everything. Scavenge, craft, fortify during the day. When night falls, the infected hunt in numbers. Play solo or with friends in a brutal post-apocalyptic sandbox where survival is earned through smart decisions. How many Nights will you survive?","detailedDescription":"Prepare during the day. Survive the night.\n\nSurvive the Nights is a hardcore open-world survival game where preparation is everything. Scavenge, craft, fortify, and plan during the day — because when night falls, the infected hunt in numbers, and mistakes are punished.\n\nPlay solo or with friends in a brutal post-apocalyptic sandbox where survival is earned through smart decisions, strong fortifications, and cooperation under pressure.\n\nZombies\n\nZombie difficulty comes from numbers, not individual strength. By day they roam slowly — by night they gather into massive hordes drawn to player activity. The longer you survive, the bigger and more dangerous the nights become.\n\n \n\nFortify Everything\n\nStructures and vehicles are fully fortifiable. Cover windows and add strength to gain the advantage. \n\nMobile Homes\n\nLike to be on the move? Take your home on the road. Cook, sleep and store your items in your mobile base.\n\nStorage and bases\n\nSettle into your new home by using pegboards, player storage and blueprints to put your stamp on the place. Physically place your items in the world to make your perfect survival hideout. Use traps to get the upper hand. Traps can give you the edge when zombies or raiders arrive.\n\nNutrition & Hydration\n\nCook over an open fire or directly on a stove to manage your calorie and hydration needs. Maintaining your player vitals will increase your overall strength and carrying capacity over time. \n\nSick of canned food? Head out into the wilderness to hunt for larger animals. \n\nWhen food stores start to run out, turn to farming for your calorie needs. Protect your crops indoors under light or grow them outside in the warmer months to produce food that will last through winter. \n\n \n\nWeapon Customization\n\nWeapon attachments let you customize your gun and get it just right for your play style. \n\nVehicle Maintenance\n\nEvery vehicle is repairable. Engine and wheel parts are required to get a vehicle running. Items can be stored in trunks and on truck beds.\n\n  \n\nPOIs \n\nExplore the different points of interest to find valuable location-specific loot.\n\nWeather & Seasons\n\nThe weather is dynamic including all four seasons along with seasonal vegetation and foliage.\n\nDay & Night Objectives\n\nSpend your days preparing to survive the onslaught at night. Zombies are more aggressive and alert when the sun goes down. \n\nDay Objectives: During the day, focus on resource gathering and fortification. Fell trees, craft planks, engage in hunting and trapping. Collect loot, food, and fortify a structure. Ensure doors and containers are locked, fuel generators, and prepare power systems. Keep your health up by lighting fires, crafting bandages, and gearing up for the night. \n\n \n\nNight Objectives: At night, prioritize safety and stealth. Team up with friends in a secured structure, favor melee over firearms to stay quiet. Activate generators, power up structures, set traps, and cook meals indoors on wood stoves. The key is to survive until morning.\n\nMental Health System\n\nThe mental health system discourages the \"Kill On Sight\" mentality, promoting alliances for better survival against the zombie threat. While PVP is still a factor, players have ways to correct a negative mental state.\n\nYour Apocalypse, Your Rules\n\nSurvival and zombies how you like them! Browse hundreds of scenarios that set the scene for your perfect survival experience. Zombie survival just how you want it.\n\nElectrical Systems\n\nPowering a structure can provide light to make nighttime activities easier. Some structures also require electricity to power interior and exterior doors.\n\nModding\n\nFull Steam Workshop support with the ability to mod all areas of the game. Mods can be browsed and installed directly ingame.\n\nSteam Achievements \n\nIf achievements are your thing, we’ve got you covered. With almost 100 achievements, you’ll be busy for some time. Can you ‘Choke a Chicken’?\n\nServer Hosting & Solo Play\n\nSimple game hosting that uses steam relays. There’s no need to port forward. Simply choose your settings and start playing. \n\nPlans for Future Updates\n\n• \nExpand electrical systems - This will include electrical traps, house alarms, heating systems, working stoves, more lighting in towns and roadways, light towers, functioning water pumps (water tied to power).\n\n• \nExpanding weapons - New weapons and improved handling.\n\n• \nAdditional vehicles - Expanding on “mobile survival” such as adding box trucks, trailers and light aircraft. \n\n• \nFishing - Spend your days shore side with a line in the water, if you think it’s safe.\n\n• \nCharacter customization - A full scale character customization feature including the implementation of a female character\n\n• \nExpand on STN+ and Workshop - This includes more furniture, structure painting, holiday lights and decorations, proper Steam workshop implementation and working arcade’s with API.\n\n• \nGrouping system - Players can join a grouping system with friends.\n\n• \nIsland wide community missions and events - Come together to clear out larger structures. Band together and share your loot to repair the power station and provide the entire island with power.","aboutGame":null},"vi":{"status":"pending_translation","provider":null,"shortDescription":null,"detailedDescription":null,"aboutGame":null}},"media":{"images":[{"role":"header","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/541300/bc791c6873199ead0b560f2b4472ae911275e77d/header_alt_assets_11.jpg?t=1766055218"},{"role":"capsule","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/541300/3defaf4d7817bf1650126f3ebf58f5e85c7ed3da/capsule_231x87_alt_assets_11.jpg?t=1766055218"},{"role":"description","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/541300/extras/03c83590b0938f41ed2a4235315958d2.poster.avif?t=1766055218","alt":""},{"role":"description","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/541300/extras/c4316b67bbd122e86f7d9cc2c6e491cf.avif?t=1766055218","alt":""},{"role":"description","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/541300/extras/5a424dd2ec6293726abd7f5080e9378b.avif?t=1766055218","alt":""},{"role":"description","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/541300/extras/41b51743ebd05e476c11449230fc48fa.avif?t=17