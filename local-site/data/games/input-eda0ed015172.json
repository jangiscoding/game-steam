eamMetadata.controllerSupport","steamMetadata.playerModes"]}],"confidence":"high","status":"identified","verificationNotes":["The supplied name exactly matches the normalized official Steam name for the supplied App ID."],"research":{"steam":{"status":"success","checkedAt":"2026-10-15T10:20:02.990Z","error":null}},"steamMetadata":{"appId":"1594320","links":{"store":"https://store.steampowered.com/app/1594320/","officialWebsite":"https://www.captain-of-industry.com/","support":"https://www.captain-of-industry.com/"},"storageRequirements":{"kind":"required_free_space","windows":{"minimum":{"value":3,"unit":"GB","display":"3 GB","approximateBytes":3000000000,"evidenceText":"Storage: 3 GB"},"recommended":{"value":4,"unit":"GB","display":"4 GB","approximateBytes":4000000000,"evidenceText":"Storage: 4 GB"}},"macos":{"minimum":null,"recommended":null},"linux":{"minimum":null,"recommended":null},"note":"Steam publishes required free space, not the exact installed or download size."},"controllerSupport":{"level":"unknown","xboxCompatible":null,"xboxEvidence":null,"note":"Generic Steam controller support does not prove Xbox controller compatibility."},"playerModes":{"singlePlayer":true,"multiplayer":false,"coop":false,"onlineCoop":false,"localCoop":false,"lanCoop":false,"sharedOrSplitScreen":false,"pvp":false,"maximumPlayers":null,"maximumPlayersNote":"The public Steam app-details response does not provide a reliable exact player limit.","evidence":["Single-player"]},"genres":["Indie","Simulation","Strategy","Early Access"],"categories":[{"id":2,"description":"Single-player"},{"id":64,"description":"Adjustable Text Size"},{"id":67,"description":"Camera Comfort"},{"id":68,"description":"Custom Volume Controls"},{"id":78,"description":"Adjustable Difficulty"},{"id":76,"description":"Mouse Only Option"},{"id":80,"description":"#category_playable_at_your_own_pace"},{"id":74,"description":"Playable without Timed Input"},{"id":79,"description":"Save Anytime"},{"id":69,"description":"Stereo Sound"},{"id":23,"description":"Steam Cloud"},{"id":17,"description":"Includes level editor"},{"id":62,"description":"Family Sharing"}]}},"content":{"status":"success","steamAppId":"1594320","steamName":"Captain of Industry","sourceUrl":"https://store.steampowered.com/app/1594320/","fetchedAt":"2026-10-16T08:10:16.272774+00:00","locales":{"en":{"status":"source","provider":"steam","shortDescription":"Build an industrial empire on a remote island. Mine resources, reshape terrain with excavators, grow food, construct factories, lay train tracks, and trade with the outside world. Research 100+ technologies to advance from basic metal smelting all the way to nuclear power and space flight.","detailedDescription":"Your journey begins on a remote island with a small crew of workers and a ship full of supplies. Mine raw materials, reshape the fully dynamic terrain, grow crops, build factories, and research new technologies. Expand across the island, lay rail networks, trade with distant settlements, and work your way up to nuclear power and space flight.\n\nMine resources and shape the land\n\nThe entire terrain is fully dynamic. Every mountain can be flattened, every valley filled, and even the ocean can be reclaimed to expand the available land. Create open-pit mines to reach deep ore deposits, or dump excess rock into the ocean to expand your shoreline. Build ramps and slopes so your vehicles can reach any elevation.\n\nBuild your factory\n\nStart simple with iron smelting, concrete mixing, and food processing. As you research new technologies, expand into oil refining, electronics, computing, and eventually rocket and space station components. Manage waste and pollution before they affect your people's health.\n\nMove products with trucks, trains, belts, and pipes\n\nTrucks handle general logistics automatically, delivering products where they are needed most. Lay conveyor belts and pipes for high-throughput direct connections between machines. Build a rail network to move bulk cargo across long distances. Use amphibious vehicles and bridges to reach other islands.\n\nFeed and protect your people\n\nGrow crops on farms and process them into food or industrial products. Supply fertilizers to boost yields and build greenhouses to grow more advanced crops. Your population needs housing, clean water, electricity, healthcare, and household goods. Keep them happy and healthy, and they will reward you with Unity, a resource that lets you speed up construction, enact powerful edicts, and claim resources on the world map. Neglect waste management or let pollution build up, and diseases will spread.\n\nExplore, trade, and become self-sufficient\n\nSend your ship out to explore the world map. Discover new islands with resources to import, refugees to rescue, and allied settlements to trade with. Establish shipping contracts for recurring exchanges, or negotiate quick trades when you need something fast. Your ultimate goal is full self-sufficiency: launch rockets, build a space station, and mine asteroids for rare resources that make your colony independent indefinitely.\n\nYour tools\n\nCopy and paste parts of your factory, or save entire layouts as blueprints to reuse and share. Use planning mode to lay out designs before committing resources. Design your own island in the map editor and play it or share it with others. Or switch to sandbox mode where all buildings and resources are free, perfect for experimenting and learning.","aboutGame":null},"vi":{"status":"pending_translation","provider":null,"shortDescription":null,"detailedDescription":null,"aboutGame":null}},"media":{"images":[{"role":"header","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1594320/9a604b771ff99f83f21020ac2c0a2a54a7d18627/header.jpg?t=1784572847"},{"role":"capsule","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1594320/9658eff13963c70c805cae403f5fb4b5268e1351/capsule_231x87.jpg?t=1784572847"},{"role":"d