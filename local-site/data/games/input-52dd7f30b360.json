 for the supplied App ID."],"research":{"steam":{"status":"success","checkedAt":"2026-10-15T10:36:43.801Z","error":null}},"steamMetadata":{"appId":"2749000","links":{"store":"https://store.steampowered.com/app/2749000/","officialWebsite":null,"support":null},"storageRequirements":{"kind":"required_free_space","windows":{"minimum":{"value":2,"unit":"GB","display":"2 GB","approximateBytes":2000000000,"evidenceText":"Storage: 2 GB"},"recommended":{"value":2,"unit":"GB","display":"2 GB","approximateBytes":2000000000,"evidenceText":"Storage: 2 GB"}},"macos":{"minimum":null,"recommended":null},"linux":{"minimum":null,"recommended":null},"note":"Steam publishes required free space, not the exact installed or download size."},"controllerSupport":{"level":"full","xboxCompatible":null,"xboxEvidence":null,"note":"Generic Steam controller support does not prove Xbox controller compatibility."},"playerModes":{"singlePlayer":true,"multiplayer":false,"coop":false,"onlineCoop":false,"localCoop":false,"lanCoop":false,"sharedOrSplitScreen":false,"pvp":false,"maximumPlayers":null,"maximumPlayersNote":"The public Steam app-details response does not provide a reliable exact player limit.","evidence":["Single-player"]},"genres":["Casual","Simulation","Strategy"],"categories":[{"id":2,"description":"Single-player"},{"id":22,"description":"Steam Achievements"},{"id":28,"description":"Full controller support"},{"id":23,"description":"Steam Cloud"},{"id":62,"description":"Family Sharing"}]}},"content":{"status":"success","steamAppId":"2749000","steamName":"Inn Tycoon","sourceUrl":"https://store.steampowered.com/app/2749000/","fetchedAt":"2026-10-16T08:46:31.511612+00:00","locales":{"en":{"status":"source","provider":"steam","shortDescription":"Welcome to Inn Tycoon! Build, design, and manage your dream inn. Serve delightful meals, offer various services, and hire a stellar staff. Create a top-notch hospitality empire and become the ultimate Inn Tycoon!","detailedDescription":"Embark on a soothing journey to the medieval ages with Inn Tycoon – a chill and relaxing game where you shape the serenity of a bygone era. Delicious meals and ice-cold beverages await your service to customers. Increase reputation with various room options and customized furniture. Your dream inn awaits you to experience this magnificent atmosphere.\n\nRECRUIT STAFF FOR BEST SERVICE\n\nRecruit a team of skilled staff to ensure your inn runs like clockwork. From chefs and maids to entertainers, each employee plays a crucial role in creating a seamless and enjoyable stay for your guests. Your customers might be impatient, be careful not to upset them. Remember, Quality Service = Good Tips.\n\nUNEXPECTED SEASONAL CHANGES\n\nSometimes a cold snowy day, sometimes scorching heat. The frequently changing weather will be felt inside the inn as well. You’ll need to adapt to unexpected situations and handle the varying demands of your customers.\n\nUSE REPUTATION TO CREATE FESTIVALS\n\nYou’ll be able to organize events and festivals with the fame you’ve gained. Experience chill and relaxing inn management while hearing the music and laughter echoing through the walls.","aboutGame":null},"vi":{"status":"translated","provider":"argos-translate-en_vi-1.9-ctranslate2-int8","translatedAt":"2026-10-16T12:40:17.332773+00:00","sourceHash":"d7852035c0602c8f2f1a360bffa088b5ff2d0161f9cd82dabc13e7368111c343","reviewStatus":"machine_translation_unreviewed","shortDescription":"Chào mừng tới quán trọ Tycoon! Xây dựng, thiết kế, và quản lý nhà trọ trong mơ của bạn. Phục vụ những bữa ăn ngon, cung cấp những dịch vụ khác nhau và thuê một nhân viên sao. Tạo ra một đế chế hiếu khách hàng đầu tiên và trở thành một nhà vô địch của khách sạn.","detailedDescription":"Embark trên một cuộc hành trình thoải mái đến thời trung cổ với quán trọ Tycoon - một trò chơi thư giãn và thư giãn nơi bạn định hình sự thanh thản của thời xa xưa. Thức ăn ngon và đồ uống lạnh đang chờ khách hàng. Làm tăng danh tiếng với nhiều lựa chọn phòng khác nhau và đồ nội thất tùy chỉnh. Giấc mơ của anh đang chờ anh trải nghiệm bầu không khí tuyệt vời này.\nHÃY MỘT SỰ CHUYỆN ĐỂ TRỞ THÀNH TÂM\nHãy tuyển một đội ngũ nhân viên giỏi để đảm bảo quán trọ của anh hoạt động như đồng hồ. Từ đầu bếp và hầu gái cho đến những người giải trí, mỗi nhân viên đóng vai trò quan trọng trong việc tạo ra một chỗ ở thoải mái và vui vẻ cho khách. Khách hàng của anh có thể thiếu kiên nhẫn, cẩn thận không làm họ bực mình. Hãy nhớ, Dịch vụ Chất lượng = Lời khuyên tốt.\nCÁC CÂU CHUYỆN TRONG CÂU CHUYỆN\nĐôi khi là một ngày tuyết giá lạnh, đôi khi nóng bỏng. Thời tiết thay đổi thường xuyên cũng sẽ được cảm thấy bên trong quán trọ. Bạn cần thích nghi với những tình huống bất ngờ và đáp ứng những đòi hỏi khác nhau của khách hàng.\nDÀI HỌC ĐỂ TRỞ THÀNH\nBạn sẽ có thể tổ chức các sự kiện và lễ hội với danh tiếng mà bạn có được. Kinh nghiệm làm cho người quản lý nhà trọ thư giãn và lắng nghe âm nhạc và tiếng cười vang vọng qua các bức tường.","aboutGame":null}},"media":{"images":[{"role":"header","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2749000/62e4141bb89cf5ad8366bd01ef349fc758aca237/header.jpg?t=1775642534"},{"role":"capsule","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2749000/355d6357473901a3015aafa75022e9ceeb0dc968/capsule_231x87.jpg?t=1775642534"}],"screenshots":[{"id":0,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2749000/ss_cb204a3c9830502cd0e6392bbf92bf3f265f16a4.600x338.jpg?t=1775642534","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2749000/ss_cb204a3c9830502cd0e6392bbf92bf3f265f16a4.1920x1080.jpg?t=1775642534"},{"id":1,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2749000/ss_ace1a1ab9520a78eff2a206359d49a67cc8de588.600x338.jpg?t=1775642534","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2749000/ss_ace1a1ab9520a78eff2a206359d49a67cc8de588