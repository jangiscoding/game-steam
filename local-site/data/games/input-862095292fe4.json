onNotes":["The supplied name exactly matches the normalized official Steam name for the supplied App ID."],"research":{"steam":{"status":"success","checkedAt":"2026-10-15T10:20:04.903Z","error":null}},"steamMetadata":{"appId":"320300","links":{"store":"https://store.steampowered.com/app/320300/","officialWebsite":"http://www.playway.com/","support":"http://www.playway.com/"},"storageRequirements":{"kind":"required_free_space","windows":{"minimum":{"value":8,"unit":"GB","display":"8 GB","approximateBytes":8000000000,"evidenceText":"Storage: 8 GB"},"recommended":{"value":8,"unit":"GB","display":"8 GB","approximateBytes":8000000000,"evidenceText":"Storage: 8 GB"}},"macos":{"minimum":{"value":8,"unit":"GB","display":"8 GB","approximateBytes":8000000000,"evidenceText":"Storage: 8 GB"},"recommended":{"value":8,"unit":"GB","display":"8 GB","approximateBytes":8000000000,"evidenceText":"Storage: 8 GB"}},"linux":{"minimum":null,"recommended":null},"note":"Steam publishes required free space, not the exact installed or download size."},"controllerSupport":{"level":"unknown","xboxCompatible":null,"xboxEvidence":null,"note":"Generic Steam controller support does not prove Xbox controller compatibility."},"playerModes":{"singlePlayer":true,"multiplayer":false,"coop":false,"onlineCoop":false,"localCoop":false,"lanCoop":false,"sharedOrSplitScreen":false,"pvp":false,"maximumPlayers":null,"maximumPlayersNote":"The public Steam app-details response does not provide a reliable exact player limit.","evidence":["Single-player"]},"genres":["Racing","Simulation"],"categories":[{"id":2,"description":"Single-player"},{"id":62,"description":"Family Sharing"}]}},"content":{"status":"success","steamAppId":"320300","steamName":"Car Mechanic Simulator 2015","sourceUrl":"https://store.steampowered.com/app/320300/","fetchedAt":"2026-10-16T08:55:50.639883+00:00","locales":{"en":{"status":"source","provider":"steam","shortDescription":"New cars, new tools, new options, more parts and much more fun in the next version of Car Mechanic Simulator! Take your wrench! Create and expand your auto repairs service empire. Car Mechanic Simulator 2015 will take you behind the scenes of daily routine in car workshop.","detailedDescription":"New cars, new tools, new options, more parts and much more fun in the next version of Car Mechanic Simulator! Take your wrench!\nCreate and expand your auto repairs service empire. Car Mechanic Simulator 2015 will take you behind the scenes of daily routine in car workshop.\nTake on the role of the car mechanic and repair cars for your clients. Spend the earned money on expanding your workshop and improving your skills.  Buy worn out cars, renovate them and sell with profit or become a famous car collector. If you manage your business well, you will surely succeed in the market.\nCar Repairs\nThe essence of the game. It is your job. It is the way you get cash. It is the way you live... Ok, it is maybe not that important, anyway that is the basic activity in the game. Customer comes in and mysteriously says that his car is broken but he needs it for tomorrow. The clock starts right now.\nMission system\nJobs are generated randomly so you'll have to choose on which car you will work. It seems like there is a group of customers waiting in front of the workshop for the mechanic...\nAdditionally you can take limited amount of jobs in the same time and every one of them is time-restricted. With different difficulty and complexity levels and of course, different payment levels, wise management is the key here.\nWorkshop management\nAfter whole day of hard work it is time to count your cash and then look around your business. What should I buy to improve my performance? What would attract more clients? You can always just buy more posters on the wall but it is not something called 'great investment' for such a serious business, right?\nCar auctions\nSpeaking of investments.There is a chance for making even more money in the car auction house. Choose wisely, buy used or old cars and renovate them to sell with profit... Or, if you are one of those vintage car lovers, you can have your own collection.\nCar Models\nCars are fully dismountable to the car frame with amazing level of detail. Every car is made of more than 200 interactive parts, which includes  an interior, a car body and the whole engine.","aboutGame":null},"vi":{"status":"pending_translation","provider":null,"shortDescription":null,"detailedDescription":null,"aboutGame":null}},"media":{"images":[{"role":"header","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/320300/header.jpg?t=1791191750"},{"role":"capsule","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/320300/capsule_231x87.jpg?t=1791191750"}],"screenshots":[{"id":0,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/320300/ss_b424b13c44e2468ef9e1c1556767b42833b8972d.600x338.jpg?t=1791191750","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/320300/ss_b424b13c44e2468ef9e1c1556767b42833b8972d.1920x1080.jpg?t=1791191750"},{"id":1,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/320300/ss_82e01bda24762afc15e65a970b25bd01bf78baeb.600x338.jpg?t=1791191750","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/320300/ss_82e01bda24762afc15e65a970b25bd01bf78baeb.1920x1080.jpg?t=1791191750"},{"id":2,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/320300/ss_d3ee0ef58e90b9e4dc460dfdb6b364fde05b33b9.600x338.jpg?t=1791191750","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/320300/ss_d3ee0ef58e90b9e4dc460dfdb6b364fde05b33b9.1920x1080.jpg?t=1791191750"},{"id":3,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/320300/ss_523fd535f099290eb2aa243632d93646769dcbdd.600x338.jpg?t=1791191750","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/ap