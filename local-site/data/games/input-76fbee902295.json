us":"identified","verificationNotes":["The supplied name exactly matches the normalized official Steam name for the supplied App ID."],"research":{"steam":{"status":"success","checkedAt":"2026-10-15T10:53:36.693Z","error":null}},"steamMetadata":{"appId":"493340","links":{"store":"https://store.steampowered.com/app/493340/","officialWebsite":"https://www.planetcoaster.com/","support":"https://support.frontier.co.uk/kb/"},"storageRequirements":{"kind":"required_free_space","windows":{"minimum":{"value":8,"unit":"GB","display":"8 GB","approximateBytes":8000000000,"evidenceText":"Storage: 8 GB"},"recommended":{"value":8,"unit":"GB","display":"8 GB","approximateBytes":8000000000,"evidenceText":"Storage: 8 GB"}},"macos":{"minimum":{"value":15,"unit":"GB","display":"15 GB","approximateBytes":15000000000,"evidenceText":"Storage: 15 GB"},"recommended":null},"linux":{"minimum":null,"recommended":null},"note":"Steam publishes required free space, not the exact installed or download size."},"controllerSupport":{"level":"unknown","xboxCompatible":null,"xboxEvidence":null,"note":"Generic Steam controller support does not prove Xbox controller compatibility."},"playerModes":{"singlePlayer":true,"multiplayer":false,"coop":false,"onlineCoop":false,"localCoop":false,"lanCoop":false,"sharedOrSplitScreen":false,"pvp":false,"maximumPlayers":null,"maximumPlayersNote":"The public Steam app-details response does not provide a reliable exact player limit.","evidence":["Single-player"]},"genres":["Action","Adventure","Casual","Simulation","Strategy"],"categories":[{"id":2,"description":"Single-player"},{"id":22,"description":"Steam Achievements"},{"id":29,"description":"Steam Trading Cards"},{"id":30,"description":"Steam Workshop"},{"id":23,"description":"Steam Cloud"},{"id":62,"description":"Family Sharing"}]}},"content":{"status":"success","steamAppId":"493340","steamName":"Planet Coaster","sourceUrl":"https://store.steampowered.com/app/493340/","fetchedAt":"2026-10-16T09:21:48.062433+00:00","locales":{"en":{"status":"source","provider":"steam","shortDescription":"Planet Coaster® - the future of coaster park simulation games has arrived! Surprise, delight and thrill incredible crowds as you build your coaster park empire - let your imagination run wild, and share your success with the world.","detailedDescription":"Surprise, delight and thrill crowds as you build the theme park of your dreams. Build and design incredible coaster parks with unparalleled attention to detail and manage your park in a truly living world.\n\nPiece-by-Piece Construction: Planet Coaster makes a designer out of everyone. Lay paths, build scenery, customize rides and make everything in your park unique with piece-by-piece construction and over a thousand unique building components. \n\nLandscape Sculpting: Play with nature and reshape the land beneath your feet. Sculpt the landscape to raise mountains, form lakes, dig caverns and even build islands in the sky, then weave coasters through your park above ground and below.\n\nTotal Authenticity: Recreate your favorite rides or leave the real world at the door. However you love to play, the most realistic rides and most realistic reactions from your guests make Planet Coaster the most authentic simulation ever.\n\nSimulation Evolved: The deepest park simulation in gaming history rewards your skills and makes management fun. Control every aspect of your guests’ experience and watch as Planet Coaster’s world reacts to your choices in an instant.\n\nA Living World: Every park guest is an expressive individual who thinks, feels and explores your park with their own interests and desires. Together Planet Coaster’s guests will tell you at a glance just how well your park is run.\n\nPark Management: You’re the boss with accessible controls that make management fun. Test your skills in a campaign of creative scenarios, or just build for fun and tweak your parks to surprise, delight and thrill your guests. \n\nCommunal Creation: Planet Coaster links coaster fanatics and creators around the world with the Steam Workshop community hub. Trade scenery, rollercoasters and even entire parks with other players, and add the world’s wildest creations to your own park.\n\nBe Inspired: Discover new content from the world’s best coaster park creators every day. Browse and download content from your favorite creators, or choose from the latest designs selected by the Planet Coaster dev team.\n\nShare Your Creativity: Whether it’s a magnificent ice cream shop or the world’s most thrilling coaster, build it, name it and share it with the planet. Join a community of creators and see your designs appear in parks around the world.","aboutGame":null},"vi":{"status":"pending_translation","provider":null,"shortDescription":null,"detailedDescription":null,"aboutGame":null}},"media":{"images":[{"role":"header","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/493340/header.jpg?t=1782480201"},{"role":"capsule","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/493340/capsule_231x87.jpg?t=1782480201"},{"role":"description","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/493340/extras/47fb6a65ece958125eb454104dc7dba4.avif?t=1782480201","alt":""},{"role":"description","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/493340/extras/4e31bb53077db56a4c78c5290bf7697c.avif?t=1782480201","alt":""},{"role":"description","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/493340/extras/db4511e27fe5542b8d8e32174780b899.avif?t=1782480201","alt":""}],"screenshots":[{"id":0,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/493340/ss_e3661fafe7f2e701ef91528e7b803857a418f6dd.600x338.jpg?t=1782480201","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/493340/ss_e3661fafe7f2e701ef91528e7b803857a418f6dd.1920x1080.jpg?t=1782480201"},{"id":1,"thumbnailUrl":"https://shared