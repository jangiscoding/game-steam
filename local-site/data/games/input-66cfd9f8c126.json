//shared.akamai.steamstatic.com/store_item_assets/steam/apps/2418520/7cda3e37decd9cdc2823de6ee8d5da22e31f2c0d/ss_7cda3e37decd9cdc2823de6ee8d5da22e31f2c0d.1920x1080.jpg?t=1791989104"},{"id":16,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2418520/1a761e085c8cb6bc68888fda45fb6580cd9cc90b/ss_1a761e085c8cb6bc68888fda45fb6580cd9cc90b.600x338.jpg?t=1791989104","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2418520/1a761e085c8cb6bc68888fda45fb6580cd9cc90b/ss_1a761e085c8cb6bc68888fda45fb6580cd9cc90b.1920x1080.jpg?t=1791989104"},{"id":17,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2418520/55d93366f568961fd6587787be43f461214b7600/ss_55d93366f568961fd6587787be43f461214b7600.600x338.jpg?t=1791989104","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2418520/55d93366f568961fd6587787be43f461214b7600/ss_55d93366f568961fd6587787be43f461214b7600.1920x1080.jpg?t=1791989104"},{"id":18,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2418520/93b45f1f7ce5d5782d446a2706a1f3e7d1b768e5/ss_93b45f1f7ce5d5782d446a2706a1f3e7d1b768e5.600x338.jpg?t=1791989104","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2418520/93b45f1f7ce5d5782d446a2706a1f3e7d1b768e5/ss_93b45f1f7ce5d5782d446a2706a1f3e7d1b768e5.1920x1080.jpg?t=1791989104"}],"videos":[{"id":257141698,"name":"Release Trailer","thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257141698/bd493574a91159f2c25b74d3b0948c7906e13592/movie_600x337.jpg?t=1748621753","highlight":true,"sources":[{"format":"hls_h264","url":"https://video.akamai.steamstatic.com/store_trailers/2418520/1281909649/a5322f870f21365185c379550ed38805ac695762/1750814424/hls_264_master.m3u8?t=1748621753"}]}]}}}