ếm kho tàng ma thuật để nhanh chóng gia tăng sức mạnh của bạn?\nSự phổ biến về động lực Sử dụng chúng để bao quanh bạn với quái vật và chậm trễ cho đến thời điểm bạn gọn gàng kết hợp.","aboutGame":null}},"media":{"images":[{"role":"header","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2151580/header.jpg?t=1686854591"},{"role":"capsule","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2151580/capsule_231x87.jpg?t=1686854591"},{"role":"description","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2151580/extras/8e05a0a37bd3d04c427b9e2da073e2d7.avif?t=1686854591","alt":""}],"screenshots":[{"id":0,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2151580/ss_90286ed8f99098cff5e10675f0eb199c19d552a5.600x338.jpg?t=1686854591","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2151580/ss_90286ed8f99098cff5e10675f0eb199c19d552a5.1920x1080.jpg?t=1686854591"},{"id":1,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2151580/ss_92078ec81bfed66d00ed3ca61fbd63b6a9844eaf.600x338.jpg?t=1686854591","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2151580/ss_92078ec81bfed66d00ed3ca61fbd63b6a9844eaf.1920x1080.jpg?t=1686854591"},{"id":2,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2151580/ss_c199552d825017f052211f7e0d84c144e403f40e.600x338.jpg?t=1686854591","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2151580/ss_c199552d825017f052211f7e0d84c144e403f40e.1920x1080.jpg?t=1686854591"},{"id":3,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2151580/ss_f1c44db7bd4cced2ab7f2a655efcb2893339d6b5.600x338.jpg?t=1686854591","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2151580/ss_f1c44db7bd4cced2ab7f2a655efcb2893339d6b5.1920x1080.jpg?t=1686854591"},{"id":4,"thumbnailUrl":"https://s