p ID."],"research":{"steam":{"status":"success","checkedAt":"2026-10-15T09:59:28.245Z","error":null}},"steamMetadata":{"appId":"809140","links":{"store":"https://store.steampowered.com/app/809140/","officialWebsite":"http://www.lionsshade.com/cliff-empire","support":"http://www.lionsshade.com/"},"storageRequirements":{"kind":"required_free_space","windows":{"minimum":{"value":1,"unit":"GB","display":"1 GB","approximateBytes":1000000000,"evidenceText":"Storage: 1 GB"},"recommended":null},"macos":{"minimum":{"value":1,"unit":"GB","display":"1 GB","approximateBytes":1000000000,"evidenceText":"Storage: 1 GB"},"recommended":null},"linux":{"minimum":null,"recommended":null},"note":"Steam publishes required free space, not the exact installed or download size."},"controllerSupport":{"level":"unknown","xboxCompatible":null,"xboxEvidence":null,"note":"Generic Steam controller support does not prove Xbox controller compatibility."},"playerModes":{"singlePlayer":true,"multiplayer":false,"coop":false,"onlineCoop":false,"localCoop":false,"lanCoop":false,"sharedOrSplitScreen":false,"pvp":false,"maximumPlayers":null,"maximumPlayersNote":"The public Steam app-details response does not provide a reliable exact player limit.","evidence":["Single-player"]},"genres":["Indie","Simulation","Strategy"],"categories":[{"id":2,"description":"Single-player"},{"id":22,"description":"Steam Achievements"},{"id":23,"description":"Steam Cloud"},{"id":62,"description":"Family Sharing"}]}},"content":{"status":"success","steamAppId":"809140","steamName":"Cliff Empire","sourceUrl":"https://store.steampowered.com/app/809140/","fetchedAt":"2026-10-16T09:47:05.785196+00:00","locales":{"en":{"status":"source","provider":"steam","shortDescription":"After a nuclear war life on the surface became impossible. A 300m thick radioactive fog covered the Earth. We are looking for bold active people to manage the process of restoring life on Earth. Join!","detailedDescription":"Message for survivors on the Earth's orbit!\n\r\n\n\r\nAfter a nuclear war life on the surface became impossible, and a 300m thick radioactive fog covered the Earth.\n\r\nOur scientists in the past decade predicted such course of events and used all available potential to build cliffs in the mountain region to restore life on Earth.\n\r\n\n\r\nWe are looking for bold active people to manage the process of restoring life on Earth. Join!\n\r\n\n\r\n- develop in parallel the economics of several independent cities\n\r\n- trade between your cities and the orbital station\n\r\n- a dynamic climate change that will test the strength of your cities' economies.\n\r\n- choose between ecological and harmful power supply\n\r\n- 48 additional university research to improve the city structure\n\r\n- over 120 structures for constructing the city\n\r\n- 15 goods for trade and consumption\n\r\n- possibility of switching between the 3D and the orthographic camera, as well as a free camera for walking around the city.\n\r\n- additional 15 quests that open access to the orbital station and huge location in Late game\n\r\n- sandbox mode\n\r\n- tower defense more\n\r\n\n\r\nThe compact gameplay involves the construction of three small cities in each randomly generated level.","aboutGame":null},"vi":{"status":"translated","provider":"argos-translate-en_vi-1.9-ctranslate2-int8","translatedAt":"2026-10-16T13:26:14.153609+00:00","sourceHash":"ae3d1557ecb9ca0c8276855fa5e3bcdc640b3d0d2e841a5c62eb39460803537e","reviewStatus":"machine_translation_unreviewed","shortDescription":"Sau một cuộc chiến tranh hạch tâm trên bề mặt trở nên bất khả thi. Một đám sương mù phóng xạ dày 300m bao phủ Trái đất. Chúng ta đang tìm kiếm những con người mạnh mẽ để quản lý quá trình khôi phục sự sống trên Trái Đất. Tham gia!","detailedDescription":"Thông điệp cho những người sống sót trên quỹ đạo Trái Đất!\n\n\nSau một cuộc sống chiến tranh hạt nhân trên bề mặt trở nên không thể thực hiện được, và một đám sương mù phóng xạ dày 300m bao phủ Trái đất.\nCác nhà khoa học của chúng ta trong thập kỷ qua đã tiên đoán về những sự kiện như thế và sử dụng tất cả tiềm năng có thể xây dựng những vách đá trong vùng núi để khôi phục sự sống trên Trái Đất.\n\n\nChúng ta đang tìm kiếm những con người mạnh mẽ để quản lý quá trình khôi phục sự sống trên Trái Đất. Vào đi!\n\n\n- phát triển song song kinh tế của một số thành phố độc lập\n- buôn bán giữa các thành phố của bạn và trạm quỹ đạo\n- một sự thay đổi khí hậu sôi nổi sẽ thử thách sức mạnh của nền kinh tế của thành phố.\n- lựa chọn giữa hệ sinh thái và nguồn cung cấp năng lượng có hại\n- 48 nghiên cứu thêm đại học để cải thiện cấu trúc thành phố\n- hơn 120 công trình để xây dựng thành phố\n- 15 mặt hàng để buôn bán và tiêu dùng\n- khả năng chuyển giữa 3D và máy ảnh địa lý, cũng như máy quay miễn phí để đi vòng quanh thành phố.\n- Thêm 15 nhiệm vụ mở truy cập đến các trạm quỹ đạo và vị trí lớn trong cuối trò chơi\n- Chế độ hộp cát\n- Tháp canh phòng thủ nữa.\n\n\nTrò chơi kết hợp liên quan đến việc xây dựng ba thành phố nhỏ ở mỗi cấp độ ngẫu nhiên.","aboutGame":null}},"media":{"images":[{"role":"header","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/809140/header.jpg?t=1730412886"},{"role":"capsule","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/809140/capsule_231x87.jpg?t=1730412886"}],"screenshots":[{"id":0,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/809140/ss_a6fc24da563ba204ffff34e7ca8750653d39a86d.600x338.jpg?t=1730412886","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/809140/ss_a6fc24da563ba204ffff34e7ca8750653d39a86d.1920x1080.jpg?t=1730412886"},{"id":1,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/809140/ss_f05b10388d99437aa15532035304c015a3842a3c.600x338.jpg?t=1730412886","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/809140/ss_f05b10388d99437aa15532035304c015a3842a3c.1920x1080.jpg?t=173