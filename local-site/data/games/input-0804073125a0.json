:20,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/204360/ss_ae7bc7e9add49529a9b8cb59f5726b3212ea3d8b.600x338.jpg?t=1764096331","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/204360/ss_ae7bc7e9add49529a9b8cb59f5726b3212ea3d8b.1920x1080.jpg?t=1764096331"},{"id":21,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/204360/ss_80d21a71beff94dadda45e23e250f58dd41c83f7.600x338.jpg?t=1764096331","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/204360/ss_80d21a71beff94dadda45e23e250f58dd41c83f7.1920x1080.jpg?t=1764096331"},{"id":22,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/204360/ss_aad8c860e191e2607665097f14c78a8a4b91386a.600x338.jpg?t=1764096331","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/204360/ss_aad8c860e191e2607665097f14c78a8a4b91386a.1920x1080.jpg?t=1764096331"}],"videos":[{"id":257179314,"name":"Painter Boss Paradise DLC Trailer","thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257179314/38266984a973303d8ef6b0e470246bc639132310/movie_600x337.jpg?t=1754506159","highlight":true,"sources":[{"format":"hls_h264","url":"https://video.akamai.steamstatic.com/store_trailers/204360/1648240310/809498fccda76a215d0e69e4804aecf170c40a94/1754504266/hls_264_master.m3u8?t=1754506159"}]},{"id":256657279,"name":"Castle Crashers Trailer!","thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/256657279/movie.293x165.jpg?t=1447378482","highlight":true,"sources":[{"format":"hls_h264","url":"https://video.akamai.steamstatic.com/store_trailers/204360/44735/efda3648a0ec609d07f726515357db9cc30fe64d/1750492799/hls_264_master.m3u8?t=1447378482"}]}]}}}