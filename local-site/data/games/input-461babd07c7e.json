pp ID."],"research":{"steam":{"status":"success","checkedAt":"2026-10-15T10:38:26.348Z","error":null}},"steamMetadata":{"appId":"1903620","links":{"store":"https://store.steampowered.com/app/1903620/","officialWebsite":"https://www.killerfrequency.game/","support":null},"storageRequirements":{"kind":"required_free_space","windows":{"minimum":{"value":2,"unit":"GB","display":"2 GB","approximateBytes":2000000000,"evidenceText":"Storage: 2 GB"},"recommended":{"value":2,"unit":"GB","display":"2 GB","approximateBytes":2000000000,"evidenceText":"Storage: 2 GB"}},"macos":{"minimum":null,"recommended":null},"linux":{"minimum":null,"recommended":null},"note":"Steam publishes required free space, not the exact installed or download size."},"controllerSupport":{"level":"full","xboxCompatible":null,"xboxEvidence":null,"note":"Generic Steam controller support does not prove Xbox controller compatibility."},"playerModes":{"singlePlayer":true,"multiplayer":false,"coop":false,"onlineCoop":false,"localCoop":false,"lanCoop":false,"sharedOrSplitScreen":false,"pvp":false,"maximumPlayers":null,"maximumPlayersNote":"The public Steam app-details response does not provide a reliable exact player limit.","evidence":["Single-player"]},"genres":["Adventure","Indie","Simulation"],"categories":[{"id":2,"description":"Single-player"},{"id":22,"description":"Steam Achievements"},{"id":28,"description":"Full controller support"},{"id":23,"description":"Steam Cloud"},{"id":62,"description":"Family Sharing"}]}},"content":{"status":"success","steamAppId":"1903620","steamName":"Killer Frequency","sourceUrl":"https://store.steampowered.com/app/1903620/","fetchedAt":"2026-10-16T08:19:02.113427+00:00","locales":{"en":{"status":"source","provider":"steam","shortDescription":"Killer Frequency is a first-person horror puzzle game set in 1987, that puts you in the role of a late-night radio talk show host in small town America whose callers are being stalked by a mysterious killer.","detailedDescription":"The year is 1987, and as the clock strikes midnight in small-town Gallows Creek, USA, former big city radio DJ Forrest Nash is live on air in what will turn out to be the graveyard shift of a lifetime...\n\nIn this horror comedy, you must solve puzzles to save callers from being hunted down by a mysterious killer. Where every call is life and death, can you save the inhabitants of Gallows Creek?\n\nUnique 1st person narrative:\n\nStep into the shoes of a late-night radio talk-show host – new in town and fallen from grace. The Police Chief is dead… so the townsfolk turn to you for help, as apparently you, Forest Nash are the only person in town who can run a phone line.\n\nReal-time decisions and puzzle solving:\n\nUse branching dialogues to interact with a variety of eccentric small-town personalities including potential victims and suspects. Explore your surroundings, gather clues, make decisions, solve satisfying riddles, and try to help each of your callers survive the night.\n\nRetro Slasher setting:\n\nJump back in time to 1987 with this slasher inspired puzzler – explore an authentically detailed radio station and interact with dozens of physics-based objects straight from a bygone era, including a working cassette and record player. With a fully voiced cast and a killer original soundtrack of 80's inspired tunes from rock classics to synthwave!","aboutGame":null},"vi":{"status":"translated","provider":"argos-translate-en_vi-1.9-ctranslate2-int8","translatedAt":"2026-10-16T12:18:19.547134+00:00","sourceHash":"16092ecee5ce6f74be8c9abb8e47fff6f73da35017c7dc31dbb62529b06b0903","reviewStatus":"machine_translation_unreviewed","shortDescription":"Tần số sát nhân là một trò chơi trí tuệ kinh dị người đầu tiên vào năm 1987, đặt bạn vào vai trò của một chương trình phát thanh buổi tối ở một thị trấn nhỏ ở Mỹ những người gọi đang bị theo dõi bởi một sát thủ bí ẩn.","detailedDescription":"Năm 1987, đồng hồ điểm giữa đêm ở phố Gallows Creek, Hoa Kỳ, cựu thành phố phát thanh DJ Nash đang truyền hình trực tiếp.\nTrong vở kịch kinh dị này, anh phải giải câu đố để cứu những người gọi khỏi bị săn đuổi bởi một kẻ giết người bí ẩn. Nơi mà mọi cuộc gọi là cuộc sống và cái chết, anh có thể cứu cư dân Gallows Creek không?\nCâu chuyện độc nhất 1 người:\nHãy bước vào giày của một người chủ buổi nói chuyện radio đêm muộn - mới tới thị trấn và rơi xuống từ ân sủng. Cảnh sát trưởng đã chết... nên những người dân thị trấn nhờ anh giúp, cũng như anh, Forest Nash là người duy nhất trong thị trấn có thể chạy điện thoại.\nCác quyết định thời gian thực và giải câu đố:\nSử dụng các cuộc đối thoại chi nhánh để tương tác với rất nhiều tính cách lập dị của thị trấn nhỏ bao gồm các nạn nhân tiềm năng và nghi phạm. Khám phá xung quanh, thu thập manh mối, đưa ra quyết định, giải quyết những câu đố thỏa đáng, và cố gắng giúp từng người gọi sống sót qua đêm.\nThiết lập bộ phóng to:\nTrở lại năm 1987 với máy cắt này lấy cảm hứng từ máy giải đố để khám phá một đài phát thanh chi tiết và tương tác với hàng chục vật lý-vật lý trực tiếp từ thời xa xưa, bao gồm một máy quay băng và máy quay đĩa ghi âm hoạt động. Với một giọng nói đầy đủ và một âm thanh nguyên thủy của 80 giai điệu được truyền cảm hứng từ nhạc cổ điển đến sóng tổng hợp!","aboutGame":null}},"media":{"images":[{"role":"header","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1903620/header.jpg?t=1785401715"},{"role":"capsule","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1903620/capsule_231x87.jpg?t=1785401715"}],"screenshots":[{"id":0,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1903620/ss_6ef64f3bdcfd63b79340b7705fd7ece44975bb85.600x338.jpg?t=1785401715","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1903620/ss_6ef64f3bdcfd63b79340b7705fd7ece44975bb85.1920x1080.jpg?t=1785401715"},{"id":1,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1903620/ss_c298f578