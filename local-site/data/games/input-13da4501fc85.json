h":{"steam":{"status":"success","checkedAt":"2026-10-15T10:48:05.112Z","error":null}},"steamMetadata":{"appId":"628950","links":{"store":"https://store.steampowered.com/app/628950/","officialWebsite":"https://tongucbodur.myportfolio.com/nephise-begins","support":null},"storageRequirements":{"kind":"required_free_space","windows":{"minimum":{"value":3,"unit":"GB","display":"3 GB","approximateBytes":3000000000,"evidenceText":"Storage: 3 GB"},"recommended":{"value":3,"unit":"GB","display":"3 GB","approximateBytes":3000000000,"evidenceText":"Storage: 3 GB"}},"macos":{"minimum":null,"recommended":null},"linux":{"minimum":null,"recommended":null},"note":"Steam publishes required free space, not the exact installed or download size."},"controllerSupport":{"level":"partial","xboxCompatible":null,"xboxEvidence":null,"note":"Generic Steam controller support does not prove Xbox controller compatibility."},"playerModes":{"singlePlayer":true,"multiplayer":false,"coop":false,"onlineCoop":false,"localCoop":false,"lanCoop":false,"sharedOrSplitScreen":false,"pvp":false,"maximumPlayers":null,"maximumPlayersNote":"The public Steam app-details response does not provide a reliable exact player limit.","evidence":["Single-player"]},"genres":["Adventure","Casual","Indie"],"categories":[{"id":2,"description":"Single-player"},{"id":22,"description":"Steam Achievements"},{"id":29,"description":"Steam Trading Cards"},{"id":18,"description":"Partial Controller Support"},{"id":62,"description":"Family Sharing"}]}},"content":{"status":"success","steamAppId":"628950","steamName":"Nephise Begins","sourceUrl":"https://store.steampowered.com/app/628950/","fetchedAt":"2026-10-16T09:34:05.883465+00:00","locales":{"en":{"status":"source","provider":"steam","shortDescription":"Nephise Begins tells the player what happened at the time before Nephise was an orb collector. The main setting is forest again, but this time without snow, instead a more sunny and foggy weather.","detailedDescription":"Nephise Begins tells the player what happened at the time before Nephise was an orb collector. The main setting is forest again, but this time without snow, instead a more sunny and foggy weather. And there are more hills to climb.\n\r\nIt is a short and atmospheric puzzle game with narration.\n\r\n\n\r\nThe gameplay and puzzle system is similar to the original Nephise. There are animal skulls that you have to gather and then use on tall amphoras. You will be able to toggle the visibility of the HUD which will show you which animal skull and how many mushrooms you have gathered.\n\r\n\n\r\nThe music and atmosphere is relaxing like the original game. And the voice actor will be an elder one who will be narrating like telling the player a story.\n\r\n\n\r\nPS: The core aspect of this game is the atmosphere. It is recommended for those who mostly seek to experience the mood.","aboutGame":null},"vi":{"status":"translated","provider":"argos-translate-en_vi-1.9-ctranslate2-int8","translatedAt":"2026-10-16T13:16:52.556696+00:00","sourceHash":"2f7a10b71c1822983084bab935ead92639e444ddc94a59fb6310c993dad09be2","reviewStatus":"machine_translation_unreviewed","shortDescription":"Nephise bắt đầu kể cho người chơi nghe chuyện xảy ra vào thời điểm trước khi Nephise trở thành một nhà sưu tập quả cầu. Thiết lập chính là rừng lần nữa, nhưng lần này không có tuyết, thay vào đó là một thời tiết nắng và sương mù hơn.","detailedDescription":"Nephise bắt đầu kể cho người chơi nghe chuyện xảy ra vào thời điểm trước khi Nephise trở thành một nhà sưu tập quả cầu. Thiết lập chính là rừng lần nữa, nhưng lần này không có tuyết, thay vào đó là một thời tiết nắng và sương mù hơn. Và có nhiều đồi để leo.\nĐó là một trò chơi giải đố ngắn và không khí với những câu chuyện kể.\n\n\nHệ thống chơi trò chơi và câu đố tương tự như hệ thống Nephise gốc. Có những hộp sọ động vật mà bạn phải thu thập và sau đó sử dụng trên bình cổ. Bạn sẽ có thể bật lại tầm nhìn của HUD mà sẽ cho bạn thấy đầu lâu của động vật và bao nhiêu nấm bạn đã thu thập.\n\n\nÂm nhạc và bầu không khí đang thư giãn như trò chơi ban đầu. Và diễn viên giọng nói sẽ là một người lớn tuổi sẽ kể chuyện như là kể cho người chơi nghe một câu chuyện.\n\n\nKhía cạnh cốt lõi của trò chơi này là khí quyển. Điều này khuyến khích những ai muốn trải nghiệm tâm trạng đó.","aboutGame":null}},"media":{"images":[{"role":"header","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/628950/header.jpg?t=1728894630"},{"role":"capsule","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/628950/d09b9cb4a2ebbb5374561540a150ebabe4ae4e82/capsule_231x87.jpg?t=1728894630"}],"screenshots":[{"id":0,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/628950/ss_83242a8095e79cf7dba2d0b86be69a0bb2fe7690.600x338.jpg?t=1728894630","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/628950/ss_83242a8095e79cf7dba2d0b86be69a0bb2fe7690.1920x1080.jpg?t=1728894630"},{"id":1,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/628950/ss_09b916a5c6af7370d5670e66d7de8e7a1102f230.600x338.jpg?t=1728894630","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/628950/ss_09b916a5c6af7370d5670e66d7de8e7a1102f230.1920x1080.jpg?t=1728894630"},{"id":2,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/628950/ss_1a91e51408af90558a078ba2eed3af4d0bd813ce.600x338.jpg?t=1728894630","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/628950/ss_1a91e51408af90558a078ba2eed3af4d0bd813ce.1920x1080.jpg?t=1728894630"},{"id":3,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/628950/ss_6752fee49572d2f076c435a36afc7c3356cbe1b0.600x338.jpg?t=1728894630","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/628950/ss_6752fee49572d2f076c435a36afc7c3356cbe1b0.1920x1080.jpg?t=1728894630"},{"id":4,"thumbnailUrl":"https://shared.aka