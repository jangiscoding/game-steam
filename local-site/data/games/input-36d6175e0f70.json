{"id":"input-36d6175e0f70","steamAppId":"2236300","name":"Grand Emprise: Time Travel Survival","imageUrl":"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/2236300/library_600x900.jpg","imageStatus":"downloaded","steamUrl":"https://store.steampowered.com/app/2236300/","genres":["Action","Adventure","Casual","Indie","RPG","Simulation"],"platforms":["windows"],"controllerSupport":"unknown","playerModes":{"singlePlayer":true,"multiplayer":false,"coop":false,"localCoop":false,"sharedOrSplitScreen":false,"onlineCoop":false,"maximumPlayers":null},"storage":{"windowsMinimumGB":40.0,"windowsMinimumDisplay":"40 GB"},"verificationStatus":"identified","custom":{},"sourceProfile":{"inputRecordId":"input-36d6175e0f70","canonicalId":"steam-app-2236300","suppliedName":"Grand Emprise: Time Travel Survival","suppliedImageUrl":"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/2236300/library_600x900.jpg","officialName":"Grand Emprise: Time Travel Survival","aliases":[],"series":null,"franchise":null,"productType":"game","editionName":null,"originalReleaseYear":null,"identifiedVersionReleaseYear":2023,"developers":["Tbjbu2"],"publishers":["Tbjbu2"],"platforms":["windows"],"genres":["Action","Adventure","Casual","Indie","RPG","Simulation"],"shortDescription":"TIME TRAVEL through history to BECOME GOD 🚀 Ride dinosaurs, forge tools, sail dunes, build a colony, siege castles, automate and fly, mine underground, launch to the moon, build a dyson sphere! An insane, unforgettable and revolutionary survival crafting base building open world adventure.","confusingWith":[],"candidateIdentifiers":{"steamAppId":"2236300"},"sources":[{"label":"Steam Store","url":"https://store.steampowered.com/app/2236300/","accessedAt":"2026-10-15T10:30:46.432Z","supports":["officialName","productType","identifiedVersionReleaseYear","developers","publishers","platforms","genres","shortDescription","steamMetadata.links","steamMetadata.storageRequirements","steamMetadata.controll