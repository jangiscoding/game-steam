ied","verificationNotes":["The supplied name exactly matches the normalized official Steam name for the supplied App ID."],"research":{"steam":{"status":"success","checkedAt":"2026-10-15T10:52:44.093Z","error":null}},"steamMetadata":{"appId":"3527290","links":{"store":"https://store.steampowered.com/app/3527290/","officialWebsite":"http://peakpeakpeak.com/","support":"http://discord.gg/peakgame"},"storageRequirements":{"kind":"required_free_space","windows":{"minimum":{"value":4,"unit":"GB","display":"4 GB","approximateBytes":4000000000,"evidenceText":"Storage: 4 GB"},"recommended":{"value":6,"unit":"GB","display":"6 GB","approximateBytes":6000000000,"evidenceText":"Storage: 6 GB"}},"macos":{"minimum":null,"recommended":null},"linux":{"minimum":null,"recommended":null},"note":"Steam publishes required free space, not the exact installed or download size."},"controllerSupport":{"level":"full","xboxCompatible":null,"xboxEvidence":null,"note":"Generic Steam controller support does not prove Xbox controller compatibility."},"playerModes":{"singlePlayer":true,"multiplayer":true,"coop":true,"onlineCoop":true,"localCoop":false,"lanCoop":false,"sharedOrSplitScreen":false,"pvp":false,"maximumPlayers":null,"maximumPlayersNote":"The public Steam app-details response does not provide a reliable exact player limit.","evidence":["Single-player","Multi-player","Co-op","Online Co-op"]},"genres":["Action","Adventure","Indie"],"categories":[{"id":2,"description":"Single-player"},{"id":1,"description":"Multi-player"},{"id":9,"description":"Co-op"},{"id":38,"description":"Online Co-op"},{"id":22,"description":"Steam Achievements"},{"id":28,"description":"Full controller support"},{"id":29,"description":"Steam Trading Cards"},{"id":55,"description":"DualShock Controller Support"},{"id":56,"description":"DualShock Controller Support"},{"id":57,"description":"DualSense Controller Support"},{"id":58,"description":"DualSense Controller Support"},{"id":62,"description":"Family Sharing"}]}},"content":{"status":"success","steamAppId":"3527290","steamName":"PEAK","sourceUrl":"https://store.steampowered.com/app/3527290/","fetchedAt":"2026-10-16T09:02:56.081278+00:00","locales":{"en":{"status":"source","provider":"steam","shortDescription":"PEAK is a co-op climbing game where the slightest mistake can spell your doom. Either solo or as a group of lost nature scouts, your only hope of rescue from a mysterious island is to scale the mountain at its center. Do you have what it takes to reach the PEAK?","detailedDescription":"PEAK is a co-op climbing game where the slightest mistake can spell your doom. Either solo or as a group of lost nature scouts, your only hope of rescue from a mysterious island is to scale the mountain at its center. Do you have what it takes to reach the PEAK?\n\nWORK TOGETHER\n\nNeed a Hand? You’ll need to rely on your friends to have any hope of scaling the mountain, which changes every single day. Help each other up ledges, or place ropes and climbing spikes to make the way easier for those who come after.\n\nCLIMB\n\nThe Mountain Takes no Prisoners! Climb through 4 biomes on your way to the PEAK, each with their own life-threatening obstacles. You’ll need to scavenge for questionable food to survive, and manage your injuries carefully - every setback limits your stamina, making it harder to climb.\n\nSURVIVE\n\nPrepare For the Worst: Discover a variety of helpful survival items, from energy drinks to climbing spikes to the mysterious Anti-Rope. You’ve got no hope of making it to the PEAK unless you press every advantage given to you.\n\nA NEW ISLAND EACH DAY\n\nThe game's map rotates out every 24 hours! Try out the new layout each day, or give the same island multiple attempts in a day until you conquer it.\n\nEARN BADGES\n\nA Well-Seasoned Scout: Show off your survival prowess with dozens of badges to earn and cosmetics to unlock.\n\nCLIMBING IS BETTER WITH FRIENDS\n\nMultiplayer in PEAK is friends-only - invite up to three other scouts through Steam to climb together, or face the mountain alone if you're really brave!\n\nFEATURES\n\n• \nClimb with a total of 4 friends\n\n• \nCommunicate through proximity chat \n\n• \n4 different biomes to ascend through\n\n• \nA bunch of questionable foods\n\n• \nLots of different climbing items\n\n• \nCampfires and marshmallows\n\n• \nCharacter customization\n\n• \nOnline co-op and offline single player\n\n• \nGhosts","aboutGame":null},"vi":{"status":"pending_translation","provider":null,"shortDescription":null,"detailedDescription":null,"aboutGame":null}},"media":{"images":[{"role":"header","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3527290/31bac6b2eccf09b368f5e95ce510bae2baf3cfcd/header.jpg?t=1790591892"},{"role":"capsule","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3527290/1844964d7a353e50eb3cc979ea922729d8c1b0ad/capsule_231x87.jpg?t=1790591892"}],"screenshots":[{"id":0,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3527290/aa39b41b105aac51f2312a92979a3b9cb9909a46/ss_aa39b41b105aac51f2312a92979a3b9cb9909a46.600x338.jpg?t=1790591892","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3527290/aa39b41b105aac51f2312a92979a3b9cb9909a46/ss_aa39b41b105aac51f2312a92979a3b9cb9909a46.1920x1080.jpg?t=1790591892"},{"id":1,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3527290/9c500124c060f162f111afa679bf5d3a32b3fb40/ss_9c500124c060f162f111afa679bf5d3a32b3fb40.600x338.jpg?t=1790591892","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3527290/9c500124c060f162f111afa679bf5d3a32b3fb40/ss_9c500124c060f162f111afa679bf5d3a32b3fb40.1920x1080.jpg?t=1790591892"},{"id":2,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3527290/bac7b90dffb456afecc4517a3e1d69362b95d15b/ss_bac7b90dffb456afecc4517a3e1d69362b95d15b.600x338.jpg?t=1790591892","url":"https://shared.akamai.st