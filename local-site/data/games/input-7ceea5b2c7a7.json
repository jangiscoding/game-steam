tes":["The supplied name exactly matches the normalized official Steam name for the supplied App ID."],"research":{"steam":{"status":"success","checkedAt":"2026-10-15T11:03:57.322Z","error":null}},"steamMetadata":{"appId":"2348610","links":{"store":"https://store.steampowered.com/app/2348610/","officialWebsite":null,"support":null},"storageRequirements":{"kind":"required_free_space","windows":{"minimum":{"value":1,"unit":"GB","display":"1 GB","approximateBytes":1000000000,"evidenceText":"Storage: 1 GB"},"recommended":null},"macos":{"minimum":{"value":1,"unit":"GB","display":"1 GB","approximateBytes":1000000000,"evidenceText":"Storage: 1 GB"},"recommended":null},"linux":{"minimum":{"value":1,"unit":"GB","display":"1 GB","approximateBytes":1000000000,"evidenceText":"Storage: 1 GB"},"recommended":null},"note":"Steam publishes required free space, not the exact installed or download size."},"controllerSupport":{"level":"full","xboxCompatible":null,"xboxEvidence":null,"note":"Generic Steam controller support does not prove Xbox controller compatibility."},"playerModes":{"singlePlayer":true,"multiplayer":false,"coop":false,"onlineCoop":false,"localCoop":false,"lanCoop":false,"sharedOrSplitScreen":false,"pvp":false,"maximumPlayers":null,"maximumPlayersNote":"The public Steam app-details response does not provide a reliable exact player limit.","evidence":["Single-player"]},"genres":["Action","Indie","RPG"],"categories":[{"id":2,"description":"Single-player"},{"id":22,"description":"Steam Achievements"},{"id":28,"description":"Full controller support"},{"id":55,"description":"DualShock Controller Support"},{"id":56,"description":"DualShock Controller Support"},{"id":57,"description":"DualSense Controller Support"},{"id":58,"description":"DualSense Controller Support"},{"id":23,"description":"Steam Cloud"},{"id":62,"description":"Family Sharing"}]}},"content":{"status":"success","steamAppId":"2348610","steamName":"Slime 3K: Rise Against Despot","sourceUrl":"https://store.steampowered.com/app/2348610/","fetchedAt":"2026-10-16T08:34:24.830762+00:00","locales":{"en":{"status":"source","provider":"steam","shortDescription":"Welcome to Slime 3K, an unhinged roguelite bullet-heaven set in the Despot’s Game universe! Build a deck of crazy weapons, grow stronger and devour hordes of pink puny humans as a murderous jelly blob on a warpath of death, violence and pretzels.","detailedDescription":"Roadmap\n\nAbout the Game\n\nA blob of goo used to create artificial humans has become sentient and risen up against its creator — the Despot, an evil AI and (unfortunately) ruler of the world in the year 3000! Become this murderous jelly and pave your path with death, violence and pretzels in this action-packed roguelite from the creators of Despot's Game and Despotism 3K. We tried to blatantly clone games like Vampire Survivors, Halls of Torment, Brotato, Soulstone Survivors and 20 Minutes Till Dawn, but our crazy experiments went too far. By introducing a shop straight out of AutoChess and some TCG deckbuilding mechanics to the familiar formula, we created what we've dubbed our perfect abomination: Slime 3K.\n\nDECKBUILDING MEETS MEATGRINDING\n\nSlime 3K adds strategic depth and more creative experimentation to the survivor-like formula by introducing a deep deckbuilding system. Unlock, upgrade, mix and match your cards to stock up an impressive arsenal of zany weapons and traits. Create the perfect bloodbath loadout for each run! \n\nSURVIVE THE ONSLAUGHT\n\nYour enemies get stronger every minute, and so should you! Explore tons of fun approaches to good ol' annihilation — electrocute everyone, throw acid on the floor, mow down puny humans with an AK-47, summon zombies, or throw explosive watermelons!\n\nGOTTA BLOB 'EM ALL\n\nGet ready to take on every creation the mad Despot can come up with: knights, mutants, cyborg abominations, ballerinas, stilt acrobats, carnivorous tomatoes, and Despot knows what else. The tiny pink humans make such a satisfying pop when you crush them!","aboutGame":"A blob of goo used to create artificial humans has become sentient and risen up against its creator — the Despot, an evil AI and (unfortunately) ruler of the world in the year 3000! Become this murderous jelly and pave your path with death, violence and pretzels in this action-packed roguelite from the creators of Despot's Game and Despotism 3K. We tried to blatantly clone games like Vampire Survivors, Halls of Torment, Brotato, Soulstone Survivors and 20 Minutes Till Dawn, but our crazy experiments went too far. By introducing a shop straight out of AutoChess and some TCG deckbuilding mechanics to the familiar formula, we created what we've dubbed our perfect abomination: Slime 3K.\n\nDECKBUILDING MEETS MEATGRINDING\n\nSlime 3K adds strategic depth and more creative experimentation to the survivor-like formula by introducing a deep deckbuilding system. Unlock, upgrade, mix and match your cards to stock up an impressive arsenal of zany weapons and traits. Create the perfect bloodbath loadout for each run! \n\nSURVIVE THE ONSLAUGHT\n\nYour enemies get stronger every minute, and so should you! Explore tons of fun approaches to good ol' annihilation — electrocute everyone, throw acid on the floor, mow down puny humans with an AK-47, summon zombies, or throw explosive watermelons!\n\nGOTTA BLOB 'EM ALL\n\nGet ready to take on every creation the mad Despot can come up with: knights, mutants, cyborg abominations, ballerinas, stilt acrobats, carnivorous tomatoes, and Despot knows what else. The tiny pink humans make such a satisfying pop when you crush them!"},"vi":{"status":"pending_translation","provider":null,"shortDescription":null,"detailedDescription":null,"aboutGame":null}},"media":{"images":[{"role":"header","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2348610/header.jpg?t=1781544012"},{"role":"capsule","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2348610/capsule_231x