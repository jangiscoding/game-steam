ort","steamMetadata.playerModes"]}],"confidence":"high","status":"identified","verificationNotes":["The supplied name exactly matches the normalized official Steam name for the supplied App ID."],"research":{"steam":{"status":"success","checkedAt":"2026-10-15T09:59:41.314Z","error":null}},"steamMetadata":{"appId":"3238670","links":{"store":"https://store.steampowered.com/app/3238670/","officialWebsite":null,"support":null},"storageRequirements":{"kind":"required_free_space","windows":{"minimum":{"value":8,"unit":"GB","display":"8 GB","approximateBytes":8000000000,"evidenceText":"Storage: 8 GB"},"recommended":{"value":8,"unit":"GB","display":"8 GB","approximateBytes":8000000000,"evidenceText":"Storage: 8 GB"}},"macos":{"minimum":null,"recommended":null},"linux":{"minimum":null,"recommended":null},"note":"Steam publishes required free space, not the exact installed or download size."},"controllerSupport":{"level":"full","xboxCompatible":null,"xboxEvidence":null,"note":"Generic Steam controller support does not prove Xbox controller compatibility."},"playerModes":{"singlePlayer":true,"multiplayer":false,"coop":false,"onlineCoop":false,"localCoop":false,"lanCoop":false,"sharedOrSplitScreen":false,"pvp":false,"maximumPlayers":null,"maximumPlayersNote":"The public Steam app-details response does not provide a reliable exact player limit.","evidence":["Single-player"]},"genres":["Action","Indie","RPG","Early Access"],"categories":[{"id":2,"description":"Single-player"},{"id":28,"description":"Full controller support"},{"id":55,"description":"DualShock Controller Support"},{"id":56,"description":"DualShock Controller Support"},{"id":57,"description":"DualSense Controller Support"},{"id":58,"description":"DualSense Controller Support"},{"id":23,"description":"Steam Cloud"},{"id":62,"description":"Family Sharing"}]}},"content":{"status":"success","steamAppId":"3238670","steamName":"Conquest Dark","sourceUrl":"https://store.steampowered.com/app/3238670/","fetchedAt":"2026-10-16T08:56:35.446280+00:00","locales":{"en":{"status":"source","provider":"steam","shortDescription":"Experience an ARPG's rapid ascension to power in minutes, packed with savage, survivors-like action and devastating sword & sorcery combat. Perfect your builds through Dark Ritual runs that will decide humanity's future as you battle endless hordes across haunting ruins and cursed kingdoms.","detailedDescription":"237 years after the Black Planet's arrival, humanity stands on the brink of annihilation. The undead armies have laid waste to the kingdoms of mankind, the Cosmic Gods have fallen, and the Primordial Ones have awakened from their ancient slumber. Now, champions and criminals alike perform Dark Rituals to face the very forces that brought civilization to its knees.\n\nMASTER THE DARK RITUALS \n\nVenture into haunting environments where cosmic horror meets primal savagery. Choose your path from legendary classes like the untamed Barbarians of the Lion, the divine Oathkeepers, or the mysterious Acolytes of Kuu, each mastering unique powers against the darkness.\n\nINSTANT ACTION RPG GRATIFICATION \n\nUnlock your power fantasy through intense Ritual runs. Begin as a feeble grunt and discover devastating builds as you progress. Every Ritual delivers the satisfying progression curve of an ARPG in concentrated form, each run bringing you closer to legend status.\n\nFORGE GODSLAYING BUILDS \n\nDiscover eldritch abilities, equip legendary armor, and wield unique weapons from fallen champions. Enhance your arsenal and craft builds worthy of slaying gods. Theory-craft your way to godhood with deep customization and endless possibilities.\n\nCONQUER THE DARKNESS \n\nBattle through diverse environments filled with unique challenges and fearsome mini-bosses. Face deadly creatures, undead armies, and fallen heroes in your quest to uncover the secrets of The Black Planet.\n\nSAVAGE SWORD & SORCERY\n\nExperience a brutal realm of sword & sorcery inspired by the greatest dark fantasy classics of old. Ancient powers and cosmic horrors lurk in every cursed ruin and fallen kingdom.","aboutGame":null},"vi":{"status":"translated","provider":"argos-translate-en_vi-1.9-ctranslate2-int8","translatedAt":"2026-10-16T12:48:28.448277+00:00","sourceHash":"98324d36bbf2df3e1ee18d2566132a197faf945424d1b8ae4b0f7a7689231e02","reviewStatus":"machine_translation_unreviewed","shortDescription":"Kinh nghiệm của một ARPG nhanh chóng lên nắm quyền chỉ trong vài phút, với đầy những hành động man rợ, như người sống sót và tàn phá cuộc chiến kiếm và ma thuật. Hoàn hảo cho những công trình xây dựng của ngươi thông qua những cuộc chạy đua của Pháp luật Hắc ám sẽ quyết định tương lai của nhân loại khi ngươi chiến đấu với những đạo quân bất tận xuyên xuyên qua những tàn tích ám ảnh và những vương quốc bị nguyền rủa.","detailedDescription":"277 năm sau khi hành tinh đen xuất hiện, nhân loại đang đứng trên bờ vực hủy diệt. Quân đội xác sống đã tàn phá các vương quốc của nhân loại, các vị thần vũ trụ đã sụp đổ, và những người nguyên thủy đã thức dậy từ giấc ngủ cổ xưa của họ. Bây giờ, những nhà vô địch và tội phạm đều thực hiện nghi lễ Hắc ám để đối mặt với những thế lực đã khiến nền văn minh phải quỳ gối.\nNHỮNG LỜI HỌC ĐƯỢC\nVấp bênh trong môi trường ám ảnh nơi sự kinh hoàng của vũ trụ gặp phải sự man rợ ban đầu. Hãy chọn con đường của bạn từ những lớp học huyền thoại như những người nông dân không biết xấu hổ của Sư tử, những người giữ lời thề thiêng liêng, hay những người Acolytes bí ẩn của Kuu, mỗi người nắm giữ những sức mạnh độc nhất chống lại bóng tối.\nSỰ TÂM THỂ TRONG SỰ TÂM\nMở khóa sức mạnh ảo tưởng của anh bằng cách chạy nghi lễ. Hãy bắt đầu như một tiếng gầm gừ yếu ớt và khám phá ra sự tàn phá xây dựng khi bạn tiến bộ. Mỗi nghi lễ mang lại sự hài lòng về sự tiến triển của một chiếc ARPG dưới dạng tập trung, mỗi lần chạy đưa bạn đến gần hơn với địa vị huyền thoại.\nSỰ ĐỂ ĐỨC CHÚA TRỜI GIẢI TÂM\nKhám phá những khả năng của nhà vô địch, trang bị áo giáp huyền thoại và sử dụng vũ khí độc đáo từ những nhà vô địch thất bại. Tăng cường vũ khí và thủ công của các ngươi xứng đáng để giết các vị thần. Giả thuyết của anh sẽ trở thành thần thánh với sự tùy biến sâu sắc và khả năng không giới hạn.\nHÃY THỬA MỘT SỰ TRONG SỰ\nChiến đấu qua nhiều môi trường khác nhau chứa đầy những thách thức độc đáo và những chủ thể nhỏ đáng sợ. Đối mặt với những sinh vật chết chóc, quân đội chết chóc, và những anh hùng thất bại trong cuộc tìm kiếm của các bạn để khám phá bí mật của hành tinh đen.\nXỬI S dâng cho Đức Chúa Trời\nTrải nghiệm một lĩnh vực tàn bạo của gươm và ma thuật lấy cảm hứng từ những tác phẩm cổ điển tối tăm nhất thời xưa. Những thế lực cổ đại và những nỗi kinh hoàng của vũ trụ ẩn nấp trong mọi tàn tích và vương quốc suy tàn.","aboutGame":null}},"media":{"images":[{"role":"header","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3238670/ec5f8a4347c1aaa55b8657b75d98170333bcebcf/header_alt_assets_0.jpg?t=1790884525"},{"role":"capsule","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3238670/27bd3b8c560b4a17833a0b2836cce32a69aad058/capsule_231x87_alt_assets_0.jpg?t=1790884525"}],"screenshots":[{"id":0,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3238670/c6db3806a04dd7e52a78687f5b9d2c5f60915076/ss_c6db3806a04dd7e52a78687f5b9d2c5f60915076.600x338.jpg?t=1790884525","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3238670/c6db3806a04dd7e52a78687f5b9d2c5f60915076/ss_c6db3806a04dd7e52a78687f5b9d2c5f60915076.1920x1080.jpg?t=1790884525"},{"id":1,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3238670/164043b2a7f3c6f36f2669c128d2b7906b9b956c/ss_164043b2a7f3c6f36f2669c128d2b7906b9b956c.600x338.jpg?t=1790884525","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3238670/164043b2a7f3c6f36f2669c128d2b7906b9b956c/ss_164043b2a7f3c6f36f2669c128d2b7906b9b956c.1920x1080.jpg?t=1790884