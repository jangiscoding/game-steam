tes":["The supplied name exactly matches the normalized official Steam name for the supplied App ID."],"research":{"steam":{"status":"success","checkedAt":"2026-10-15T10:47:19.566Z","error":null}},"steamMetadata":{"appId":"914110","links":{"store":"https://store.steampowered.com/app/914110/","officialWebsite":"https://curvegames.com/our-games/narcos-rise-of-the-cartels/","support":"https://curvegames.com/contact/"},"storageRequirements":{"kind":"required_free_space","windows":{"minimum":{"value":12,"unit":"GB","display":"12 GB","approximateBytes":12000000000,"evidenceText":"Storage: 12 GB"},"recommended":{"value":12,"unit":"GB","display":"12 GB","approximateBytes":12000000000,"evidenceText":"Storage: 12 GB"}},"macos":{"minimum":null,"recommended":null},"linux":{"minimum":null,"recommended":null},"note":"Steam publishes required free space, not the exact installed or download size."},"controllerSupport":{"level":"full","xboxCompatible":null,"xboxEvidence":null,"note":"Generic Steam controller support does not prove Xbox controller compatibility."},"playerModes":{"singlePlayer":true,"multiplayer":false,"coop":false,"onlineCoop":false,"localCoop":false,"lanCoop":false,"sharedOrSplitScreen":false,"pvp":false,"maximumPlayers":null,"maximumPlayersNote":"The public Steam app-details response does not provide a reliable exact player limit.","evidence":["Single-player"]},"genres":["Action","Strategy"],"categories":[{"id":2,"description":"Single-player"},{"id":22,"description":"Steam Achievements"},{"id":28,"description":"Full controller support"},{"id":29,"description":"Steam Trading Cards"},{"id":62,"description":"Family Sharing"}]}},"content":{"status":"success","steamAppId":"914110","steamName":"Narcos: Rise of the Cartels","sourceUrl":"https://store.steampowered.com/app/914110/","fetchedAt":"2026-10-16T09:53:18.666696+00:00","locales":{"en":{"status":"source","provider":"steam","shortDescription":"Narcos: Rise of the Cartels is a brutal turn-based action strategy game based on the hit Netflix TV series. Explore the entire first season from two sides each with their own unique story. Join the narcos and expand the drug cartel empire, or take up arms with the DEA and bring it crumbling down","detailedDescription":"Welcome to Colombia, 1980’s - the fires of El Patrón's empire have been lit, its influence spanning borders, and expansion unabated. Influence and corruption is rife; cops, guards, politicians and those in between are falling into the pocket of the Medellín Cartel, and after years of production, America is finally taking notice.\n\nNarcos: Rise of the Cartels tells the story of the hit Netflix TV series, of the rise and fall of El Patrón. Choose your side and ally with the DEA or conversely side with the Narcos. Explore recognisable locations from the show and take a role in pivotal world-altering events and battles that will define and shift the war on drugs.\n\nForm your team from a variety of class-specific roles, join leading characters, upgrade your skills and take part in brutal turn-based combat, where your actions will have consequence.\n\nPlata o Plomo?\n\n• BASED ON THE HIT NETFLIX TV SERIES\n\nAuthenticity is at the core of the Narcos experience and highly recognisable and iconic characters from the TV show are available to control and play, such as El Mexicano, Murphy, Peña, Primo and more. Every 'leader' character offers unique gameplay abilities and perks to help turn the tide of battle.\n\n• FAST-PACED STRATEGY COMBAT\n\nNarcos: Rise of the Cartels takes turn-based strategy combat to a whole new level with units possessing the ability to move individually one after another or multiple times within one turn, meaning the pace always being ramped up. Plan your moves wisely but be cautious as there are always consequences to your actions.\n\n• EVERY WAR HAS TWO SIDES\n\nFeaturing two unique campaigns, Narcos: Rise of the Cartels allows you to see the war from both sides. Choose to side with the DEA and fight alongside Steve Murphy to bring down the drug empire, or choose to side with the Narcos in order to help found, grow and expand the empire under the watchful eye of El Patrón.\n\n• COUNTERACT AND KILL-SHOT\n\nInnovative gameplay mechanics keep the turn-based genre fresh by allowing you to take third-person control of your units in order to engage enemies directly, giving you the opportunity to deal critical damage at optimum moments.","aboutGame":null},"vi":{"status":"pending_translation","provider":null,"shortDescription":null,"detailedDescription":null,"aboutGame":null}},"media":{"images":[{"role":"header","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/914110/header.jpg?t=1703187436"},{"role":"capsule","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/914110/capsule_231x87.jpg?t=1703187436"}],"screenshots":[{"id":0,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/914110/ss_667d56354ef7c593869c7d7b0b181087914f8f85.600x338.jpg?t=1703187436","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/914110/ss_667d56354ef7c593869c7d7b0b181087914f8f85.1920x1080.jpg?t=1703187436"},{"id":1,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/914110/ss_603f37de1774192b2fc5e56fb05d4619b4890457.600x338.jpg?t=1703187436","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/914110/ss_603f37de1774192b2fc5e56fb05d4619b4890457.1920x1080.jpg?t=1703187436"},{"id":2,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/914110/ss_34edc034e64de7a3f87010570a39090adebbdf53.600x338.jpg?t=1703187436","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/914110/ss_34edc034e64de7a3f87010570a39090adebbdf53.1920x1080.jpg?t=1703187436"},{"id":3,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/914110/ss_679b67db1a8e7906c36ac76e80346e1a9a8e9f6a.600x338.jpg?t=1703187436