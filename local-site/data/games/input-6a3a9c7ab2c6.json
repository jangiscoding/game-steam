es"]}],"confidence":"high","status":"identified","verificationNotes":["The supplied name exactly matches the normalized official Steam name for the supplied App ID."],"research":{"steam":{"status":"success","checkedAt":"2026-10-15T10:00:36.777Z","error":null}},"steamMetadata":{"appId":"895400","links":{"store":"https://store.steampowered.com/app/895400/","officialWebsite":"http://deadsidegame.com/","support":null},"storageRequirements":{"kind":"required_free_space","windows":{"minimum":{"value":25,"unit":"GB","display":"25 GB","approximateBytes":25000000000,"evidenceText":"Storage: 25 GB"},"recommended":{"value":25,"unit":"GB","display":"25 GB","approximateBytes":25000000000,"evidenceText":"Storage: 25 GB"}},"macos":{"minimum":null,"recommended":null},"linux":{"minimum":null,"recommended":null},"note":"Steam publishes required free space, not the exact installed or download size."},"controllerSupport":{"level":"unknown","xboxCompatible":null,"xboxEvidence":null,"note":"Generic Steam controller support does not prove Xbox controller compatibility."},"playerModes":{"singlePlayer":false,"multiplayer":true,"coop":true,"onlineCoop":true,"localCoop":false,"lanCoop":false,"sharedOrSplitScreen":false,"pvp":true,"maximumPlayers":null,"maximumPlayersNote":"The public Steam app-details response does not provide a reliable exact player limit.","evidence":["Multi-player","PvP","Online PvP","Co-op","Online Co-op"]},"genres":["Action","Adventure","Indie","Massively Multiplayer"],"categories":[{"id":1,"description":"Multi-player"},{"id":20,"description":"MMO"},{"id":49,"description":"PvP"},{"id":36,"description":"Online PvP"},{"id":9,"description":"Co-op"},{"id":38,"description":"Online Co-op"},{"id":22,"description":"Steam Achievements"},{"id":62,"description":"Family Sharing"}]}},"content":{"status":"success","steamAppId":"895400","steamName":"Deadside","sourceUrl":"https://store.steampowered.com/app/895400/","fetchedAt":"2026-10-16T09:52:11.445412+00:00","locales":{"en":{"status":"source","provider":"steam","shortDescription":"An Open World Survival Shooter blending hardcore PVP and PVE action. Secure precious loot in safe zones or build your own fortress in the wild. With intense gunfights, stunning visuals, and performance smooth enough for any system, the challenge awaits!","detailedDescription":"DEADSIDE blends your favorite Survival Shooter elements in a fast-paced open world where progression is swift and loot is plenty. Obtain valuable gear, and store it in a safe zone. Or build your own fortress in the wild, securing it with turrets, making it cozy while boosting your stats, and use it to store your vehicles and loot. Traverse the world by foot, car, motorcycle, boat, or a Quick Travel metro system. Make friends or enemies. Join PVP or PVE servers. Explore the vast open world filled with challenging events, and raid your enemies.\n\nPVP, PVE, RAIDING\n\nWe have 3 main types of servers in DEADSIDE 1.0: PVP, PVE, and PVP scheduled raids\n\nNote on all 3 types of servers your player disappears when offline with all loot on your body\n\n• \nPVP servers provide an intense hardcore experience where players can engage in fights, and can raid each other’s bases with no limits. \n\n• \nPVE servers are a more chill experience where you can interact with other players, and can’t fight each other or raid/steal each other’s bases. We recommend this mode to learn the game’s mechanics. \n\n• \nPVP scheduled raids have specific times on the server when raiding is allowed\n\nVEHICLES AND FAST TRAVEL\n\nNobody likes running forever in open world survival games. DEADSIDE has boats, motorcycles, cars, and a Fast Travel System to easily get around the map. Secure your vehicles with codelocks and use them for storage. \n\nBASE BUILDING AND COMFORT SYSTEM\n\nBuild a secluded shack or a secured fortress. We made it easy to build with an intuitive tool, and added plenty of comfort items which are useful for gameplay boosts. Secure your base with passive defenses such as turrets and traps. Store your vehicles, and keep your hard earned loot safe from raiders.\n\nTHE WORLD OF DEADSIDE\n\nExplore the forests, rivers, and settlements of this post-soviet apocalypse. You can build anywhere outside of settlements. Challenging NPCs patrol the map, and your progression is solely decided by your own skill. There are no levels or bars. Your level is your skill and the equipment you acquire.\n\nWEAPONS, COMBAT SYSTEM, MISSIONS\n\n \n\nIt's all about the ballistics and variety of weapons. Choose from 32 firearms, and modify them with scopes, expanded mags, flashlights, silencers and other modules. Feeling tactical? Setup tripwire traps, respawn bags, use smoke grenades for cover. The combat system is designed to be hardcore. Combine this with an intuitive missions system with clearly marked objectives on the map and you have the perfect hardcore survival shooter.","aboutGame":null},"vi":{"status":"pending_translation","provider":null,"shortDescription":null,"detailedDescription":null,"aboutGame":null}},"media":{"images":[{"role":"header","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/895400/b3667710eca8e8c00d3e22227b8eb66bf9fd57f5/header_alt_assets_4.jpg?t=1777456799"},{"role":"capsule","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/895400/ebe59da91545e26573c011d162cf15f4a40183b3/capsule_231x87.jpg?t=1777456799"}],"screenshots":[{"id":0,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/895400/ss_c02b08c9beee73e0c55acaf73b498bc6c024dffe.600x338.jpg?t=1777456799","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/895400/ss_c02b08c9beee73e0c55acaf73b498bc6c024dffe.1920x1080.jpg?t=1777456799"},{"id":1,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/895400/ss_98bfc67e0b7fadd8a6ba3562e3b114a5c1e50ec0.600x338.jpg?t=1777456799","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam