{"id":"input-b301309ba843","steamAppId":"924970","name":"Back 4 Blood","imageUrl":"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/924970/library_600x900.jpg","imageStatus":"downloaded","steamUrl":"https://store.steampowered.com/app/924970/","genres":["Action"],"platforms":["windows"],"controllerSupport":"full","playerModes":{"singlePlayer":true,"multiplayer":true,"coop":true,"localCoop":false,"sharedOrSplitScreen":false,"onlineCoop":true,"maximumPlayers":null},"storage":{"windowsMinimumGB":40.0,"windowsMinimumDisplay":"40 GB"},"verificationStatus":"identified","custom":{},"sourceProfile":{"inputRecordId":"input-b301309ba843","canonicalId":"steam-app-924970","suppliedName":"Back 4 Blood","suppliedImageUrl":"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/924970/library_600x900.jpg","officialName":"Back 4 Blood","aliases":[],"series":null,"franchise":null,"productType":"game","editionName":null,"originalReleaseYear":null,"identifiedVersionReleaseYear":2021,"developers":["Turtle Rock Studios"],"publishers":["Warner Bros. Games"],"platforms":["windows"],"genres":["Action"],"shortDescription":"Back 4 Blood is a thrilling cooperative first-person shooter from the creators of the critically acclaimed Left 4 Dead franchise. Experience the intense 4 player co-op narrative campaign, competitive multiplayer as human or Ridden, and frenetic gameplay that keeps you in the action.","confusingWith":[],"candidateIdentifiers":{"steamAppId":"924970"},"sources":[{"label":"Steam Store","url":"https://store.steampowered.com/app/924970/","accessedAt":"2026-10-15T09:57:34.146Z","supports":["officialName","productType","identifiedVersionReleaseYear","developers","publishers","platforms","genres","shortDescription","steamMetadata.links","steamMetadata.storageRequirements","steamMetadata.controllerSupport","steamMetadata.playerModes"]}],"confidence":"high","status":"identified","verificationNotes":["The supplied name exactly matches the normalized official Steam name for the supplied App ID."],"research":{"steam":{"status":"success","checkedAt":"2026-10-15T09:57:34.146Z","error":null}},"steamMetadata":{"appId":"924970","links":{"store":"https://store.steampowered.com/app/924970/","officialWebsite":"https://back4blood.com/","support":"http://support.wbgames.com/"},"storageRequirements":{"kind":"required_free_space","windows":{"minimum":{"value":40,"unit":"GB","display":"40 GB","approximateBytes":40000000000,"evidenceText":"Storage: 40 GB"},"recommended":{"value":40,"unit":"GB","display":"40 GB","approximateBytes":40000000000,"evidenceText":"Storage: 40 GB"}},"macos":{"minimum":null,"recommended":null},"linux":{"minimum":null,"recommended":null},"note":"Steam publishes required free space, not the exact installed or download size."},"controllerSupport":{"level":"full","xboxCompatible":null,"xboxEvidence":null,"note":"Generic Steam controller support does not prove Xbox controller compatibility."},"playerModes":{"singlePlayer":true,"multiplayer":true,"coop":true,"onlineCoop":true,"localCoop":false,"lanCoop":false,"sharedOrSplitScreen":false,"pvp":true,"maximumPlayers":null,"maximumPlayersNote":"The public Steam app-details response does not provide a reliable exact player limit.","evidence":["Single-player","Multi-player","PvP","Online PvP","Co-op","Online Co-op"]},"genres":["Action"],"categories":[{"id":2,"description":"Single-player"},{"id":1,"description":"Multi-player"},{"id":49,"description":"PvP"},{"id":36,"description":"Online PvP"},{"id":9,"description":"Co-op"},{"id":38,"description":"Online Co-op"},{"id":28,"description":"Full controller support"},{"id":61,"description":"HDR available"},{"id":62,"description":"Family Sharing"}]}},"content":{"status":"success","steamAppId":"924970","steamName":"Back 4 Blood","sourceUrl":"https://store.steampowered.com/app/924970/","fetchedAt":"2026-10-16T09:54:05.129774+00:00","locales":{"en":{"status":"source","provider":"steam","shortDescription":"Back 4 Blood is a thrilling cooperative first-person shooter from the creators of the critically acclaimed Left 4 Dead franchise. Experience the intense 4 player co-op narrative campaign, competitive multiplayer as human or Ridden, and frenetic gameplay that keeps you in the action.","detailedDescription":"Back 4 Blood: Deluxe Edition\n\nBuy Back 4 Blood: Deluxe Edition and get:\n\n•  Base Game\n\n•  Annual Pass: Three upcoming downloadable content drops with New Story, Playable Characters, Special Mutated Ridden, and more\n\nBack 4 Blood: Ultimate Edition\n\nBuy Back 4 Blood: Ultimate Edition and get:\n\n•  Base Game\n\n•  Annual Pass: Three upcoming downloadable content drops with New Story, Playable Characters, Special Mutated Ridden, and more\n\n•  4 Character Battle Hardened Skin Pack\n\n•  Additional digital in-game items: Rare Banner, Emblem, Spray, Title\n\nAbout the Game\nBack 4 Blood is a thrilling cooperative first-person shooter from the creators of the critically acclaimed Left 4 Dead franchise. You are at the center of a war against the Ridden. These once-human hosts of a deadly parasite have turned into terrifying creatures bent on devouring what remains of civilization. With humanity's extinction on the line, it's up to you and your friends to take the fight to the enemy, eradicate the Ridden, and reclaim the world.\nCooperative Campaign\n\nFight your way through a dynamic, perilous world in a 4-player co-op story campaign where you must work together to survive increasingly challenging missions. Play with up to 3 of your friends online or go solo and lead your team in battle.\n \nChoose from 8 customizable Cleaners, one of the immune survivors, and a range of lethal weapons and items. Strategise against an ever-evolving enemy bent on your total destruction.\nCompetitive Multiplayer\n\nPlay with or against friends in PVP. Switch between playing as a Cleaner with special perks and the horrific Ridden. Both sides come with unique weapons, abilities, and specialties.\nExtreme Replayability\n\nA new \"rogue-lite\" Card System creates different experiences each and every time, putting you in control to craft custom decks, roll different builds and undertake more demanding fights.\n\nThe Game Director is constantly adjusting to player actions, ensuring exciting fights, extreme gameplay diversity, and tougher legions of Ridden - including mutated boss types up to 20 feet tall.","aboutGame":"Back 4 Blood is a thrilling cooperative first-person shooter from the creators of the critically acclaimed Left 4 Dead franchise. You are at the center of a war against the Ridden. These once-human hosts of a deadly parasite have turned into terrifying creatures bent on devouring what remains of civilization. With humanity's extinction on the line, it's up to you and your friends to take the fight to the enemy, eradicate the Ridden, and reclaim the world.\nCooperative Campaign\n\nFight your way through a dynamic, perilous world in a 4-player co-op story campaign where you must work together to survive increasingly challenging missions. Play with up to 3 of your friends online or go solo and lead your team in battle.\n \nChoose from 8 customizable Cleaners, one of the immune survivors, and a range of lethal weapons and items. Strategise against an ever-evolving enemy bent on your total destruction.\nCompetitive Multiplayer\n\nPlay with or against friends in PVP. Switch between playing as a Cleaner with special perks and the horrific Ridden. Both sides come with unique weapons, abilities, and specialties.\nExtreme Replayability\n\nA new \"rogue-lite\" Card System creates different experiences each and every time, putting you in control to craft custom decks, roll different builds and undertake more demanding fights.\n\nThe Game Director is constantly adjusting to player actions, ensuring exciting fights, extreme gameplay diversity, and tougher legions of Ridden - including mutated boss types up to 20 feet tall."},"vi":{"status":"translated","provider":"argos-translate-en_vi-1.9-ctranslate2-int8","translatedAt":"2026-10-16T13:31:27.291896+00:00","sourceHash":"26bf292a6d1a6ddecb05fe3d21d400b430e392ee5e3f1c1154c96203e0d4783b","reviewStatus":"machine_translation_unreviewed","shortDescription":"4 Blood là tay súng hợp tác tuyệt vời từ những người sáng tạo ra tổ chức 4 cái chết. Trải nghiệm về chiến dịch tranh cử giữa 4 cầu thủ và đối thủ, cạnh tranh với tư cách là con người hay Riden, và trò chơi giả tạo giúp bạn tiếp tục hành động.","detailedDescription":"4 Máu: Ấn bản Deluxe\nMua lại 4 Máu: ấn bản Deluxe và lấy:\n• Trò chơi cơ bản\n• Qua năm thường niên: Ba nội dung sắp được tải về sẽ được thả xuống với câu chuyện mới, tính cách đáng tin cậy, xe ngựa đặc biệt và nhiều hơn nữa\n4 Huyết: Ấn bản tối đa\nMua lại 4 Blood: Ấn bản tối đa và nhận được:\n• Trò chơi cơ bản\n• Qua năm thường niên: Ba nội dung sắp được tải về sẽ được thả xuống với câu chuyện mới, tính cách đáng tin cậy, xe ngựa đặc biệt và nhiều hơn nữa\n• 4 Trận chiến đặc biệt với lớp da cứng cáp\n• Các mục nhập vào trò chơi điện tử: Biểu ngữ hiếm, Emblem, Scry, Đầu đề\nGiới thiệu về trò chơi 4 Blood là tay súng hợp tác tuyệt vời từ những người sáng tạo ra tổ chức 4 cái chết. Ngươi đang ở trung tâm của cuộc chiến chống lại Riden. Những chủ thể từng là người của một loại ký sinh trùng chết người đã biến thành những sinh vật đáng sợ nhất quyết nuốt chửng những gì còn lại của nền văn minh. Với sự tuyệt chủng của nhân loại trên ranh giới, tùy thuộc vào anh và bạn bè anh để chiến đấu với kẻ thù, xóa sổ Riden, và giành lại thế giới. Chiến dịch hợp tác\nHãy chiến đấu để vượt qua một thế giới đầy năng động và nguy hiểm trong một chiến dịch đối đầu với 4 người chơi, nơi mà bạn phải làm việc cùng nhau để sống sót qua những nhiệm vụ ngày càng khó khăn. Chơi với 3 người bạn trực tuyến hoặc đi một mình và dẫn đội của bạn ra trận.\nChọn từ 8 người dọn dẹp, một trong những người sống sót khỏi bệnh tật, và một loạt vũ khí và vật dụng gây chết người. Chiến lược chống lại một kẻ thù luôn luôn muốn hủy diệt hoàn toàn các người. Nhiều người thi đấu\nChơi với bạn bè ở PVP. Chuyển giao giữa việc làm sạch với đặc quyền và Riden kinh khủng. Cả hai bên đều có vũ khí, khả năng và chuyên môn độc đáo. Khả năng lặp lại thái quá\nMột hệ thống thẻ bài mới tạo ra những trải nghiệm khác nhau mỗi lần, giúp bạn kiểm soát được các bộ phận máy móc, lắp ráp các tòa nhà khác nhau và thực hiện nhiều cuộc chiến đòi hỏi hơn.\nGiám đốc trò chơi liên tục điều chỉnh hành động của người chơi, đảm bảo các trận đấu thú vị, sự đa dạng trò chơi cực đoan, và các quân đoàn Riden cứng rắn hơn - bao gồm các loại đại ca đột biến cao đến 20 feet.","aboutGame":"4 Blood là tay súng hợp tác tuyệt vời từ những người sáng tạo ra tổ chức 4 cái chết. Ngươi đang ở trung tâm của cuộc chiến chống lại Riden. Những chủ thể từng là người của một loại ký sinh trùng chết người đã biến thành những sinh vật đáng sợ nhất quyết nuốt chửng những gì còn lại của nền văn minh. Với sự tuyệt chủng của nhân loại trên ranh giới, tùy thuộc vào anh và bạn bè anh để chiến đấu với kẻ thù, xóa sổ Riden, và giành lại thế giới. Chiến dịch hợp tác\nHãy chiến đấu để vượt qua một thế giới đầy năng động và nguy hiểm trong một chiến dịch đối đầu với 4 người chơi, nơi mà bạn phải làm việc cùng nhau để sống sót qua những nhiệm vụ ngày càng khó khăn. Chơi với 3 người bạn trực tuyến hoặc đi một mình và dẫn đội của bạn ra trận.\nChọn từ 8 người dọn dẹp, một trong những người sống sót khỏi bệnh tật, và một loạt vũ khí và vật dụng gây chết người. Chiến lược chống lại một kẻ thù luôn luôn muốn hủy diệt hoàn toàn các người. Nhiều người chơi thi đấu\nChơi với bạn bè ở PVP. Chuyển giao giữa việc làm sạch với đặc quyền và Riden kinh khủng. Cả hai bên đều có vũ khí, khả năng và chuyên môn độc đáo. Khả năng lặp lại thái quá\nMột hệ thống thẻ bài mới tạo ra những trải nghiệm khác nhau mỗi lần, giúp bạn kiểm soát được các bộ phận máy móc, lắp ráp các tòa nhà khác nhau và thực hiện nhiều cuộc chiến đòi hỏi hơn.\nGiám đốc trò chơi liên tục điều chỉnh hành động của người chơi, đảm bảo các trận đấu thú vị, sự đa dạng trò chơi cực đoan, và các quân đoàn Riden cứng rắn hơn - bao gồm các loại đại ca đột biến cao đến 20 feet."}},"media":{"images":[{"role":"header","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/924970/header.jpg?t=1780594976"},{"role":"capsule","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/924970/capsule_231x87.jpg?t=1780594976"},{"role":"description","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/924970/extras/dd695ade9e2cd9f8e80518d6afd0a3e3.avif?t=1780594976","alt":""},{"role":"description","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/924970/extras/57cfd52911e9d1b99a6600ebd2974058.avif?t=1780594976","alt":""}],"screenshots":[{"id":0,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/924970/ss_3329126d46bfd0cd32069508a1d37e40a1f4d92e.600x338.jpg?t=1780594976","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/924970/ss_3329126d46bfd0cd32069508a1d37e40a1f4d92e.1920x1080.jpg?t=1780594976"},{"id":1,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/924970/ss_61ba5c1e5ff0992738255a3c6679fdbc2cd659de.600x338.jpg?t=1780594976","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/924970/ss_61ba5c1e5ff0992738255a3c6679fdbc2cd659de.1920x1080.jpg?t=1780594976"},{"id":2,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/924970/ss_01d625277a7dc76a67f78de3a3ed1e633d205ddd.600x338.jpg?t=1780594976","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/924970/ss_01d625277a7dc76a67f78de3a3ed1e633d205ddd.1920x1080.jpg?t=1780594976"},{"id":3,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/924970/ss_cb8d4bd7139ce8f80df16e5c7c4be906222f050b.600x338.jpg?t=1780594976","url":"https://shared.akamai.steamstatic