yerModes"]}],"confidence":"high","status":"identified","verificationNotes":["The supplied name exactly matches the normalized official Steam name for the supplied App ID."],"research":{"steam":{"status":"success","checkedAt":"2026-10-15T11:02:23.442Z","error":null}},"steamMetadata":{"appId":"326460","links":{"store":"https://store.steampowered.com/app/326460/","officialWebsite":"http://www.shellshocklive.com/","support":"http://www.shellshocklive.com/"},"storageRequirements":{"kind":"required_free_space","windows":{"minimum":{"value":500,"unit":"MB","display":"500 MB","approximateBytes":500000000,"evidenceText":"Storage: 500 MB"},"recommended":null},"macos":{"minimum":{"value":500,"unit":"MB","display":"500 MB","approximateBytes":500000000,"evidenceText":"Storage: 500 MB"},"recommended":null},"linux":{"minimum":{"value":500,"unit":"MB","display":"500 MB","approximateBytes":500000000,"evidenceText":"Storage: 500 MB"},"recommended":null},"note":"Steam publishes required free space, not the exact installed or download size."},"controllerSupport":{"level":"full","xboxCompatible":null,"xboxEvidence":null,"note":"Generic Steam controller support does not prove Xbox controller compatibility."},"playerModes":{"singlePlayer":true,"multiplayer":true,"coop":true,"onlineCoop":true,"localCoop":true,"lanCoop":false,"sharedOrSplitScreen":true,"pvp":true,"maximumPlayers":null,"maximumPlayersNote":"The public Steam app-details response does not provide a reliable exact player limit.","evidence":["Single-player","Multi-player","PvP","Online PvP","Shared/Split Screen PvP","Co-op","Online Co-op","Shared/Split Screen Co-op","Shared/Split Screen"]},"genres":["Action","Casual","Indie","Massively Multiplayer","Strategy"],"categories":[{"id":2,"description":"Single-player"},{"id":1,"description":"Multi-player"},{"id":49,"description":"PvP"},{"id":36,"description":"Online PvP"},{"id":37,"description":"Shared/Split Screen PvP"},{"id":9,"description":"Co-op"},{"id":38,"description":"Online Co-op"},{"id":39,"description":"Shared/Split Screen Co-op"},{"id":24,"description":"Shared/Split Screen"},{"id":22,"description":"Steam Achievements"},{"id":28,"description":"Full controller support"},{"id":29,"description":"Steam Trading Cards"},{"id":35,"description":"In-App Purchases"},{"id":15,"description":"Stats"},{"id":25,"description":"Steam Leaderboards"},{"id":17,"description":"Includes level editor"},{"id":41,"description":"Remote Play on Phone"},{"id":42,"description":"Remote Play on Tablet"},{"id":44,"description":"Remote Play Together"},{"id":62,"description":"Family Sharing"}]}},"content":{"status":"success","steamAppId":"326460","steamName":"ShellShock Live","sourceUrl":"https://store.steampowered.com/app/326460/","fetchedAt":"2026-10-16T08:57:09.059913+00:00","locales":{"en":{"status":"source","provider":"steam","shortDescription":"Demolish your friends with hundreds of upgradable weapons shot from your customizable tank in this action-packed online multiplayer tanks game. Earn XP to level up and unlock new tanks, weapons, and gear. Fight against or alongside your friends for strategic team or free-for-all matches.","detailedDescription":"ShellShock Live is a strategic online multiplayer artillery game developed by kChamp Games.\nFight Alongside your Friends (Or blow them up... we won't judge!)\n\nTake part in action-packed 8-Player team and free-for all battles.  Tactical gameplay is essential to victory, while numerous distinct tanks, weapons, items, maps, and play styles make every match unique.\nWay Too Many Weapons\n\nIt's a bit ridiculous.  Unlock, upgrade, and master over 400 unique power-packed weapons, from the intimidating 'Seagull' to the ever-powerful 'Mega-Nuke'.  The best part is that we're building and adding more daily.\nLoads of Modes\n\nArmored carnage must get old after a while, right?  Wrong.  Unique game modes keep things fresh and give you the opportunity to demolish tanks in a multitude of ways.\nBecome the Best There Ever Was\n\nEarn XP to level up and become king of the battlefield.  Play through 100 unique ranks, each with their own rewards and unlocks.  Global leaderboards and rankings keep things spicy.\nUpgrade Everything\n\nAnd when we say everything, we mean everything.  Upgrade your tank.  Upgrade your skills. Upgrade your items.  Upgrade your arsenal.  All 400+ of the game's weapons can be upgraded to more powerful versions.\nNature Doesn't Stand a Chance\n\nFully destructible terrain creates a dynamically changing battlefield.  Earthquakes and other natural disasters keep you on your toes (just like in real life!)\n(Very) Active Development\n\nWe've been cranking out ShellShock Live updates with new features and awesome community suggestions almost daily.  Check out the Announcements section for full release notes, or join the community on the Forums.\nNon-Evil Developers\n\nAll gameplay content is earned by playing, not paying.  Any content that can be purchased is purely cosmetic and can only benefit other players and the community.","aboutGame":null},"vi":{"status":"translated","provider":"argos-translate-en_vi-1.9-ctranslate2-int8","translatedAt":"2026-10-16T12:48:53.166607+00:00","sourceHash":"b2b27e9c31abb6f14131c686428a94f09cb74053c5ac157d0249306a8b774a21","reviewStatus":"machine_translation_unreviewed","shortDescription":"Cho thấy bạn bè của bạn với hàng trăm phát súng có thể nâng cấp từ xe tăng tùy chỉnh của bạn trong trò chơi xe tăng hành động trực tuyến nhiều người chơi. Tai XP để san bằng và mở khóa xe tăng mới, vũ khí và thiết bị. Chiến đấu chống lại hoặc sát cánh với bạn bè cho đội chiến lược hoặc giải phóng cho tất cả.","detailedDescription":"ShellShock Live là một trò chơi pháo binh chiến lược trực tuyến được phát triển bởi KChamp Games. Chiến đấu bên cạnh bạn bè của bạn, hoặc thổi chúng lên... chúng tôi sẽ không phán xét!)\nTham gia vào đội ngũ 8 người chơi và giải phóng cho tất cả các trận chiến. Vở kịch chiến thuật là điều thiết yếu để chiến thắng, trong khi nhiều xe tăng, vũ khí, đồ vật, bản đồ và kiểu chơi khác nhau làm cho mỗi trận đấu trở nên độc đáo. Quá nhiều vũ khí\nHơi lố bịch. Mở khóa, nâng cấp, và làm chủ hơn 400 vũ khí có năng lượng độc nhất vô nhị, từ \"Seagull\" đáng sợ đến \"Mega-Nuke\". Phần hay nhất là chúng tôi đang xây dựng và thêm vào hàng ngày. Tải về các chế độ\nGiết người bằng vũ khí chắc phải cũ lắm, phải không? Sai rồi. Chế độ game độc đáo giữ cho mọi thứ mới mẻ và cho bạn cơ hội để phá hủy bể chứa theo nhiều cách. Trở thành người giỏi nhất từ trước đến nay\nEarn XP để san bằng và trở thành vua của chiến trường. Hãy chơi qua 100 đẳng cấp độc nhất vô nhị, mỗi người phải tự thưởng và mở khóa. Các bảng lãnh đạo toàn cầu và xếp hạng giữ cho mọi thứ trở nên cay. Nâng cấp tất cả\nVà khi chúng ta nói tất cả, chúng ta có nghĩa là tất cả. Nâng cấp bình xăng. Nâng cao kỹ năng của bạn. Nâng cấp đồ đạc. Nâng cấp vũ khí. Tất cả 400+ của vũ khí trò chơi có thể được nâng cấp lên những phiên bản mạnh hơn. Thiên nhiên không có cơ hội\nĐịa hình hoàn toàn có thể phá hủy tạo ra một chiến trường thay đổi động lực. Động đất và những thảm họa thiên nhiên khác giữ chân bạn vững (như trong đời thực!) (Rất) Phát triển tích cực\nChúng tôi đã tìm ra bản cập nhật ShellShock trực tiếp với những tính năng mới và những gợi ý cộng đồng tuyệt vời gần như hàng ngày. Kiểm tra khu thông báo để ghi chú đầy đủ, hoặc gia nhập cộng đồng trên diễn đàn. Các nhà phát triển không phải là Evil\nTất cả các trò chơi nội dung được kiếm được bằng cách chơi, không phải trả tiền. Bất cứ nội dung nào có thể mua được đều hoàn toàn là mỹ phẩm và chỉ có thể mang lại lợi ích cho những người chơi khác và cộng đồng.","aboutGame":null}},"media":{"images":[{"role":"header","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/326460/header.jpg?t=1683306935"},{"role":"capsule","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/326460/capsule_231x87.jpg?t=1683306935"},{"role":"description","url":"https://shared.akamai