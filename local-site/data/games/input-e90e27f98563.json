tly matches the normalized official Steam name for the supplied App ID."],"research":{"steam":{"status":"success","checkedAt":"2026-10-15T11:10:09.432Z","error":null}},"steamMetadata":{"appId":"429660","links":{"store":"https://store.steampowered.com/app/429660/","officialWebsite":null,"support":"http://www.bandainamcoent.com/"},"storageRequirements":{"kind":"required_free_space","windows":{"minimum":{"value":15,"unit":"GB","display":"15 GB","approximateBytes":15000000000,"evidenceText":"Storage: 15 GB"},"recommended":{"value":15,"unit":"GB","display":"15 GB","approximateBytes":15000000000,"evidenceText":"Storage: 15 GB"}},"macos":{"minimum":null,"recommended":null},"linux":{"minimum":null,"recommended":null},"note":"Steam publishes required free space, not the exact installed or download size."},"controllerSupport":{"level":"full","xboxCompatible":null,"xboxEvidence":null,"note":"Generic Steam controller support does not prove Xbox controller compatibility."},"playerModes":{"singlePlayer":true,"multiplayer":true,"coop":false,"onlineCoop":false,"localCoop":false,"lanCoop":false,"sharedOrSplitScreen":true,"pvp":false,"maximumPlayers":null,"maximumPlayersNote":"The public Steam app-details response does not provide a reliable exact player limit.","evidence":["Single-player","Multi-player","Shared/Split Screen"]},"genres":["Action","RPG"],"categories":[{"id":2,"description":"Single-player"},{"id":1,"description":"Multi-player"},{"id":24,"description":"Shared/Split Screen"},{"id":22,"description":"Steam Achievements"},{"id":28,"description":"Full controller support"},{"id":29,"description":"Steam Trading Cards"},{"id":23,"description":"Steam Cloud"},{"id":41,"description":"Remote Play on Phone"},{"id":42,"description":"Remote Play on Tablet"},{"id":43,"description":"Remote Play on TV"},{"id":44,"description":"Remote Play Together"},{"id":62,"description":"Family Sharing"}]}},"content":{"status":"success","steamAppId":"429660","steamName":"Tales of Berseria™","sourceUrl":"https://store.steampowered.com/app/429660/","fetchedAt":"2026-10-16T09:15:04.311971+00:00","locales":{"en":{"status":"source","provider":"steam","shortDescription":"Players embark on a journey of self-discovery as they assume the role of Velvet, a young woman whose once kind demeanor has been replaced and overcome with a festering anger and hatred after a traumatic experience three years prior to the events within Tales of Berseria.","detailedDescription":"A tale of emotion versus reason…\n\nIn Tales of Berseria, players embark on a journey of self-discovery as they assume the role of Velvet, a young woman whose once kind demeanor has been replaced and overcome with a festering anger and hatred after a traumatic experience three years prior to the events within Tales of Berseria. Velvet will join a crew of pirates as they sail across the sea and visit the many islands that make up the sacred kingdom of Midgand in an all-new adventure developed by the celebrated team behind the Tales of series. Veteran Tales of character designer Mutsumi Inomata has personally designed Velvet and famous Japanese animation studio, ufotable, returns to animate the game’s breathtaking cutscenes; delivering truly epic and emotional storytelling in their unique style.","aboutGame":null},"vi":{"status":"translated","provider":"argos-translate-en_vi-1.9-ctranslate2-int8","translatedAt":"2026-10-16T13:02:24.437681+00:00","sourceHash":"d582baad3fbd0a9bc00c9eaed54a90b460fbd532ab78e0562a46416182e4da74","reviewStatus":"machine_translation_unreviewed","shortDescription":"Những người chơi bắt đầu một hành trình tự khám phá bản thân khi họ đảm nhận vai trò của Velvet, một người phụ nữ trẻ có thái độ tử tế trước kia đã được thay thế và vượt qua với một cơn giận dữ và sự căm ghét cay đắng sau ba năm đau đớn trước sự kiện trong những câu chuyện của Berseria.","detailedDescription":"Một câu chuyện về cảm xúc đấu với lý do...\nTrong những câu chuyện của Berseria, người chơi bắt đầu một cuộc hành trình của tự khám phá như họ đảm nhận vai trò của Velvet, một phụ nữ trẻ có thái độ tử tế đã được thay thế và vượt qua với một cơn giận dữ và căm ghét cay đắng sau ba năm kinh nghiệm đau thương trước sự kiện bên trong những câu chuyện của Berseria. Velvet sẽ gia nhập một đội cướp biển khi họ băng qua biển và viếng thăm nhiều hòn đảo hợp thành vương quốc thiêng liêng của Midgand trong một cuộc phiêu lưu mới được phát triển bởi đội ngũ nổi tiếng đằng sau những câu chuyện. Những câu chuyện về nhà thiết kế nhân vật Mutsumi Inomata đã đích thân thiết kế ra Velvet và studio hoạt hình nổi tiếng Nhật Bản, không thể nào ngờ được, trở lại để làm sống lại những cảnh tượng tuyệt đẹp của trò chơi; trình bày những câu chuyện kể chuyện lịch sử và tình cảm theo phong cách độc đáo của chúng.","aboutGame":null}},"media":{"images":[{"role":"header","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/429660/header.jpg?t=1763571708"},{"role":"capsule","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/429660/capsule_231x87.jpg?t=1763571708"}],"screenshots":[{"id":0,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/429660/ss_55b6307b686684a7c1ee00357eb6be0e05a6024f.600x338.jpg?t=1763571708","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/429660/ss_55b6307b686684a7c1ee00357eb6be0e05a6024f.1920x1080.jpg?t=1763571708"},{"id":1,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/429660/ss_8a95a8aeef9af710ab71f49606271da9053127fb.600x338.jpg?t=1763571708","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/429660/ss_8a95a8aeef9af710ab71f49606271da9053127fb.1920x1080.jpg?t=1763571708"},{"id":2,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/429660/ss_755410557ed1499bd2271869a3e87cda172e5555.600x338.jpg?t=1763571708","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/429660/ss_755410557ed