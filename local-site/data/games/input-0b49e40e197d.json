{"id":"input-0b49e40e197d","steamAppId":"1133060","name":"Anarchy: Wolf's law","imageUrl":"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/1133060/library_600x900.jpg","imageStatus":"downloaded","steamUrl":"https://store.steampowered.com/app/1133060/","genres":["Action","Adventure","Indie","Simulation","Strategy"],"platforms":["windows"],"controllerSupport":"unknown","playerModes":{"singlePlayer":true,"multiplayer":true,"coop":false,"localCoop":false,"sharedOrSplitScreen":false,"onlineCoop":false,"maximumPlayers":null},"storage":{"windowsMinimumGB":8.0,"windowsMinimumDisplay":"8 GB"},"verificationStatus":"identified","custom":{},"sourceProfile":{"inputRecordId":"input-0b49e40e197d","canonicalId":"steam-app-1133060","suppliedName":"Anarchy: Wolf's law","suppliedImageUrl":"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/1133060/library_600x900.jpg","officialName":"Anarchy: Wolf's law","aliases":[],"series":null,"franchise":null,"productType":"game","editionName":null,"originalReleaseYear":null,"identifiedVersionReleaseYear":2023,"developers":["Anarchy Games"],"publishers":["Anarchy Games"],"platforms":["windows"],"genres":["Action","Adventure","Indie","Simulation","Strategy"],"shortDescription":"Action. Chaos. Power. Anarchy: Wolf Laws is a dynamic first-person shooter with elements of RPG, survival, and strategic management. Capture territories, upgrade your production, and run your business in a world of total lawlessness.","confusingWith":[],"candidateIdentifiers":{"steamAppId":"1133060"},"sources":[{"label":"Steam Store","url":"https://store.steampowered.com/app/1133060/","accessedAt":"2026-10-15T09:56:54.667Z","supports":["officialName","productType","identifiedVersionReleaseYear","developers","publishers","platforms","genres","shortDescription","steamMetadata.links","steamMetadata.storageRequirements","steamMetadata.controllerSupport","steamMetadata.playerModes"]}],"confidence":"high","status":"identified","verificationNotes":["The supplied name exactly matches the normalized official Steam name for the supplied App ID."],"research":{"steam":{"status":"success","checkedAt":"2026-10-15T09:56:54.667Z","error":null}},"steamMetadata":{"appId":"1133060","links":{"store":"https://store.steampowered.com/app/1133060/","officialWebsite":null,"support":null},"storageRequirements":{"kind":"required_free_space","windows":{"minimum":{"value":8,"unit":"GB","display":"8 GB","approximateBytes":8000000000,"evidenceText":"Storage: 8 GB"},"recommended":{"value":8,"unit":"GB","display":"8 GB","approximateBytes":8000000000,"evidenceText":"Storage: 8 GB"}},"macos":{"minimum":null,"recommended":null},"linux":{"minimum":null,"recommended":null},"note":"Steam publishes required free space, not the exact installed or download size."},"controllerSupport":{"level":"unknown","xboxCompatible":null,"xboxEvidence":null,"note":"Generic Steam controller support does not prove Xbox controller compatibility."},"playerModes":{"singlePlayer":true,"multiplayer":true,"coop":false,"onlineCoop":false,"localCoop":false,"lanCoop":false,"sharedOrSplitScreen":false,"pvp":true,"maximumPlayers":null,"maximumPlayersNote":"The public Steam app-details response does not provide a reliable exact player limit.","evidence":["Single-player","Multi-player","PvP"]},"genres":["Action","Adventure","Indie","Simulation","Strategy"],"categories":[{"id":2,"description":"Single-player"},{"id":1,"description":"Multi-player"},{"id":49,"description":"PvP"},{"id":22,"description":"Steam Achievements"},{"id":29,"description":"Steam Trading Cards"},{"id":23,"description":"Steam Cloud"},{"id":15,"description":"Stats"},{"id":44,"description":"Remote Play Together"},{"id":62,"description":"Family Sharing"}]}},"content":{"status":"success","steamAppId":"1133060","steamName":"Anarchy: Wolf's law","sourceUrl":"https://store.steampowered.com/app/1133060/","fetchedAt":"2026-10-16T07:47:06.466343+00:00","locales":{"en":{"status":"source","provider":"steam","shortDescription":"Action. Chaos. Power. Anarchy: Wolf Laws is a dynamic first-person shooter with elements of RPG, survival, and strategic management. Capture territories, upgrade your production, and run your business in a world of total lawlessness.","detailedDescription":"Welcome to a region where there is no government, no law—only power. Every day is a battle for territory, resources, and influence. At night… it’s better not to go outside.\n\nCapture territories, develop production, manage the economy, and eliminate anyone who dares stand in your way. In this world, there are no rules—only the Wolf Law: the strong prevail.\n\nA fast-paced shooter with RPG, survival, and management elements.\n\nCapturing territories\n\nProduction management\n\nDangerous night creatures\n\nCars and racing\n\nDefense\n\nWeapons and Cars\n\nA small industrial hinterland is subject to chaos. Your right to be here must be constantly defended. Step by step you establish your own order in the area, discover new places and improve your character's skills. Remember that you are not the only one who wants to rule here, invite your friends and show them who is boss. You won't play directly with your friends, but that doesn't mean they can't interfere in your gameplay. Set in a new post-apocalyptic sci-fi universe, players will encounter a seamless, open world filled with colorful enemy characters, various mutant categories and a variety of intense and exciting adventures. Unique gameplay allows players to interact while in single-player mode. Try your hand and only the strongest will have power in the region.\n\nWe thank you for your time and for any reviews that you leave us. It's only with your help that we can make something new, wonderful and unique! In the end, thank you for playing the game. I am aware of many shortcomings, but these improvements need time and energy. I am happy to share my game, but please respect the results of my labor.\n\nFeatures of the game:\n\n• \n Active agile first-person shooter.\n\n• \n Strategic and economic gameplay\n\n• \n Ability to compete with friends or with random people in implicit multiplayer mode.\n\n• \nLarge number of weapons. Pistols, submachine guns, submachine guns and machine guns are available to you in the game.\n\n• \n Cars, trucks and helicopters. Use passenger cars to quickly move between locations. You can also use trucks to transport economically important cargo. And only very influential players can afford to maintain a helicopter.\n\n• \n The large open world of 9 square kilometres will be fully accessible, but not every region is safe to be in.\n\n• \n Dynamic change of time of day\n\nThe rules and inner workings of the gameplay:\n\nThe game is structured so that each of the players in the room plays their individual single-player game, but the global positions are synchronised between room members. I.e. if you capture a strategic point, for everyone in the room it is shown as yours, if you have enough resources to strengthen the defense of that point, it will be much harder for all the other players to capture it, because of the increased number of defense bots, or to increase their combat quality, at your expense. You can also increase the redemption cost of a point by investing game money into its development, and it won't be enough for the other players to capture the point, they will have to possess an amount of money higher than the bar you set. For example there is always the choice to strengthen one position but very well or two positions but at an average level. What is the best course of action is up to you.\n\nWhen approaching an objective you will have the choice of passing it in Stealth mode or engaging in an open confrontation in Arcade mode. Stealth mode is favoured in high difficulty areas where reinforced defence forces are more likely to kill you if alerted, but where you can get a lot of bang for your buck if you play stealthily. If you stand on the threshold of a region that you can, feel free to include arcade mode, in which case you will have a place to rebuild near the captured positions, as well as, depending on the training of your character, starting bonuses when revived. Remember, however, that all bonuses have to be paid for in coin.\n\nEach point has a certain economic value. Owning combinations of control points increases their economic potential many times over. With that in mind, it must be understood that not only skillful weaponry will bring you closer to victory, but also the intelligent allocation of economic resources. You'll need to keep the infrastructure of your facilities in good working order to maximise your profits. Infrastructure can be damaged by time or by a rival saboteur if he enters your territory.\n\nOf course you do not always have the time to fight back your rivals, but that is no problem. The mobile app will give you time to deal with economic issues, alert you to attempts to reclaim your landlord.\n\nattempts to recapture your points, to strengthen your point defenses or to collect profit. Profits not yet collected can be stolen by other players. Once they have infiltrated you, they may not be able to take control of the point, but they can rob you or sabotage it, so it's important to keep your finger on the pulse of the game and a mobile app can be a good helper.\n\nSubmit this world to your laws, win economically and by force, crush the anarchy in the region with a firm fist of your power.","aboutGame":null},"vi":{"status":"pending_translation","provider":null,"shortDescription":null,"detailedDescription":null,"aboutGame":null}},"media":{"images":[{"role":"header","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1133060/header.jpg?t=1792031088"},{"role":"capsule","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1133060/capsule_231x87.jpg?t=1792031088"},{"role":"description","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1133060/extras/af7a09e1e9129db904e57d96534a21b7.avif?t=1792031088","alt":""}],"screenshots":[{"id":0,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1133060/ss_b863081bbaf3278b4670eecd0d58dddbe7cae7ac.600x338.jpg?t=1792031088","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1133060/ss_b863081bbaf3278b4670eecd0d58dddbe7cae7ac.1920x1080.jpg?t=1792031088"},{"id":1,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1133060/ss_729fa5b43629bb4c479a7b2bb14adaf5792e9ee6.600x338.jpg?t=1792031088","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1133060/ss_729fa5b43629bb4c479a7b2bb14adaf5792e9ee6.1920x1080.jpg?t=1792031088"},{"id":2,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1133060/ss_7c36c26d991f976b7490b9b2d1841f72862c23cc.600x338.jpg?t=1792031088","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1133060/ss_7c36c26d991f976b7490b9b2d1841f72862c23cc.1920x1080.jpg?t=1792031088"},{"id":3,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1133060/ss_c2de7bb24843e4f7df331ddd0eca345466364b25.600x338.jpg?t=1792031088","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1133060/ss_c2de7bb24843e4f7df331ddd0eca345466364b25.1920x1080.jpg?t=1792031088"},{"id":4,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1133060/ss_09d35640d73fc2d778c79f35b05933bb57aee513.600x338.jpg?t=1792031088","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1133060/ss_09d35640d73fc2d778c79f35b05933bb57aee513.1920x1080.jpg?t=1792031088"},{"id":5,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1133060/ss_2cb1758d53244ead452a7655adc43c59d2b2a34e.600x338.jpg?t=1792031088","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1133060/ss_2cb1758d53244ead452a7655adc43c59d2b2