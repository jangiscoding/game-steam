ompletely 3D with a freely rotating camera","aboutGame":null},"vi":{"status":"pending_translation","provider":null,"shortDescription":null,"detailedDescription":null,"aboutGame":null}},"media":{"images":[{"role":"header","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/254060/header.jpg?t=1622800550"},{"role":"capsule","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/254060/capsule_231x87.jpg?t=1622800550"}],"screenshots":[{"id":0,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/254060/ss_fd4b48d7d9d41e84286a42eb828ac2af2be272a7.600x338.jpg?t=1622800550","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/254060/ss_fd4b48d7d9d41e84286a42eb828ac2af2be272a7.1920x1080.jpg?t=1622800550"},{"id":1,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/254060/ss_536ceb7c97bec3ba248327d7a30a9435af8bb2d9.600x338.jpg?t=1622800550","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/254060/ss_536ceb7c97bec3ba248327d7a30a9435af8bb2d9.1920x1080.jpg?t=1622800550"},{"id":2,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/254060/ss_253976c0caad573e04125ee48d824a3a5d5026f7.600x338.jpg?t=1622800550","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/254060/ss_253976c0caad573e04125ee48d824a3a5d5026f7.1920x1080.jpg?t=1622800550"},{"id":3,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/254060/ss_8664440beec2bb80fa62033a5feae29eaeb0a1d6.600x338.jpg?t=1622800550","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/254060/ss_8664440beec2bb80fa62033a5feae29eaeb0a1d6.1920x1080.jpg?t=1622800550"},{"id":4,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/254060/ss_2b4a2b6ede5685c66372a0858c4da9c94ac8b4b8.600x338.jpg?t=1622800550","url":"https://shared.akamai.steamstatic.com/store_item_assets/stea