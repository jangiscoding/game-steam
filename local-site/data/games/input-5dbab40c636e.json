Steam name for the supplied App ID."],"research":{"steam":{"status":"success","checkedAt":"2026-10-15T10:25:34.145Z","error":null}},"steamMetadata":{"appId":"477730","links":{"store":"https://store.steampowered.com/app/477730/","officialWebsite":"http://www.snowbirdgames.com/eador/?lang=en","support":"http://snowbirdgames.com/"},"storageRequirements":{"kind":"required_free_space","windows":{"minimum":{"value":2,"unit":"GB","display":"2 GB","approximateBytes":2000000000,"evidenceText":"Storage: 2 GB"},"recommended":{"value":4,"unit":"GB","display":"4 GB","approximateBytes":4000000000,"evidenceText":"Storage: 4 GB"}},"macos":{"minimum":null,"recommended":null},"linux":{"minimum":null,"recommended":null},"note":"Steam publishes required free space, not the exact installed or download size."},"controllerSupport":{"level":"unknown","xboxCompatible":null,"xboxEvidence":null,"note":"Generic Steam controller support does not prove Xbox controller compatibility."},"playerModes":{"singlePlayer":true,"multiplayer":false,"coop":false,"onlineCoop":false,"localCoop":false,"lanCoop":false,"sharedOrSplitScreen":false,"pvp":false,"maximumPlayers":null,"maximumPlayersNote":"The public Steam app-details response does not provide a reliable exact player limit.","evidence":["Single-player"]},"genres":["Indie","RPG","Strategy"],"categories":[{"id":2,"description":"Single-player"},{"id":22,"description":"Steam Achievements"},{"id":29,"description":"Steam Trading Cards"},{"id":23,"description":"Steam Cloud"},{"id":17,"description":"Includes level editor"},{"id":62,"description":"Family Sharing"}]}},"content":{"status":"success","steamAppId":"477730","steamName":"Eador. Imperium","sourceUrl":"https://store.steampowered.com/app/477730/","fetchedAt":"2026-10-16T09:20:29.588825+00:00","locales":{"en":{"status":"source","provider":"steam","shortDescription":"Hire heroes, build an army, prevail in battles and try to keep your empire intact in the face of grave danger. Eador. Imperium is a new chapter in Eador series, known for its unique blend of grand strategy, turn-based tactics and RPG elements.","detailedDescription":"Hire heroes, build an army, prevail in battles and try to keep your empire intact in the face of grave danger.\n\nEador. Imperium is a new chapter in Eador series, known for its unique blend of grand strategy, turn-based tactics and RPG elements.\nStory\n\nA young wizard pursuing his revenge against the fanatics who have ruined his life. A barbarian priestess searching for a higher purpose for her people. A mercenary facing the abyss about to consume his home. A governor appointed to rule over a defiant province in times of great crisis.\n\nThreads of their lives will weave a strange pattern, for the destiny of the Imperium is at stake.\nFeatures\n\n• All new and handcrafted story campaign, bringing a fresh approach to the Eador formula.\n\n• New heroes, new units and unique Shard worlds offer even more strategic possibilities and unexpected challenges.\n\n• The ultimate Eador game: Imperium includes all original content from Masters of the Broken World (not counting the campaign).","aboutGame":null},"vi":{"status":"translated","provider":"argos-translate-en_vi-1.9-ctranslate2-int8","translatedAt":"2026-10-16T13:06:39.051385+00:00","sourceHash":"4a0abab2eccc76c5127ea09a0061a3a964d9b9153539e5f0d974250b4e331bde","reviewStatus":"machine_translation_unreviewed","shortDescription":"Thuê những người hùng, xây dựng một đội quân, chiến thắng trong các trận chiến và cố giữ cho đế chế của các người được nguyên vẹn khi đối mặt với nguy hiểm. Edor. Imperium là một chương mới trong chuỗi Edor, được biết đến bởi sự pha trộn độc đáo của chiến lược vĩ đại, chiến thuật theo lượt và yếu tố RPG.","detailedDescription":"Thuê những người hùng, xây dựng một đội quân, chiến thắng trong các trận chiến và cố giữ cho đế chế của các người được nguyên vẹn khi đối mặt với nguy hiểm.\nEdor. Imperium là một chương mới trong chuỗi Edor, được biết đến bởi sự pha trộn độc đáo của chiến lược vĩ đại, chiến thuật theo lượt và yếu tố RPG. Câu chuyện\nMột pháp sư trẻ đang tìm cách trả thù những kẻ cuồng tín đã hủy hoại đời mình. Một nữ tu man rợ đi tìm một mục đích cao cả hơn cho dân tộc cô ta. Một tên lính đánh thuê đang đối mặt với vực sâu để tiêu diệt nhà hắn. Một quan tổng đốc được bổ nhiệm để cai trị một tỉnh ương ngạnh trong thời kỳ khủng hoảng lớn.\nCuộc sống của họ sẽ dệt nên một khuôn mẫu kỳ lạ, vì số phận của Imperium đang bị đe dọa. Tính năng\n• Tất cả các chiến dịch mới và được biên soạn thủ công, mang lại một cách tiếp cận mới cho công thức Edor.\n• Những anh hùng mới, đơn vị mới và những thế giới Shard độc đáo còn đưa ra những khả năng chiến lược hơn và những thử thách bất ngờ.\n• Trò chơi Edor cuối cùng: Imperium bao gồm tất cả nội dung gốc từ Masters of the break World (không tính chiến dịch).","aboutGame":null}},"media":{"images":[{"role":"header","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/477730/header.jpg?t=1571149138"},{"role":"capsule","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/477730/capsule_231x87.jpg?t=1571149138"}],"screenshots":[{"id":0,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/477730/ss_b265272726d98fa66cbe146a4b6876349d1a70c6.600x338.jpg?t=1571149138","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/477730/ss_b265272726d98fa66cbe146a4b6876349d1a70c6.1920x1080.jpg?t=1571149138"},{"id":1,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/477730/ss_46150ee05116b0615b379ee0659626e177365bb1.600x338.jpg?t=1571149138","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/477730/ss_46150ee05116b0615b379ee0659626e177365bb1.1920x1080.jpg?t=1571149138"},{"id":2,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/477730/ss_425d370fde468c290ea5638862ceaa1d55938a55.600x338.jpg?t=1571149138","url":"https://shared.akam