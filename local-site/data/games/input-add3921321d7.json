,"url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/55100/ss_afb32922eefa4aef3fc7f63ab6ba21088b0868e3.1920x1080.jpg?t=1709649918"},{"id":18,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/55100/ss_9b1664da030c0c38027404fe0e12bb4bfd508b1e.600x338.jpg?t=1709649918","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/55100/ss_9b1664da030c0c38027404fe0e12bb4bfd508b1e.1920x1080.jpg?t=1709649918"},{"id":19,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/55100/ss_62301853ab5c9d94b69d829f2a678b852d6f6b41.600x338.jpg?t=1709649918","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/55100/ss_62301853ab5c9d94b69d829f2a678b852d6f6b41.1920x1080.jpg?t=1709649918"},{"id":20,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/55100/ss_fb10cb028f13be42aa9b2717001e7cc3508a6bcf.600x338.jpg?t=1709649918","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/55100/ss_fb10cb028f13be42aa9b2717001e7cc3508a6bcf.1920x1080.jpg?t=1709649918"},{"id":21,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/55100/ss_f8d01ee32b7fb788ace3a040dc7d9b2b290e2753.600x338.jpg?t=1709649918","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/55100/ss_f8d01ee32b7fb788ace3a040dc7d9b2b290e2753.1920x1080.jpg?t=1709649918"},{"id":22,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/55100/ss_6cda91495182c6f844c9d8185705427198f143af.600x338.jpg?t=1709649918","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/55100/ss_6cda91495182c6f844c9d8185705427198f143af.1920x1080.jpg?t=1709649918"},{"id":23,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/55100/ss_865db9cbf8b972e4ded95a52899c62ccc69b6d5f.600x338.jpg?t=1709649918","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps