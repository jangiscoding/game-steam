tus":"identified","verificationNotes":["The supplied name exactly matches the normalized official Steam name for the supplied App ID."],"research":{"steam":{"status":"success","checkedAt":"2026-10-15T10:32:14.730Z","error":null}},"steamMetadata":{"appId":"976730","links":{"store":"https://store.steampowered.com/app/976730/","officialWebsite":"https://www.halowaypoint.com/halo-the-master-chief-collection","support":"https://aka.ms/HaloSupport"},"storageRequirements":{"kind":"required_free_space","windows":{"minimum":{"value":43,"unit":"GB","display":"43 GB","approximateBytes":43000000000,"evidenceText":"Storage: 43 GB"},"recommended":null},"macos":{"minimum":null,"recommended":null},"linux":{"minimum":null,"recommended":null},"note":"Steam publishes required free space, not the exact installed or download size."},"controllerSupport":{"level":"full","xboxCompatible":null,"xboxEvidence":null,"note":"Generic Steam controller support does not prove Xbox controller compatibility."},"playerModes":{"singlePlayer":true,"multiplayer":true,"coop":true,"onlineCoop":true,"localCoop":false,"lanCoop":true,"sharedOrSplitScreen":false,"pvp":true,"maximumPlayers":null,"maximumPlayersNote":"The public Steam app-details response does not provide a reliable exact player limit.","evidence":["Single-player","Multi-player","PvP","Online PvP","LAN PvP","Co-op","Online Co-op","LAN Co-op"]},"genres":["Action"],"categories":[{"id":2,"description":"Single-player"},{"id":1,"description":"Multi-player"},{"id":49,"description":"PvP"},{"id":36,"description":"Online PvP"},{"id":47,"description":"LAN PvP"},{"id":9,"description":"Co-op"},{"id":38,"description":"Online Co-op"},{"id":48,"description":"LAN Co-op"},{"id":27,"description":"Cross-Platform Multiplayer"},{"id":22,"description":"Steam Achievements"},{"id":28,"description":"Full controller support"},{"id":29,"description":"Steam Trading Cards"},{"id":30,"description":"Steam Workshop"},{"id":41,"description":"Remote Play on Phone"},{"id":42,"description":"Remote Play on Tablet"},{"id":43,"description":"Remote Play on TV"},{"id":62,"description":"Family Sharing"}]}},"content":{"status":"success","steamAppId":"976730","steamName":"Halo: The Master Chief Collection","sourceUrl":"https://store.steampowered.com/app/976730/","fetchedAt":"2026-10-16T09:57:20.405790+00:00","locales":{"en":{"status":"source","provider":"steam","shortDescription":"The Master Chief’s iconic journey includes six games, built for PC and collected in a single integrated experience. Whether you’re a long-time fan or meeting Spartan 117 for the first time, The Master Chief Collection is the definitive Halo gaming experience.","detailedDescription":"The series that changed console gaming forever is on PC with six blockbuster games in one epic experience.\n\nPC Settings/Optimizations\n Halo: The Master Chief Collection is now optimized for PC and looking better than ever at up to 4k UHD and at 60+ FPS.* Other setting options include customizable mouse and keyboard support, ultrawide support, FOV customization, and more.\n\nCampaign\n Featuring Halo: Reach, Halo: Combat Evolved Anniversary, Halo 2: Anniversary, Halo 3, Halo 3: ODST Campaign, and Halo 4, The Master Chief Collection offers players their own exciting journey through the epic saga. Starting with the incredible bravery of Noble Six in Halo: Reach and ending with the rise of a new enemy in Halo 4, the Master Chief’s saga totals 67 campaign missions over six critically-acclaimed titles.\n\nMultiplayer\n Each of the six games in The Master Chief Collection brings its own multiplayer maps, modes and game types. With more than 120 multiplayer maps and countless ways to play with community-created Forge content the Collection has the most diverse and expansive Halo multiplayer experience to date.\n\nForge\n Halo’s iconic map editor is improved, refreshed and better than ever. Build new maps with expanded functionality, increased budget, new objects and create new ways to play with custom game modes.**\n\n*Look to system requirements for guidance on hardware minimum specs to achieve performance metrics.\n\n**Forge mode not available in Halo: Combat Evolved Anniversary or Halo 3: ODST.","aboutGame":null},"vi":{"status":"translated","provider":"argos-translate-en_vi-1.9-ctranslate2-int8","translatedAt":"2026-10-16T13:33:56.729285+00:00","sourceHash":"da4bb644e299423e1262f33cb2713483f5e71c4fb199d4ba805a2d50b6105a0b","reviewStatus":"machine_translation_unreviewed","shortDescription":"Hành trình biểu tượng của Thượng Sĩ gồm sáu trận, được xây dựng cho máy tính và thu thập trong một kinh nghiệm tích hợp duy nhất. Dù bạn là người hâm mộ lâu năm hay lần đầu tiên gặp Spartan 117, bộ sưu tập chính là kinh nghiệm chơi trò chơi Halo.","detailedDescription":"Bộ phim đã thay đổi trò chơi điều khiển mãi mãi là trên PC với sáu trò chơi bom tấn trong một kinh nghiệm lịch sử.\nThiết lập máy tính/ lễ rửa tội Halo: Bộ sưu tập chính giờ được tối ưu hóa cho PC và trông tốt hơn bao giờ hết là 4k uhD và tại 60+ FPS.* Những tùy chọn khác bao gồm tùy chỉnh chuột và hỗ trợ bàn phím, hỗ trợ cực đại, tùy biến FOV, và nhiều hơn nữa.\nChiến dịch Haraturing Halo: Reach, Halo: Đấu với Evolvesary, Halo 2: Anniversary, Halo 3, Halo 3: ODST chiến dịch, và Halo 4, The Master Chief collection cho người chơi cuộc hành trình thú vị của riêng họ qua huyền thoại. Bắt đầu với sự dũng cảm đáng kinh ngạc của nhóm 6 ở Halo: vươn tới và kết thúc với sự nổi lên của một kẻ thù mới ở Halo 4, tổng cộng 67 sứ mệnh tranh cử trên sáu tước hiệu lớn.\nNhiều người chơi Mỗi trận đấu trong The Master Chief collect đều mang bản đồ, chế độ và loại trò chơi của mình. Với hơn 120 bản đồ đa người chơi và vô số cách để chơi với những nội dung cộng đồng tạo raForge mà bộ sưu tập có trải nghiệm Halo đa dạng và đa dạng nhất cho đến nay.\nMũ Người biên soạn bản đồ tượng trưng của Halo được cải tiến, làm tươi tỉnh và tốt hơn bao giờ hết. Xây dựng bản đồ mới với chức năng mở rộng, tăng ngân sách, đồ vật mới và tạo ra những cách mới để chơi với chế độ trò chơi tự chọn.**\nHãy xem xét các hệ thống đòi hỏi phải có sự hướng dẫn về số liệu tối thiểu của phần cứng để đạt được các thước đo hiệu suất.\n** Chế độForge không có trong Halo: Chiến đấu Evolved Anniversary hay Halo 3: ODST.","aboutGame":null}},"media":{"images":[{"role":"header","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/976730/header.jpg?t=1791569963"},{"role":"capsule","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/976730/capsule_231x87.jpg?t=1791569963"}],"screenshots":[{"id":0,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/976730/ss_ce40a85f9f7f3fa0f620a87f8919f3212ab8e46e.600x338.jpg?t=1791569963","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/976730/ss_ce40a85f9f7f3fa0f620a87f8919f3212ab8e46e.1920x1080.jpg?t=1791569963"},{"id":1,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/976730/ss_62bbd86f4735893ef6cd53206cf8c93f87eb86ec.600x338.jpg?t=1791569963","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/976730/ss_62bbd86f4735893ef6cd53206cf8c93f87eb86ec.1920x1080.jpg?t=1791569963"},{"id":2,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/976730/ss_fdaf8ebd7f3c62e08398f39c9bfa486294ea5a0a.600x338.jpg?t=1791569963","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/976730/ss_fdaf8ebd7f3c62e08398f39c9bfa486294ea5a0a.1920x1080.jpg?t=1791569963"},{"id":3,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/976730/ss_85da13aef2acd210f95f4b43540967f24d7bed6a.600x338.jpg?t=1791569963","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/976730/ss_85da13aef2acd210f95f4b43540967f24d7bed6a.1920x1080.jpg?t=1791569963"},{"id":4,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/976730/ss_3a4d84cdabf7e015e4409b4218bcd00ba