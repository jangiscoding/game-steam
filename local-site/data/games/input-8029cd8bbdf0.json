tatus":"success","checkedAt":"2026-10-15T10:59:41.778Z","error":null}},"steamMetadata":{"appId":"757310","links":{"store":"https://store.steampowered.com/app/757310/","officialWebsite":"http://sablegame.com/","support":"https://rawfury.atlassian.net/servicedesk/customer/portal/1"},"storageRequirements":{"kind":"required_free_space","windows":{"minimum":{"value":3,"unit":"GB","display":"3 GB","approximateBytes":3000000000,"evidenceText":"Storage: 3 GB"},"recommended":{"value":3,"unit":"GB","display":"3 GB","approximateBytes":3000000000,"evidenceText":"Storage: 3 GB"}},"macos":{"minimum":null,"recommended":null},"linux":{"minimum":null,"recommended":null},"note":"Steam publishes required free space, not the exact installed or download size."},"controllerSupport":{"level":"full","xboxCompatible":null,"xboxEvidence":null,"note":"Generic Steam controller support does not prove Xbox controller compatibility."},"playerModes":{"singlePlayer":true,"multiplayer":false,"coop":false,"onlineCoop":false,"localCoop":false,"lanCoop":false,"sharedOrSplitScreen":false,"pvp":false,"maximumPlayers":null,"maximumPlayersNote":"The public Steam app-details response does not provide a reliable exact player limit.","evidence":["Single-player"]},"genres":["Adventure","Indie","RPG"],"categories":[{"id":2,"description":"Single-player"},{"id":22,"description":"Steam Achievements"},{"id":28,"description":"Full controller support"},{"id":23,"description":"Steam Cloud"},{"id":62,"description":"Family Sharing"}]}},"content":{"status":"success","steamAppId":"757310","steamName":"Sable","sourceUrl":"https://store.steampowered.com/app/757310/","fetchedAt":"2026-10-16T09:43:37.666970+00:00","locales":{"en":{"status":"source","provider":"steam","shortDescription":"Embark on an unique and unforgettable journey and guide Sable through her Gliding; a rite of passage that will take her across vast deserts and mesmerizing landscapes, capped by the remains of spaceships and ancient wonders.","detailedDescription":"Embark on a unique and unforgettable journey and guide Sable through her Gliding; a rite of passage that will take her across vast deserts and mesmerizing landscapes, capped by the remains of spaceships and ancient wonders.\n\nExplore the dunes on your hoverbike, scale monumental ruins and encounter other nomads as you unearth mysteries long forgotten and discover who she really is behind her mask.\n\nWith its unique art style and original soundtrack by Japanese Breakfast, envelop yourself in Sable’s world and explore everything at your own pace. There is a lot in this world just waiting to be discovered. Do not be afraid. Take the leap.\n \n\n• Explore a rich world, full of remnants of past civilisations.\n\n• Climb, leap, hover, glide – use everything at your disposal to discover every inch of the world in front of you\n\n• Customise your hover bike as you find, or earn, new parts\n \n• Help other clans and nomads that you meet along the way\n\n• Lose yourself in an adventure and find yourself through masks, outfits and other collectables, to represent who you are to those around you…\n\n• Complete puzzles to earn rewards and forge your path in an unforgiving terrain\n\n• Try your hand at fishing in the desert, and showcase your collection of bugs and fish in the Vivarium.","aboutGame":null},"vi":{"status":"translated","provider":"argos-translate-en_vi-1.9-ctranslate2-int8","translatedAt":"2026-10-16T13:24:03.054672+00:00","sourceHash":"a978c9e52e8337f0e2eb7c197bce8ef58c1672f63c51eb3a783981d21abae753","reviewStatus":"machine_translation_unreviewed","shortDescription":"Embark trên một hành trình độc đáo và khó quên và hướng dẫn Sible thông qua Gliding của mình; một nghi lễ của đoạn văn sẽ đưa cô vượt qua sa mạc rộng lớn và làm mê hoặc phong cảnh, bị bao phủ bởi những tàn tích của phi thuyền và kỳ quan cổ đại.","detailedDescription":"Embark trên một hành trình độc đáo và không thể quên và hướng dẫn Sible thông qua Gliding của mình; một nghi thức của đoạn văn sẽ đưa cô qua sa mạc rộng lớn và làm mê hoặc phong cảnh, bị bao phủ bởi những tàn tích của phi thuyền và kỳ quan cổ đại.\nKhám phá những cồn cát trên chiếc tàu lượn của anh, những tàn tích quy mô khổng lồ và gặp gỡ những người du mục khác khi anh khám phá những bí ẩn từ lâu bị lãng quên và khám phá ra cô ta thực sự là ai sau mặt nạ của cô ta.\nVới phong cách nghệ thuật độc đáo và âm nhạc ban đầu của bữa sáng Nhật Bản, hãy tự khám phá thế giới của Sable và tự khám phá mọi thứ theo tốc độ của mình. Có rất nhiều thứ trên thế giới này đang chờ được khám phá. Đừng sợ. Nhảy đi.\n\n• Khám phá một thế giới giàu có, đầy dẫy những người còn sót lại trong quá khứ thuộc các nền văn minh.\n• Leo lên, nhảy, lượn lượn lượn, lướt lượn — dùng mọi thứ bạn có để khám phá từng inch của thế giới trước mắt\n• Tuỳ biến chiếc xe đạp bay khi bạn tìm thấy, hoặc kiếm được, những bộ phận mới\n• Giúp đỡ những gia tộc và dân du cư khác mà bạn gặp trên đường đi\n• Tự đánh mất mình trong một cuộc phiêu lưu và tìm thấy bản thân qua mặt nạ, trang phục và những bộ sưu tầm khác, để đại diện cho những người xung quanh bạn...\n• Giải đố đầy đủ để kiếm phần thưởng và uốn nắn con đường của bạn trong một địa hình không tha thứ\n• Hãy thử đánh cá trong sa mạc, và cho thấy bộ sưu tập sâu bọ và cá ở Vivari.","aboutGame":null}},"media":{"images":[{"role":"header","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/757310/header.jpg?t=1792068075"},{"role":"capsule","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/757310/capsule_231x87.jpg?t=1792068075"},{"role":"description","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/757310/extras/8ba161a82f79f60db582c18703e3155d.webp?t=1792068075","alt":""},{"role":"description","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/757310/extras/7cf5f1e556c557a6ed99de5c54967c67.webp?t=1792068075","alt":""}],"screenshots":[{"id":0,"thumbnailUrl":"https://shared.akamai.steamstatic.co