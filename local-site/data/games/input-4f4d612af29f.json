onfidence":"high","status":"identified","verificationNotes":["The supplied name exactly matches the normalized official Steam name for the supplied App ID."],"research":{"steam":{"status":"success","checkedAt":"2026-10-15T10:40:50.664Z","error":null}},"steamMetadata":{"appId":"1335830","links":{"store":"https://store.steampowered.com/app/1335830/","officialWebsite":"https://www.lensisland.com/","support":"https://www.lensisland.com/"},"storageRequirements":{"kind":"required_free_space","windows":{"minimum":{"value":8,"unit":"GB","display":"8 GB","approximateBytes":8000000000,"evidenceText":"Storage: 8 GB"},"recommended":{"value":8,"unit":"GB","display":"8 GB","approximateBytes":8000000000,"evidenceText":"Storage: 8 GB"}},"macos":{"minimum":{"value":8,"unit":"GB","display":"8 GB","approximateBytes":8000000000,"evidenceText":"Storage: 8 GB"},"recommended":{"value":8,"unit":"GB","display":"8 GB","approximateBytes":8000000000,"evidenceText":"Storage: 8 GB"}},"linux":{"minimum":null,"recommended":null},"note":"Steam publishes required free space, not the exact installed or download size."},"controllerSupport":{"level":"unknown","xboxCompatible":null,"xboxEvidence":null,"note":"Generic Steam controller support does not prove Xbox controller compatibility."},"playerModes":{"singlePlayer":true,"multiplayer":true,"coop":true,"onlineCoop":true,"localCoop":false,"lanCoop":false,"sharedOrSplitScreen":false,"pvp":false,"maximumPlayers":null,"maximumPlayersNote":"The public Steam app-details response does not provide a reliable exact player limit.","evidence":["Single-player","Multi-player","Co-op","Online Co-op"]},"genres":["Action","Adventure","Indie","RPG"],"categories":[{"id":2,"description":"Single-player"},{"id":1,"description":"Multi-player"},{"id":9,"description":"Co-op"},{"id":38,"description":"Online Co-op"},{"id":22,"description":"Steam Achievements"},{"id":23,"description":"Steam Cloud"},{"id":62,"description":"Family Sharing"}]}},"content":{"status":"success","steamAppId":"1335830","steamName":"Len's Island","sourceUrl":"https://store.steampowered.com/app/1335830/","fetchedAt":"2026-10-16T07:59:19.761279+00:00","locales":{"en":{"status":"source","provider":"steam","shortDescription":"An open-world survival crafting game for 1–8 players, blending intense dungeon crawling and ARPG combat with peaceful farming and creative building. Take on quests and explore a vast, procedurally-generated world full of danger and discovery.","detailedDescription":"With only the tools in your backpack and a can-do attitude, begin a new life on a mysterious archipelago of islands. As you explore uncharted lands, you are free to choose your path and shape your own journey.\n\nEmbark on your journey solo or team up with up to 7 friends in seamless online co-op. Len’s Island is carefully balanced for both singleplayer and multiplayer, offering a rewarding experience whether you're building alone or battling alongside others.\n\nWhether you're a fearless warrior, creative builder, or skilled farmer, your choices shape your adventure. Explore the world at your own pace, refine your skillset, and advance through a flexible progression system guided by your preferred playstyle. \n\nFrom peaceful to hardcore, select the difficulty that fits your style, or fully personalize your game by adjusting the world settings to unlock infinite possibilities.\n\nMaster the art of crafting and enchanting to create powerful weapons, sturdy armor, and essential survival tools. Gather resources from the environment, refine them, and combine them in endless ways to suit your playstyle. Prepare food, brew potions, and upgrade your gear as you progress, ensuring you are ready to take on the next great challenge.\n\nDescend into dangerous dungeons to defeat challenging bosses and unlock valuable loot. Each run is a test of skill and preparation, where strategy and perseverance determine success. Uncover hidden lore, complete unique quests, and earn powerful upgrades that will aid you in both combat and survival. The further you go, the greater the risks and the rewards.\n\nConstruct your perfect homestead, from a cozy farm to a sprawling network of fortified strongholds. Customize your buildings with a variety of build styles, then collect and purchase decorations to make your house feel like home. When harvest moons rise, build powerful defense systems to protect your base from enemy raids and claim the rewards of the full moon.\n\nCreate your own adventure by completing quests that take you off the beaten path. Obtain unique rewards for fulfilling challenging objectives and track your progress in the compendium. There’s more than one way to progress in Len’s Island.\n\nAre you ready to conquer the island and uncover its mysteries? Dive into Len's Island, where every choice shapes your destiny. Whether you're seeking intense combat, creative building, or a survival experience, the island awaits your arrival. Your adventure begins now.","aboutGame":null},"vi":{"status":"translated","provider":"argos-translate-en_vi-1.9-ctranslate2-int8","translatedAt":"2026-10-16T10:54:25.287439+00:00","sourceHash":"7aa4f1a68855b67ed51f95471314c22d761f4b97980fb65692c4bed20bc19ce2","reviewStatus":"machine_translation_unreviewed","shortDescription":"Một trò chơi sinh tồn mở rộng cho 1–8 người chơi, hòa nhập với ngục tối bò và ARPG với nền nông nghiệp hòa bình và xây dựng sáng tạo.  Tìm kiếm và khám phá một thế giới được thiết kế theo thủ tục rộng lớn đầy nguy hiểm và khám phá.","detailedDescription":"Chỉ với những dụng cụ trong ba lô của bạn và thái độ can-do của bạn, bắt đầu một cuộc sống mới trên quần đảo bí ẩn.  Khi bạn khám phá những vùng đất chưa được khám phá, bạn được tự do lựa chọn con đường của mình và định hình hành trình của chính mình.\nEmbark trên hành trình của bạn một mình hoặc một đội với 7 người bạn trong liên doanh trực tuyến.  Đảo Len được cân bằng một cách cẩn thận cho cả người chơi và nhiều người chơi, cung cấp một trải nghiệm bổ ích cho dù bạn đang xây dựng một mình hoặc chiến đấu cùng với những người khác.\nCho dù bạn là một chiến binh dũng cảm, người xây dựng sáng tạo, hay nông dân lành nghề, sự lựa chọn của bạn định hình cuộc phiêu lưu của bạn.  Khám phá thế giới theo tốc độ của riêng bạn, tinh luyện các kỹ năng của bạn, và tiến bộ thông qua một hệ thống tiến bộ linh hoạt được hướng dẫn bởi kiểu chơi bạn thích.\nTừ yên bình đến cứng rắn, hãy chọn những khó khăn phù hợp với phong cách của bạn, hoặc hoàn toàn cá nhân hóa trò chơi của bạn bằng cách điều chỉnh các thiết lập thế giới để mở ra những khả năng vô tận.\nLàm chủ nghệ thuật chế tạo và hấp dẫn để tạo ra vũ khí mạnh mẽ, giáp cứng rắn, và những công cụ thiết yếu để tồn tại. Thu thập tài nguyên từ môi trường, tinh luyện chúng, và kết hợp chúng với nhau một cách vô tận để phù hợp với kiểu chơi của bạn.  Chuẩn bị thực phẩm, thuốc pha, và nâng cấp thiết bị của bạn khi bạn đang tiến hành, đảm bảo bạn sẵn sàng để tiếp tục thử thách lớn tiếp theo.\nXuống hầm ngục nguy hiểm để đánh bại các ông chủ và mở khóa cho những chiến lợi phẩm giá trị.  Mỗi cuộc chạy là một thử thách về kỹ năng và sự chuẩn bị, nơi mà chiến lược và sự bền bỉ quyết định thành công.  Những truyền thuyết chưa được khám phá, những nhiệm vụ hoàn thành, và có được những nâng cấp mạnh mẽ để giúp bạn trong cả chiến đấu lẫn tồn tại.  Càng đi xa, bạn càng có nhiều rủi ro và phần thưởng.\nXây dựng căn nhà hoàn hảo của bạn, từ một trang trại ấm cúng đến một mạng lưới kiên cố. Tuỳ biến các tòa nhà của bạn với nhiều kiểu xây dựng khác nhau, rồi thu thập và mua đồ trang trí để làm cho nhà bạn cảm thấy như nhà bạn.  Khi trăng tròn, xây dựng hệ thống phòng thủ mạnh mẽ để bảo vệ căn cứ của bạn khỏi các cuộc tấn công của kẻ thù và giành lấy phần thưởng của trăng tròn.\nTạo ra cuộc phiêu lưu của riêng bạn bằng cách hoàn thành nhiệm vụ mà sẽ khiến bạn lạc lối.  Hãy dành những phần thưởng độc nhất vô nhị để hoàn thành những mục tiêu khó khăn và theo dõi sự tiến bộ của bạn trong các hợp chất.  Có nhiều cách để tiến bộ ở đảo Len.\nNgươi đã sẵn sàng chinh phục hòn đảo và khám phá những bí ẩn của nó chưa?  Lặn xuống hòn đảo của Len, nơi mà mọi lựa chọn định đoạt số phận của bạn. Cho dù bạn đang tìm kiếm chiến đấu mãnh liệt, xây dựng một tòa nhà sáng tạo, hay một trải nghiệm sống sót, hòn đảo đang chờ bạn đến.  Cuộc phiêu lưu bắt đầu từ bây giờ.","aboutGame":null}},"media":{"images":[{"role":"header","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1335830/0ba673c67110e0de186ba545594f4d4009234f5a/header.jpg?t=1788194921"},{"role":"capsule","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1335830/6c67b110da1f192297e5f3a385fc584f0fc61f56/capsule_231x87.jpg?t=1788194921"},{"role":"description","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1335830/extras/1c3d9b0837b2bfb2c10e5b973c768d0c.webp?t=1788194921","alt":""},{"role":"description","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1335830/extras/97b72b5f49440673b101e7cf5fb34e0e.webp?t=1788194921","alt":""},{"role":"description","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1335830/extras/48166c06baf35703aaa831bfd5ca6202.webp?t=1788194921","alt":""},{"role":"description","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1335830/extras/1b531e80c561be1a37d2c79370a1c087.webp?t=1788194921","alt":""},{"role":"description","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1335830/extras/85b2cb3c6bda586e62c89f26c13eea9f.webp?t=1788194921","alt":""}],"screenshots":[{"id":0,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1335830/abb0482bdb048a3c8c3dc78646e8c55f2a3d0bb3/ss_abb0482bdb048a3c8c3dc78646e8c55f2a3d0bb3.600x338.jpg?t=1788194921","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1335830/abb0482bdb048a3c8c3dc78646e8c55f2a3d0bb3/ss_abb0482bdb048a3c8c3dc78646e8c55f2a3d0bb3.1920x1080.