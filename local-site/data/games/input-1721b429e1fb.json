:["The supplied name exactly matches the normalized official Steam name for the supplied App ID."],"research":{"steam":{"status":"success","checkedAt":"2026-10-15T10:38:44.149Z","error":null}},"steamMetadata":{"appId":"25900","links":{"store":"https://store.steampowered.com/app/25900/","officialWebsite":"http://www.kingsbountygame.com/","support":"http://www.fulqrumpublishing.com/support"},"storageRequirements":{"kind":"required_free_space","windows":{"minimum":{"value":5.5,"unit":"GB","display":"5.5 GB","approximateBytes":5500000000,"evidenceText":"Hard Drive: 5.5 GB"},"recommended":null},"macos":{"minimum":{"value":2.54,"unit":"GB","display":"2.54 GB","approximateBytes":2540000000,"evidenceText":"Hard Disk Space: 2.54 GB"},"recommended":null},"linux":{"minimum":null,"recommended":null},"note":"Steam publishes required free space, not the exact installed or download size."},"controllerSupport":{"level":"unknown","xboxCompatible":null,"xboxEvidence":null,"note":"Generic Steam controller support does not prove Xbox controller compatibility."},"playerModes":{"singlePlayer":true,"multiplayer":false,"coop":false,"onlineCoop":false,"localCoop":false,"lanCoop":false,"sharedOrSplitScreen":false,"pvp":false,"maximumPlayers":null,"maximumPlayersNote":"The public Steam app-details response does not provide a reliable exact player limit.","evidence":["Single-player"]},"genres":["RPG","Strategy"],"categories":[{"id":2,"description":"Single-player"},{"id":22,"description":"Steam Achievements"},{"id":29,"description":"Steam Trading Cards"},{"id":30,"description":"Steam Workshop"},{"id":23,"description":"Steam Cloud"},{"id":62,"description":"Family Sharing"}]}},"content":{"status":"success","steamAppId":"25900","steamName":"King's Bounty: The Legend","sourceUrl":"https://store.steampowered.com/app/25900/","fetchedAt":"2026-10-16T08:42:32.940622+00:00","locales":{"en":{"status":"source","provider":"steam","shortDescription":"King’s Bounty: The Legend is a fan-favorite classic fantasy adventure and an early entry into the modern King’s Bounty era, built around tough battles, smart decisions, and turn-based tactics.","detailedDescription":"King’s Bounty: The Legend is a fan-favorite classic fantasy adventure and an early entry into the modern King’s Bounty era, built around tough battles, smart decisions, and turn-based tactics.  \n\nYou play as a royal treasure hunter, sent to explore the lands of Endoria in search of gold, glory, and ancient secrets. Your journey takes you through lively towns, untamed wilderness, and perilous dungeons, each playing a role in a story that begins simply but grows into a tale filled with twists, surprises, and a memorable ending.\n\nYour adventure in Endoria blends real-time exploration with turn-based tactical combat. The world feels alive as you travel, while battles focus on positioning, morale, army composition, and smart use of magic. Success depends on preparation and strategy rather than quick reactions.\n\nChoose from three different hero types - Warrior, Paladin, or Mage - each offering a distinct playstyle, unique abilities, and different approaches to progression. A wide variety of creatures, spells, and artifacts allows you to experiment with strategies and build armies that suit your preferred way of playing, giving the game strong replay value.\n\nKing’s Bounty: The Legend invites you to become a hero in a fantasy world of fearless knights, evil mages, wise kings and beautiful princesses. Explore the land, command armies and accomplish quests for your king to reap great rewards... Or suffer devastating defeats.\n\nKey Features:\n\n• \nReal-time exploration meets turn-based tactical battles: Freely explore the world in real time, then switch to deep, turn-based combat where positioning, timing, and preparation decide the outcome.\n\n• \nDeep, puzzle-like tactical combat: Battles are built around smart decisions, army composition, spell usage, and morale - not reflexes or brute force.\n\n• \nAddictive “one more battle” progression loop: Constant rewards, new units, artifacts, spells, and upgrades create a steady sense of progress that keeps the adventure moving forward.\n\n• \nMeaningful army-building and unit synergies: Recruit a wide variety of creatures and build armies around morale bonuses, abilities, and tactical combinations.\n\n• \nThree distinct hero classes: Play as a Warrior, Paladin, or Mage - each offering unique strengths, skills, and different approaches to combat and progression.\n\n• \nA large hand-crafted fantasy world: Dozens of locations and battlefields - both on the surface and in the dungeons. Travel through towns, wild landscapes, and dangerous dungeons filled with quests, secrets, and powerful rewards.\n\n• \nA dynamic world that doesn’t wait for the player: Enemies roam the map, pursue their own goals, and actively stand in your way, turning exploration into part of the challenge.","aboutGame":null},"vi":{"status":"pending_translation","provider":null,"shortDescription":null,"detailedDescription":null,"aboutGame":null}},"media":{"images":[{"role":"header","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/25900/e50870d24fc62347f2d6f7bf11609e2510467cb8/header.jpg?t=1785331424"},{"role":"capsule","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/25900/060cb16925874f30d19ca6208757f4abdc7f1cf8/capsule_231x87.jpg?t=1785331424"}],"screenshots":[{"id":0,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/25900/d9ec3d81636d8d2c80cbb0b507d6e058e95fced2/ss_d9ec3d81636d8d2c80cbb0b507d6e058e95fced2.600x338.jpg?t=1785331424","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/25900/d9ec3d81636d8d2c80cbb0b507d6e058e95fced2/ss_d9ec3d81636d8d2c80cbb0b507d6e058e95fced2.1920x1080.jpg?t=1785331424"},{"id":1,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/25900/74f5e25e8cf661ca9f966c5b3120cc962235df19/ss_74f5e25e8cf661ca9