pplied name exactly matches the normalized official Steam name for the supplied App ID."],"research":{"steam":{"status":"success","checkedAt":"2026-10-15T09:55:57.363Z","error":null}},"steamMetadata":{"appId":"672630","links":{"store":"https://store.steampowered.com/app/672630/","officialWebsite":"http://www.academiagame.com/","support":"https://support.paradoxplaza.com/"},"storageRequirements":{"kind":"required_free_space","windows":{"minimum":{"value":400,"unit":"MB","display":"400 MB","approximateBytes":400000000,"evidenceText":"Storage: 400 MB"},"recommended":{"value":400,"unit":"MB","display":"400 MB","approximateBytes":400000000,"evidenceText":"Storage: 400 MB"}},"macos":{"minimum":{"value":400,"unit":"MB","display":"400 MB","approximateBytes":400000000,"evidenceText":"Storage: 400 MB"},"recommended":{"value":400,"unit":"MB","display":"400 MB","approximateBytes":400000000,"evidenceText":"Storage: 400 MB"}},"linux":{"minimum":null,"recommended":null},"note":"Steam publishes required free space, not the exact installed or download size."},"controllerSupport":{"level":"unknown","xboxCompatible":null,"xboxEvidence":null,"note":"Generic Steam controller support does not prove Xbox controller compatibility."},"playerModes":{"singlePlayer":true,"multiplayer":false,"coop":false,"onlineCoop":false,"localCoop":false,"lanCoop":false,"sharedOrSplitScreen":false,"pvp":false,"maximumPlayers":null,"maximumPlayersNote":"The public Steam app-details response does not provide a reliable exact player limit.","evidence":["Single-player"]},"genres":["Indie","Simulation","Strategy"],"categories":[{"id":2,"description":"Single-player"},{"id":22,"description":"Steam Achievements"},{"id":29,"description":"Steam Trading Cards"},{"id":30,"description":"Steam Workshop"},{"id":23,"description":"Steam Cloud"},{"id":62,"description":"Family Sharing"}]}},"content":{"status":"success","steamAppId":"672630","steamName":"Academia : School Simulator","sourceUrl":"https://store.steampowered.com/app/672630/","fetchedAt":"2026-10-16T09:37:05.482379+00:00","locales":{"en":{"status":"source","provider":"steam","shortDescription":"Design, build, and manage a high school with terrific teachers and fantastic facilities or simply let your students poop in the bushes? Academia : School Simulator is a management/tycoon game where you get to decide!","detailedDescription":"Build a high school with fantastic facilities like science labs, basketball courts, and art rooms, or do the bare minimum and live off government subsidies!  Will you offer your delinquent students counseling, or simply send them to detention to let them waste their lives away? Will you hire the best teachers or cheap out and build giant classrooms with a 1:100 teacher to student ratio? Will you build enough toilets, or snicker as your students are forced to relieve themselves in the bushes? The choice is yours!\n\nAcademia : School Simulator is a cheerful yet challenging management game from the artist of Prison Architect and the studio that brought you Political Animals.\n\nStudent motivation is driven by various needs, including hygiene, hunger, and discipline, and they'll become even more complex as time goes on, eventually competing in school competitions like spelling bees and even falling in love.\n\nTeachers are unique, with different subject specialties and degrees. Eventually they will also have their own motivations that need to be satisfied so they can keep teaching at the highest level.\n\nBuild Canteens, Clinics, Computer Labs, Common Areas and much more as you create your dream Educational Complex.\n\nDo you think the janitors aren't doing a good job? Plot out their routes yourself in order to ensure maximum efficiency.\n\nFrom potted plants to statues and fountains, we have everything to make your school the envy of all! And we'll keep adding decorative objects so that you can have a completely unique school.\n\nStudents that look like zombies and eat brains? why not? Want to run a school where the students are literally prisoners? Whatever floats your boat!  Image mods are available now, and language and other mods will follow in the future.\n\nCustomize your school seal and motto to make a school that is uniquely yours! \n\nNormal mode requires you to balance your budget and provide the best education that you can with your money, while sandbox lets you go utopian with unlimited money!","aboutGame":null},"vi":{"status":"pending_translation","provider":null,"shortDescription":null,"detailedDescription":null,"aboutGame":null}},"media":{"images":[{"role":"header","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/672630/header.jpg?t=1726498028"},{"role":"capsule","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/672630/capsule_231x87.jpg?t=1726498028"},{"role":"description","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/672630/extras/cb1faa19c92b33c5a8cc860ccdd63763.avif?t=1726498028","alt":""},{"role":"description","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/672630/extras/c16e706dbc2f5fd5304da795d645de82.avif?t=1726498028","alt":""},{"role":"description","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/672630/extras/693ea753c890cdb79883e1a3f6352a08.avif?t=1726498028","alt":""},{"role":"description","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/672630/extras/69b8e011ffdaaf7f196df9a1c8c10318.avif?t=1726498028","alt":""},{"role":"description","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/672630/extras/b5104e1fa4bd02161bbfae6c48765a1c.avif?t=1726498028","alt":""},{"role":"description","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/672630/extras/03dadee2a3769fbf90220976609f22a5.avif?t=1726498028","alt":""},{"role":"description","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/672630/extras/c808c57161875fe47b2491d5cd8