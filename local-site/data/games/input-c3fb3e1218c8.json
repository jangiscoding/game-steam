{"id":"input-c3fb3e1218c8","steamAppId":"1210320","name":"Potion Craft: Alchemist Simulator","imageUrl":"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/1210320/library_600x900.jpg","imageStatus":"downloaded","steamUrl":"https://store.steampowered.com/app/1210320/","genres":["Indie","Simulation"],"platforms":["windows"],"controllerSupport":"partial","playerModes":{"singlePlayer":true,"multiplayer":false,"coop":false,"localCoop":false,"sharedOrSplitScreen":false,"onlineCoop":false,"maximumPlayers":null},"storage":{"windowsMinimumGB":2.0,"windowsMinimumDisplay":"2 GB"},"verificationStatus":"identified","custom":{},"sourceProfile":{"inputRecordId":"input-c3fb3e1218c8","canonicalId":"steam-app-1210320","suppliedName":"Potion Craft: Alchemist Simulator","suppliedImageUrl":"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/1210320/library_600x900.jpg","officialName":"Potion Craft: Alchemist Simulator","aliases":[],"series":null,"franchise":null,"productType":"game","editionName":null,"originalReleaseYear":null,"identifiedVersionReleaseYear":2022,"developers":["niceplay games"],"publishers":["tinyBuild"],"platforms":["windows"],"genres":["Indie","Simulation"],"shortDescription":"Potion Craft is an alchemist simulator where you physically interact with your tools and ingredients to brew potions. You're in full control of the whole shop: invent new recipes, attract customers and experiment to your heart's content. Just remember: the whole town is counting on you.","confusingWith":[],"candidateIdentifiers":{"steamAppId":"1210320"},"sources":[{"label":"Steam Store","url":"https://store.steampowered.com/app/1210320/","accessedAt":"2026-10-15T10:54:19.456Z","supports":["officialName","productType","identifiedVersionReleaseYear","developers","publishers","platforms","genres","shortDescription","steamMetadata.links","steamMetadata.storageRequirements","steamMetadata.controllerSupport","steamMetadata.playerModes"]}],"confidence":"high","status":"identified","verificationNotes":["The supplied name exactly matches the normalized official Steam name for the supplied App ID."],"research":{"steam":{"status":"success","checkedAt":"2026-10-15T10:54:19.456Z","error":null}},"steamMetadata":{"appId":"1210320","links":{"store":"https://store.steampowered.com/app/1210320/","officialWebsite":"https://www.potioncraft.com/","support":null},"storageRequirements":{"kind":"required_free_space","windows":{"minimum":{"value":2,"unit":"GB","display":"2 GB","approximateBytes":2000000000,"evidenceText":"Storage: 2 GB"},"recommended":null},"macos":{"minimum":null,"recommended":null},"linux":{"minimum":null,"recommended":null},"note":"Steam publishes required free space, not the exact installed or download size."},"controllerSupport":{"level":"partial","xboxCompatible":null,"xboxEvidence":null,"note":"Generic Steam controller support does not prove Xbox controller compatibility."},"playerModes":{"singlePlayer":true,"multiplayer":false,"coop":false,"onlineCoop":false,"localCoop":false,"lanCoop":false,"sharedOrSplitScreen":false,"pvp":false,"maximumPlayers":null,"maximumPlayersNote":"The public Steam app-details response does not provide a reliable exact player limit.","evidence":["Single-player"]},"genres":["Indie","Simulation"],"categories":[{"id":2,"description":"Single-player"},{"id":22,"description":"Steam Achievements"},{"id":29,"description":"Steam Trading Cards"},{"id":67,"description":"Camera Comfort"},{"id":66,"description":"Color Alternatives"},{"id":68,"description":"Custom Volume Controls"},{"id":78,"description":"Adjustable Difficulty"},{"id":76,"description":"Mouse Only Option"},{"id":74,"description":"Playable without Timed Input"},{"id":55,"description":"DualShock Controller Support"},{"id":56,"description":"DualShock Controller Support"},{"id":57,"description":"DualSense Controller Support"},{"id":58,"description":"DualSense Controller Support"},{"id":79,"description":"Save Anytime"},{"id":77,"description":"Touch Only Option"},{"id":18,"description":"Partial Controller Support"},{"id":23,"description":"Steam Cloud"},{"id":62,"description":"Family Sharing"}]}},"content":{"status":"success","steamAppId":"1210320","steamName":"Potion Craft: Alchemist Simulator","sourceUrl":"https://store.steampowered.com/app/1210320/","fetchedAt":"2026-10-16T07:52:29.934926+00:00","locales":{"en":{"status":"source","provider":"steam","shortDescription":"Potion Craft is an alchemist simulator where you physically interact with your tools and ingredients to brew potions. You're in full control of the whole shop: invent new recipes, attract customers and experiment to your heart's content. Just remember: the whole town is counting on you.","detailedDescription":"Upcoming features\n\nIntroduced in v2.0\n\nAbout the Game\n\nFeatures:\n\n• \nUnique visuals inspired by medieval manuscripts and medical books.\n\n• \nHyper satisfying physical interactions with ingredients and equipment.\n\n• \nSandbox style gameplay where you have many different avenues available, and it’s up to you to figure out the best way to complete each task.\n\n• \nSell your potions to the townsfolk while roleplaying as a noble artisan, a greedy weasel, an occult dark master, or whomever else you may wish to be!\n\nWork with all sorts of ingredients\n\nLeaves, flowers, berries, roots, fruits, minerals, and a plethora of mushrooms are at the ready for your mortar and pestle. Just like espresso, the fineness of the grind matters!\n\nLearn the art of potion making\n\nConcoct your potion plan. Grind ingredients and carefully mix them in your cauldron. Heat the coals. Boil and stir. Add the base: water, oil, or… something else. Congrats on your first potion! Was it easy to learn? Now try mastering it!\n\nExperiment and invent new recipes\n\nCarefully plan your route via the Alchemy Map to combine different effects. Be mindful of common sense: you won’t find a market for a poisonous healing potion… right? Or would you?\n\nSell potions\n\nEvery day customers will come to your store looking for solutions to their problems. You will face consequences depending on what you decide to sell them. Attract guilds, befriend notable figures (or feud with them), gain riches and influence - and one day, you may even decide the fate of the whole town.\n\nBuy ingredients or grow your own\n\nEvery alchemist needs ingredients, and there are many ways to get them! You can buy them from traveling merchants: it can be pricey, but successful haggling may save you some coin. Or take matters into your own hands and cultivate your very own enchanted garden. Grow a variety of ingredients, from vibrant herbs to exotic mushrooms and even magical crystals, each essential for brewing your unique potions!\n\nGet creative with customization\n\nWant to give your best potions a special look? Go for it! Change the bottle shape, label type, icon and colours. You can even give it a custom name and label description. Carefully arrange your unique potions to showcase them on your shop's shelves and tables... or go a step further and customize your shop itself! Choose from a variety of furniture and shelving to give your alchemy shop a personal touch that matches your style. We won't tell you what to do, just have fun!","aboutGame":"Features:\n\n• \nUnique visuals inspired by medieval manuscripts and medical books.\n\n• \nHyper satisfying physical interactions with ingredients and equipment.\n\n• \nSandbox style gameplay where you have many different avenues available, and it’s up to you to figure out the best way to complete each task.\n\n• \nSell your potions to the townsfolk while roleplaying as a noble artisan, a greedy weasel, an occult dark master, or whomever else you may wish to be!\n\nWork with all sorts of ingredients\n\nLeaves, flowers, berries, roots, fruits, minerals, and a plethora of mushrooms are at the ready for your mortar and pestle. Just like espresso, the fineness of the grind matters!\n\nLearn the art of potion making\n\nConcoct your potion plan. Grind ingredients and carefully mix them in your cauldron. Heat the coals. Boil and stir. Add the base: water, oil, or… something else. Congrats on your first potion! Was it easy to learn? Now try mastering it!\n\nExperiment and invent new recipes\n\nCarefully plan your route via the Alchemy Map to combine different effects. Be mindful of common sense: you won’t find a market for a poisonous healing potion… right? Or would you?\n\nSell potions\n\nEvery day customers will come to your store looking for solutions to their problems. You will face consequences depending on what you decide to sell them. Attract guilds, befriend notable figures (or feud with them), gain riches and influence - and one day, you may even decide the fate of the whole town.\n\nBuy ingredients or grow your own\n\nEvery alchemist needs ingredients, and there are many ways to get them! You can buy them from traveling merchants: it can be pricey, but successful haggling may save you some coin. Or take matters into your own hands and cultivate your very own enchanted garden. Grow a variety of ingredients, from vibrant herbs to exotic mushrooms and even magical crystals, each essential for brewing your unique potions!\n\nGet creative with customization\n\nWant to give your best potions a special look? Go for it! Change the bottle shape, label type, icon and colours. You can even give it a custom name and label description. Carefully arrange your unique potions to showcase them on your shop's shelves and tables... or go a step further and customize your shop itself! Choose from a variety of furniture and shelving to give your alchemy shop a personal touch that matches your style. We won't tell you what to do, just have fun!"},"vi":{"status":"pending_translation","provider":null,"shortDescription":null,"detailedDescription":null,"aboutGame":null}},"media":{"images":[{"role":"header","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1210320/header.jpg?t=1786023837"},{"role":"capsule","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1210320/capsule_231x87.jpg?t=1786023837"},{"role":"description","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1210320/extras/d8d994068b38e81b8dc5ae6270ed3f25.avif?t=1786023837","alt":""},{"role":"description","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1210320/extras/0abfe894a0433dbc1bbd27861a69f678.avif?t=1786023837","alt":""}],"screenshots":[{"id":0,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1210320/ss_a5197ad5bb35e9899c9e751820cdb9dbc0ceb308.600x338.jpg?t=1786023837","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1210320/ss_a5197ad5bb35e9899c9e751820cdb9dbc0ceb308.1920x1080.jpg?t=1786023837"},{"id":1,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1210320/ss_594f4f435a27c625e0f5c8d3603883c9e293b967.600x338.jpg?t=1786023837","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1210320/ss_594f4f435a27c625e0f5c8d3603883c9e293b967.1920x1080.jpg?t=1786023837"},{"id":2,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1210320/ss_a0c1d496af8071557b72dae3dc3f7c01aa9d9c0a.600x338.jpg?t=1786023837","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1210320/ss_a0c1d496af8071557b72dae3dc3f7c01aa9d9c0a.1920x1080.jpg?t=1786023837"},{"id":3,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1210320/ss_f447d0b33536c3c8137eff3fd21be5126955c8b3.600x338.jpg?t=1786023837","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1210320/ss_f447d0b33536c3c8137eff3fd21be5126955c8b3.1920x1080.jpg?t=1786023837"},{"id":4,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1210320/ss_8f4f9d55123855952e4c83710b6801f6ffab1965.600x338.jpg?t=1786023837","url":"https://sha