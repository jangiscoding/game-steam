fficial Steam name for the supplied App ID."],"research":{"steam":{"status":"success","checkedAt":"2026-10-15T10:47:25.351Z","error":null}},"steamMetadata":{"appId":"633230","links":{"store":"https://store.steampowered.com/app/633230/","officialWebsite":"https://www.bandainamcoent.com/games/naruto-to-boruto-shinobi-striker","support":"https://www.bandainamcoent.com/support"},"storageRequirements":{"kind":"required_free_space","windows":{"minimum":{"value":40,"unit":"GB","display":"40 GB","approximateBytes":40000000000,"evidenceText":"Storage: 40 GB"},"recommended":{"value":40,"unit":"GB","display":"40 GB","approximateBytes":40000000000,"evidenceText":"Storage: 40 GB"}},"macos":{"minimum":null,"recommended":null},"linux":{"minimum":null,"recommended":null},"note":"Steam publishes required free space, not the exact installed or download size."},"controllerSupport":{"level":"partial","xboxCompatible":null,"xboxEvidence":null,"note":"Generic Steam controller support does not prove Xbox controller compatibility."},"playerModes":{"singlePlayer":true,"multiplayer":true,"coop":true,"onlineCoop":true,"localCoop":false,"lanCoop":false,"sharedOrSplitScreen":false,"pvp":true,"maximumPlayers":null,"maximumPlayersNote":"The public Steam app-details response does not provide a reliable exact player limit.","evidence":["Single-player","Multi-player","PvP","Online PvP","Co-op","Online Co-op"]},"genres":["Action"],"categories":[{"id":2,"description":"Single-player"},{"id":1,"description":"Multi-player"},{"id":49,"description":"PvP"},{"id":36,"description":"Online PvP"},{"id":9,"description":"Co-op"},{"id":38,"description":"Online Co-op"},{"id":22,"description":"Steam Achievements"},{"id":18,"description":"Partial Controller Support"},{"id":62,"description":"Family Sharing"}]}},"content":{"status":"success","steamAppId":"633230","steamName":"NARUTO TO BORUTO: SHINOBI STRIKER","sourceUrl":"https://store.steampowered.com/app/633230/","fetchedAt":"2026-10-16T09:34:25.119364+00:00","locales":{"en":{"status":"source","provider":"steam","shortDescription":"Battle as a team of 4 to compete against other teams online! Graphically, SHINOBI STRIKER is also built from the ground up in a completely new graphic style. Lead your team and fight online to see who the best ninjas are!","detailedDescription":"Latest Updates\n\nCelebrate NARUTO TO BORUTO: SHINOBI STRIKER's 8th anniversary! Naruto Uzumaki (Sage Mode) joins as a playable character in a free update!\n\nPurchase Season Pass 10 and receive Secret Technique Majestic Attire: Susano'o as a bonus! Learn ninjutsu from 4 different masters including Jiraiya (Sage Mode) and Naruto Uzumaki (Sage Mode) and train your own original ninja!\n\nDeluxe Edition & Ultimate Edition\n\nThe Deluxe Edition includes:\n• NARUTO TO BORUTO: SHINOBI STRIKER (full game)\n• Season Pass 1\n\nThe Ultimate Edition includes:\n• NARUTO TO BORUTO: SHINOBI STRIKER (full game)\n• Season Pass 1\n• Season Pass 2\n• Season Pass 3\n• Season Pass 4\n\nAbout the Game\n\nThe Naruto franchise is back with a brand new experience in NARUTO TO BORUTO: SHINOBI STRIKER! This new game lets gamers battle as a team of 4 to compete against other teams online! Graphically, SHINOBI STRIKER is also built from the ground up in a completely new graphic style. Lead your team and fight online to see who the best ninjas are!","aboutGame":"The Naruto franchise is back with a brand new experience in NARUTO TO BORUTO: SHINOBI STRIKER! This new game lets gamers battle as a team of 4 to compete against other teams online! Graphically, SHINOBI STRIKER is also built from the ground up in a completely new graphic style. Lead your team and fight online to see who the best ninjas are!"},"vi":{"status":"translated","provider":"argos-translate-en_vi-1.9-ctranslate2-int8","translatedAt":"2026-10-16T13:17:04.031417+00:00","sourceHash":"7fa2065b5eb18d4cb5df069aaf155013ad7b2557a2ace1065760567aed5e6032","reviewStatus":"machine_translation_unreviewed","shortDescription":"Chiến đấu như một đội 4 để cạnh tranh với các đội khác trực tuyến! Theo giao diện đồ họa, SHINOIB SIS SISKER cũng được xây dựng từ mặt đất lên theo một kiểu đồ họa hoàn toàn mới. Dẫn đội của anh và chiến đấu trực tuyến để xem ai là những ninja giỏi nhất!","detailedDescription":"Cập nhật mới nhất\nKỷ niệm 8 năm kỷ niệm ngày cưới của SninOBIKER! Naruto Uzumaki ( Chế độ triết học) nhập vai với tư cách là một nhân vật dễ chơi trong một cập nhật miễn phí!\n(Tiếng Tây Ban Nha) (Tiếng Tây Ban Nha) Học ninjutsu từ 4 bậc thầy khác nhau bao gồm Jiraiya ( Chế độ lão luyện) và Naruto Uzumaki ( Chế độ triết học) và tự đào tạo ninja nguyên bản của bạn!\nSố lần xuất bản và xuất bản tối đa Deluxe\nẤn bản Deluxe bao gồm: • NARUTO to BORUTO: SHINOIBER (trò chơi đầy đủ) • Mùa trôi qua 1\nẤn bản tối thượng bao gồm: • NARUTO to BORUTO: SHINOIBER (trò chơi đầy đủ) • Mùa trôi qua 1 • Mùa qua 2 • Mùa ba • Mùa qua 4\nGiới thiệu về trò chơi\nThương hiệu Naruto đã trở lại với một kinh nghiệm mới ở NARUTO TO BORUTO: SHINOIKER! Trò chơi mới này cho phép các game thủ chiến đấu với tư cách là một đội 4 để cạnh tranh với các đội khác trực tuyến! Theo giao diện đồ họa, SHINOIB SIS SISKER cũng được xây dựng từ mặt đất lên theo một kiểu đồ họa hoàn toàn mới. Dẫn đội của anh và chiến đấu trực tuyến để xem ai là những ninja giỏi nhất!","aboutGame":"Thương hiệu Naruto đã trở lại với một kinh nghiệm mới ở NARUTO TO BORUTO: SHINOIKER! Trò chơi mới này cho phép các game thủ chiến đấu với tư cách là một đội 4 để cạnh tranh với các đội khác trực tuyến! Theo giao diện đồ họa, SHINOIB SIS SISKER cũng được xây dựng từ mặt đất lên theo một kiểu đồ họa hoàn toàn mới. Dẫn đội của anh và chiến đấu trực tuyến để xem ai là những ninja giỏi nhất!"}},"media":{"images":[{"role":"header","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/633230/header.jpg?t=1790561704"},{"role":"capsule","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/633230/capsule_231x87.jpg?t=1790561704"}],"scre