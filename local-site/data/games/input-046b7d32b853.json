source before linking a canonical ID."],"research":{"steam":{"status":"success","checkedAt":"2026-10-15T10:49:21.121Z","error":null}},"steamMetadata":{"appId":"1623880","links":{"store":"https://store.steampowered.com/app/1623880/","officialWebsite":"https://www.noob-rpg.com/","support":"https://www.noob-online.com/support.php?add_ticket=9"},"storageRequirements":{"kind":"required_free_space","windows":{"minimum":{"value":15,"unit":"GB","display":"15 GB","approximateBytes":15000000000,"evidenceText":"Storage: 15 GB"},"recommended":{"value":15,"unit":"GB","display":"15 GB","approximateBytes":15000000000,"evidenceText":"Storage: 15 GB"}},"macos":{"minimum":{"value":4,"unit":"GB","display":"4 GB","approximateBytes":4000000000,"evidenceText":"Storage: 4 GB"},"recommended":{"value":8,"unit":"GB","display":"8 GB","approximateBytes":8000000000,"evidenceText":"Storage: 8 GB"}},"linux":{"minimum":null,"recommended":null},"note":"Steam publishes required free space, not the exact installed or download size."},"controllerSupport":{"level":"full","xboxCompatible":null,"xboxEvidence":null,"note":"Generic Steam controller support does not prove Xbox controller compatibility."},"playerModes":{"singlePlayer":true,"multiplayer":false,"coop":false,"onlineCoop":false,"localCoop":false,"lanCoop":false,"sharedOrSplitScreen":false,"pvp":false,"maximumPlayers":null,"maximumPlayersNote":"The public Steam app-details response does not provide a reliable exact player limit.","evidence":["Single-player"]},"genres":["Adventure","Indie","RPG"],"categories":[{"id":2,"description":"Single-player"},{"id":22,"description":"Steam Achievements"},{"id":28,"description":"Full controller support"},{"id":55,"description":"DualShock Controller Support"},{"id":56,"description":"DualShock Controller Support"},{"id":57,"description":"DualSense Controller Support"},{"id":58,"description":"DualSense Controller Support"},{"id":23,"description":"Steam Cloud"},{"id":62,"description":"Family Sharing"}]}},"content":{"status":"success","steamAppId":"1623880","steamName":"Noob - The Factionless","sourceUrl":"https://store.steampowered.com/app/1623880/","fetchedAt":"2026-10-16T08:11:28.553838+00:00","locales":{"en":{"status":"source","provider":"steam","shortDescription":"Lead a team of adventurers to the highest rank of all guilds!","detailedDescription":"Follow Baster the Neogician, Drek the Berserker, May the Cartomancer and Logs the Elementalist in their quest for the supreme level, and help them reach their Legendary Class to become part of the elite of the Horizon MMORPG!\n\nFace hundreds of monsters and wander around fantastic worlds to give your guild the place it deserves in the world of Olydri, among the mythic Noob, Justice, Roxxor and Pro Game Master guilds.\nBut the challenge you will face will not be limited to Horizon: your avatars will accomplish « real » quests in real life. History can be made both into the game and IRL!\n\nDo you have what it takes to get your team to level 100?\n\nGENERAL INFORMATION\n\n• Embody a team of 4 hardcore gamers and their video game avatars in a challenging and colorful RPG in a homage to the greatest J-RPGs!\n\n• Explore a huge world, fight intense battles and complete quests to level up your team\n\n• Customize your avatars with the best equipment you will loot in dungeons, grottos, chests and city shops!\n\n• Strengthen your team and upgrade your abilities by farming experience through the fights: adapt your skills to your fighting style or to the foes you encounter\n\n• Browse the world of Olydri and make your mark among the most powerful factions of the “Horizon” MMORPG, where the greatest players meet and fight!\n\n• Play the “real” players in the “real world” and find out who is behind your friends’ avatars… or your enemies’!\n\nSPECIAL FEATURES\n\n• An appealing graphic direction and “chibi” vibe as a homage to the greatest J-RPGs\n\n• A true RPG experience with 50+ hours of gameplay, 750+ avatars to interact with and 300+ maps to wander in","aboutGame":null},"vi":{"status":"translated","provider":"argos-translate-en_vi-1.9-ctranslate2-int8","translatedAt":"2026-10-16T11:05:26.698061+00:00","sourceHash":"c38c87cd01a95463da4061dd8791da1ee50d8f423164549cd473f5becb457559","reviewStatus":"machine_translation_unreviewed","shortDescription":"Dẫn một đội du hành lên vị trí cao nhất của tất cả các nhóm!","detailedDescription":"Hãy theo Baster Neogician, Dek người Berserker, May Cartomancer và nhật ký các yếu tố trong cuộc tìm kiếm của họ cho cấp cao nhất, và giúp họ đạt được huyền thoại của họ để trở thành một phần ưu tú của bộ phận của Chân trời Horizon MORPG!\nĐối mặt với hàng trăm quái vật và lang thang trong những thế giới tuyệt vời để cung cấp cho bạn một vị trí xứng đáng cho thế giới của loài người, trong số những con quái vật hoang đường Noob, Justice, Rosxlor và Pro Game Master guilds.  Nhưng thách thức mà các bạn sẽ phải đối mặt sẽ không giới hạn ở Horizon: nhân vật của các bạn sẽ hoàn thành nhiệm vụ thực sự của mình trong đời thực.  Lịch sử có thể được biến cả hai vào trò chơi và IRL!\nAnh có đủ khả năng để đưa đội của anh lên tầng 100 không?\nNHỮNG NGƯỜI KỂ LẠI\n• Thể hiện một đội gồm 4 game thủ cứng rắn và các nhân vật trong trò chơi điện tử trong một trò chơi chống tăng và đầy màu sắc trong sự tôn kính đối với J-RPG vĩ đại nhất!\n• Khám phá một thế giới rộng lớn, chiến đấu quyết liệt và hoàn thành nhiệm vụ để san bằng đội của bạn\n• Tuỳ biến các nhân vật có thể làm việc với những dụng cụ tốt nhất mà bạn sẽ cướp bóc trong ngục tối, những cái hang, những cái rương và những cửa hàng thành phố!\n• Hãy củng cố và nâng cao khả năng của bạn qua kinh nghiệm trồng trọt qua các trận đánh: điều chỉnh kỹ năng theo phong cách chiến đấu hoặc đối phó với kẻ thù\n• Duyệt thế giới của Olyrid và ghi dấu bạn trong số những phe phái hùng mạnh nhất của “Horizon MMORPG, nơi những cầu thủ vĩ đại nhất gặp gỡ và chiến đấu!\n• Chơi trò chơi “người chơi trong thế giới thực và tìm ra ai đứng đằng sau nhân vật bạn bè... hoặc kẻ thù của bạn!\nMỤC THƯỜNG LỆ\n• Một sự hướng dẫn đồ họa hấp dẫn và “cảm giác của người da trắng là một sự tôn kính đối với người J-RPG vĩ đại nhất\n• Một kinh nghiệm bắn lựu đạn với 50+h của trò chơi, 750+ Avatars tương tác với 300+ để đi lang thang trong","aboutGame":null}},"media":{"images":[{"role":"header","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1623880/header.jpg?t=1711357677"},{"role":"capsule","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1623880/capsule_231x87.jpg?t=1711357677"}],"screenshots":[{"id":0,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1623880/ss_a3047152601d3f696cfecdf53088c77d9f823744.600x338.jpg?t=1711357677","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1623880/ss_a3047152601d3f696cfecdf53088c77d9f823744.1920x1080.jpg?t=1711357677"},{"id":1,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1623880/ss_75d69a1d7d3f6dae19cea08cc803f02e0ef1b72f.600x338.jpg?t=1711357677","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1623880/ss_75d69a1d7d3f6dae19cea08cc803f02e0ef1b72f.1920x1080.jpg?t=1711357677"},{"id":2,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1623880/ss_7fb782509c6a4b3952388307d16a76abc6a842a4.600x338.jpg?t=1711357677","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1623880/ss_7fb782509c6a4b3952388307d16a76abc6a842a4.1920x1080.jpg?t=1711357677"},{"id":3,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1623880/ss_363f52181ccfec11cd6df96f97f27fe7f91b22a9.600x338.jpg?t=1711357677","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1623880/ss_363f52181ccfec11cd6df96f97f27fe7f91b22a9.1920x1080.jpg?t=1711357677"},{"id":4,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1623880/ss_71c29df2889a