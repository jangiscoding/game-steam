38.jpg?t=1773238074","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/424370/ss_682225e97487cd7dbed8a58cab6e4778884ebc3f.1920x1080.jpg?t=1773238074"},{"id":6,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/424370/ss_c523d2b64be2e638e0e4610f083213ed5ec8f507.600x338.jpg?t=1773238074","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/424370/ss_c523d2b64be2e638e0e4610f083213ed5ec8f507.1920x1080.jpg?t=1773238074"},{"id":7,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/424370/ss_34dfa8b1bff44edaf58e4f2a4679ceb6b44c4fb9.600x338.jpg?t=1773238074","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/424370/ss_34dfa8b1bff44edaf58e4f2a4679ceb6b44c4fb9.1920x1080.jpg?t=1773238074"}],"videos":[{"id":256935536,"name":"Wolcen: Endgame - Trailer","thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/256935536/movie.293x165.jpg?t=1678784725","highlight":true,"sources":[{"format":"hls_h264","url":"https://video.akamai.steamstatic.com/store_trailers/424370/547918/15e0746d55d7a5a0c26471908d2eae0035feb690/1751282299/hls_264_master.m3u8?t=1678784725"},{"format":"dash_h264","url":"https://video.akamai.steamstatic.com/store_trailers/424370/547918/15e0746d55d7a5a0c26471908d2eae0035feb690/1751282299/dash_h264.mpd?t=1678784725"},{"format":"dash_av1","url":"https://video.akamai.steamstatic.com/store_trailers/424370/547918/15e0746d55d7a5a0c26471908d2eae0035feb690/1751282299/dash_av1.mpd?t=1678784725"}],"sourceData":{"id":256935536,"name":"Wolcen: Endgame - Trailer","thumbnail":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/256935536/movie.293x165.jpg?t=1678784725","dash_av1":"https://video.akamai.steamstatic.com/store_trailers/424370/547918/15e0746d55d7a5a0c26471908d2eae0035feb690/1751282299/dash_av1.mpd?t=1678784725","dash_h264":"https://video.akamai.steamstatic.com/store_trailers/424370/547918/15e0746d55d7