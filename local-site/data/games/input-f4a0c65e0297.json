h":{"steam":{"status":"success","checkedAt":"2026-10-15T10:01:19.528Z","error":null}},"steamMetadata":{"appId":"1388880","links":{"store":"https://store.steampowered.com/app/1388880/","officialWebsite":"https://ddlc.plus/","support":null},"storageRequirements":{"kind":"required_free_space","windows":{"minimum":{"value":3,"unit":"GB","display":"3 GB","approximateBytes":3000000000,"evidenceText":"Storage: 3 GB"},"recommended":null},"macos":{"minimum":{"value":3,"unit":"GB","display":"3 GB","approximateBytes":3000000000,"evidenceText":"Storage: 3 GB"},"recommended":null},"linux":{"minimum":null,"recommended":null},"note":"Steam publishes required free space, not the exact installed or download size."},"controllerSupport":{"level":"unknown","xboxCompatible":null,"xboxEvidence":null,"note":"Generic Steam controller support does not prove Xbox controller compatibility."},"playerModes":{"singlePlayer":true,"multiplayer":false,"coop":false,"onlineCoop":false,"localCoop":false,"lanCoop":false,"sharedOrSplitScreen":false,"pvp":false,"maximumPlayers":null,"maximumPlayersNote":"The public Steam app-details response does not provide a reliable exact player limit.","evidence":["Single-player"]},"genres":["Casual","Indie"],"categories":[{"id":2,"description":"Single-player"},{"id":22,"description":"Steam Achievements"},{"id":23,"description":"Steam Cloud"},{"id":62,"description":"Family Sharing"}]}},"content":{"status":"success","steamAppId":"1388880","steamName":"Doki Doki Literature Club Plus!","sourceUrl":"https://store.steampowered.com/app/1388880/","fetchedAt":"2026-10-16T08:02:14.322064+00:00","locales":{"en":{"status":"source","provider":"steam","shortDescription":"Welcome to the club! Write poems for your crush and experience the terror of school romance in this critically-acclaimed psychological horror story.","detailedDescription":"Enter the #1 Psychological Horror Experience!\n\nWelcome to a terrifying world of poetry and romance! Write poems for your crush and erase any mistakes along the way to ensure your perfect ending. Now’s your chance to discover why DDLC is one of the most beloved psychological horror games of the decade!\n\nYou play as the main character, who reluctantly joins the Literature Club in search of a romantic interest. With every poem you write and every choice you make, you’ll charm your crush and begin to unfold the horrors of school romance. Do you have what it takes to crack the code of dating sims and get the perfect ending?\n\nNow, the original mind-shattering DDLC experience is packed with tons of new features and content exclusive to Doki Doki Literature Club Plus!\nDoki Doki Literature Club Plus Features:\n\n• 6 new Side Stories about friendship and literature, totaling hours of new content\n\n• 100+ unlockable images including new game art, wallpapers, never-before-seen concept sketches, and more\n\n• 26 total music tracks, including 13 all-new unlockable songs by Nikki Kaelar, plus special guests Jason Hayes and Azuria Sky\n\n• A built-in DDLC music player to unwind with your favorite songs in a custom playlist, or loop a single track forever\n\n• A high-fidelity visual upgrade with all artwork now in Full HD (1080p)\n\nMeet the Literature Club!\n\nSayori – Sayori, your childhood friend, begins your story by recruiting you to the Literature Club! As a daydreamer full of positive energy, Sayori’s greatest passion is to deliver happiness to others.\nNatsuki – Natsuki tries to act tough, but her cuteness can make it hard to take her too seriously! She might be willing to warm up to good listeners who can respect her love for cute things.\nYuri – Yuri, the quiet bookworm, reserves her passionate side for those who can more deeply understand her enigmatic mind.\nMonika – Monika, the superstar President of the Literature Club, will keep you on track for a perfect ending. Monika is always there to give you a guiding hand, both in literature and in love!\n\nThis game is not suitable for children or those who are easily disturbed.","aboutGame":null},"vi":{"status":"pending_translation","provider":null,"shortDescription":null,"detailedDescription":null,"aboutGame":null}},"media":{"images":[{"role":"header","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1388880/2918402fa9090ab9ab944af2469d47d670007387/header.jpg?t=1769459840"},{"role":"capsule","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1388880/68f86b3672d4c01a0b8bba990f5e9b7ef3c5e937/capsule_231x87.jpg?t=1769459840"}],"screenshots":[{"id":0,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1388880/ss_cb187541437380ddf83c5195402d81f9895f34fb.600x338.jpg?t=1769459840","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1388880/ss_cb187541437380ddf83c5195402d81f9895f34fb.1920x1080.jpg?t=1769459840"},{"id":1,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1388880/ss_550d1ca934898f83c3cadd6587dd26010c0079c2.600x338.jpg?t=1769459840","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1388880/ss_550d1ca934898f83c3cadd6587dd26010c0079c2.1920x1080.jpg?t=1769459840"},{"id":2,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1388880/ss_d9bff154a32051d6d3b6b1c7492ce7c56e9d2231.600x338.jpg?t=1769459840","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1388880/ss_d9bff154a32051d6d3b6b1c7492ce7c56e9d2231.1920x1080.jpg?t=1769459840"},{"id":3,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1388880/ss_188001a5bfcfede5be35099f06f7b5ced2d2bcec.600x338.jpg?t=1769459840","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1388880/ss_188001a5bfcfede5be35099f06f7b5ced2d2bcec.1920x1080.jpg?t=1769459840"},{"id":4,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1388880/ss_8fd9449411f571d8d97ed1bb4c2349224612228e.600x338.jpg?t=176945