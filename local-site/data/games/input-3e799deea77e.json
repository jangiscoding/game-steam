ror":null}},"steamMetadata":{"appId":"367500","links":{"store":"https://store.steampowered.com/app/367500/","officialWebsite":null,"support":"http://www.capcom.co.jp/support/contact/"},"storageRequirements":{"kind":"required_free_space","windows":{"minimum":{"value":20,"unit":"GB","display":"20 GB","approximateBytes":20000000000,"evidenceText":"Storage: 20 GB"},"recommended":{"value":20,"unit":"GB","display":"20 GB","approximateBytes":20000000000,"evidenceText":"Storage: 20 GB"}},"macos":{"minimum":null,"recommended":null},"linux":{"minimum":null,"recommended":null},"note":"Steam publishes required free space, not the exact installed or download size."},"controllerSupport":{"level":"full","xboxCompatible":null,"xboxEvidence":null,"note":"Generic Steam controller support does not prove Xbox controller compatibility."},"playerModes":{"singlePlayer":true,"multiplayer":false,"coop":false,"onlineCoop":false,"localCoop":false,"lanCoop":false,"sharedOrSplitScreen":false,"pvp":false,"maximumPlayers":null,"maximumPlayersNote":"The public Steam app-details response does not provide a reliable exact player limit.","evidence":["Single-player"]},"genres":["Action","Adventure","RPG"],"categories":[{"id":2,"description":"Single-player"},{"id":22,"description":"Steam Achievements"},{"id":28,"description":"Full controller support"},{"id":29,"description":"Steam Trading Cards"},{"id":23,"description":"Steam Cloud"},{"id":25,"description":"Steam Leaderboards"},{"id":41,"description":"Remote Play on Phone"},{"id":42,"description":"Remote Play on Tablet"},{"id":43,"description":"Remote Play on TV"},{"id":62,"description":"Family Sharing"}]}},"content":{"status":"success","steamAppId":"367500","steamName":"Dragon's Dogma: Dark Arisen","sourceUrl":"https://store.steampowered.com/app/367500/","fetchedAt":"2026-10-16T09:05:22.267417+00:00","locales":{"en":{"status":"source","provider":"steam","shortDescription":"Set in a huge open world, Dragon’s Dogma: Dark Arisen presents a rewarding action combat experience.","detailedDescription":"Set in a huge open world, Dragon’s Dogma: Dark Arisen presents a rewarding action combat experience. Players embark on an epic adventure in a rich, living world with three AI companions, known as Pawns. These partners fight independently, demonstrating prowess and ability that they have developed based on traits learned from each player. PC users can share these Pawns online and reap rewards of treasure, tips and strategy hints for taking down the terrifying enemies. Pawns can also be borrowed when specific skills are needed to complete various challenging quests.\nFeatures\n\n• Dynamic combat experience – Cut off the four heads of a Hydra, climb atop griffins and fight airborne, or defeat dragons and other creatures by finding out their weaknesses.\n\n• Tons of content – Includes all previously released DLCs, pre-order bonuses, retailer-exclusives, and the Dark Arisen expansion content. Features the highly praised combat experience and rich customization, plus a huge underground realm to explore with terrifying monsters.\n\n• Customization options galore – Nine different vocations for players to choose from with a variety of skill options for each, armor that can be upgraded and enhanced, plus Pawn companions that can be trained to fit your desired combat style.\n\n• Stunning visuals – Beautiful high res graphics with increased fidelity.\n\n• Full Steam platform support – Includes Steam Achievements, Steam Cloud Save, Trading Cards, Leaderboards, Big Picture Mode support\n\n• Expanded controller support – In addition to supporting the traditional keyboard and mouse control scheme, the game natively supports Xbox 360, Xbox One, Steam Controller, and other DirectInput-based game pads such as the DualShock controller.\n\n• New Achievements  - 9 brand new Achievements for both new and returning Dragon’s Dogma fans!  Get ready to delve deep into Bitterblack Isle…","aboutGame":null},"vi":{"status":"translated","provider":"argos-translate-en_vi-1.9-ctranslate2-int8","translatedAt":"2026-10-16T12:55:12.690905+00:00","sourceHash":"420ea35d2c39dd13bf312f7bea94ac11c5953d849820e9a7553646797f13c02c","reviewStatus":"machine_translation_unreviewed","shortDescription":"Thiết lập một thế giới rộng lớn, có Giáo phái Rồng: Dark Remen trình bày một kinh nghiệm chiến đấu đầy thỏa nguyện.","detailedDescription":"Thiết lập một thế giới rộng lớn, có Giáo phái Rồng: Dark Remen trình bày một kinh nghiệm chiến đấu đầy thỏa nguyện. Những người chơi bắt đầu một cuộc phiêu lưu lịch sử trong một thế giới giàu có, sống với ba người bạn AI, được gọi là Binh Nhì. Những đối tác này chiến đấu một cách độc lập, thể hiện khả năng và khả năng mà họ đã phát triển dựa trên những tính cách học được từ mỗi người chơi. Người sử dụng máy tính có thể chia sẻ những con tốt này trên mạng và gặt hái phần thưởng của kho báu, những mẹo và chiến lược gợi ý cho việc tiêu diệt những kẻ thù đáng sợ. Binh Nhì cũng có thể mượn khi cần những kỹ năng cụ thể để hoàn thành những nhiệm vụ khó khăn. Tính năng\n• Kinh nghiệm chiến đấu động — chặt bốn đầu của Hydra, leo lên đỉnh núi cao và chiến đấu với không khí, hoặc đánh bại rồng và các sinh vật khác bằng cách tìm ra điểm yếu của chúng.\n• Hàng tấn nội dung — bao gồm tất cả các công ty DLCs đã được phát hành trước đây, tiền đặt hàng trước, bao gồm bán lẻ, và mở rộng Dark risen nội dung. Đặc điểm của kinh nghiệm chiến đấu được ca ngợi và sự tùy biến phong phú, cộng với một lĩnh vực rộng lớn dưới lòng đất để khám phá với những con quái vật đáng sợ.\n• Tùy chỉnh tùy chỉnh tùy chọn — chín nghề khác nhau để người chơi chọn từ nhiều cách lựa chọn khác nhau cho mỗi người, áo giáp có thể được nâng cấp và tăng cường, cộng với những bạn đồng hành cầm đồ có thể được huấn luyện để phù hợp với phong cách chiến đấu bạn muốn.\n• Hình ảnh phong phú — Trang phục đồ họa với độ trung thành ngày càng cao.\n• Hỗ trợ nền tảng bếp — Bao gồm cả nhà bếp, bảo vệ đám mây Steam, thiệp trao đổi, bảng điều khiển, chế độ hình ảnh lớn\n• Hỗ trợ khả năng điều khiển mở rộng – Ngoài việc hỗ trợ bộ màu truyền thống của bàn phím và bộ điều khiển chuột, trò chơi tự động hỗ trợ Xbox 360, Xbox 1, Steam Controller, và các bộ cờ chơi trực tiếp dựa trênput như bộ điều khiển DualShock.\n• Những khu sản xuất mới - 9 thương hiệu mới cho cả những người hâm mộ Dragon’s Dogma! Hãy sẵn sàng đào sâu vào đảo đen đắng...","aboutGame":null}},"media":{"images":[{"role":"header","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/367500/header.jpg?t=1768870344"},{"role":"capsule","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/367500/capsule_231x87.jpg?t=1768870344"}],"screenshots":[{"id":0,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/367500/ss_30ea02f49950fdc3a1b0dab358776f0779c643c7.600x338.jpg?t=1768870344","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/367500/ss_30ea02f49950fdc3a1b0dab358776f0779c643c7.1920x1080.jpg?t=1768870344"},{"id":1,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/367500/ss_a4636ec6717324f707d542f195c624698dc020d4.600x338.jpg?t=1768870344","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/367500/ss_a4636ec6717324f707d542f195c624698dc020d4.1920x1080.jpg?t=1768870344"},{"id":2,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/367500/ss_7c8c0dd0c00e1955c97d75d8bfbfc94f3e4acfac.600x338.jpg?t=1768870344","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/367500/ss_7c8c0dd0c00e1955c97d75d8bfbfc94f3e4acfac.1920x1080.jpg?t=1768870344"},{"id":3,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/367500/ss_38a4e23052bbb0d144128ee4f2d1940b5e1d422f.600x338.jpg?t=1768870344","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/367500/ss_38a4e23052bbb0d144128ee4f2d1940b5e1d422f.1920x1080.jpg?t=1768870344"},{"id":4,"thumb