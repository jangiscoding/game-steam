{"id":"input-8a6283f32e65","steamAppId":"441380","name":"PAC-MAN™ CHAMPIONSHIP EDITION 2","imageUrl":"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/441380/portrait.png","steamUrl":"https://store.steampowered.com/app/441380/","genres":["Casual"],"platforms":["windows"],"controllerSupport":"full","playerModes":{"singlePlayer":true,"multiplayer":false,"coop":false,"localCoop":false,"sharedOrSplitScreen":false,"onlineCoop":false,"maximumPlayers":null},"storage":{"windowsMinimumGB":3.0,"windowsMinimumDisplay":"3 GB"},"verificationStatus":"identified","supportsVietnamese":false,"vietnameseSupportStatus":"not_listed","steamTags":["Casual","Arcade","Classic","Great Soundtrack","Retro","Singleplayer","Score Attack","Difficult","Fast-Paced","Action"],"sourceProfile":{"shortDescription":"The much-awaited sequel to PAC-MAN™ CHAMPIONSHIP EDITION! Featuring eye-popping 3D graphics and funky visuals! New modes include Score Attack and an Adventure mode!","developers":["BANDAI NAMCO Studios Inc."]},"content":{"status":"success","fetchedAt":"2026-10-16T09:16:16.422093+00:00","identityStatus":"verified","locales":{"en":{"status":"source","shortDescription":"The much-awaited sequel to PAC-MAN™ CHAMPIONSHIP EDITION! Featuring eye-popping 3D graphics and funky visuals! New modes include Score Attack and an Adventure mode!","detailedDescription":"The much-awaited sequel to PAC-MAN™ CHAMPIONSHIP EDITION!\n\r\n\n\r\nFeaturing eye-popping 3D graphics and funky visuals, the latest version of the classic game takes chomping and chasing through mazes to a whole new level!\n\r\nMake up to four ghost trains for maximum chompage!\n\r\nNew modes include Score Attack and an Adventure Mode with fast fleeing fruit, big bad bosses, ridiculous remixed rules, and more!"},"vi":{"status":"translated","shortDescription":"Phần tiếp theo đang chờ đợi sự thay đổi công bằng của PAC-ManTM! Đồ họa 3D và hình ảnh lạ lùng! Chế độ mới bao gồm Ghi điểm Công kích và chế độ phiêu lưu!","detailedDe