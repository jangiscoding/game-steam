esearch":{"steam":{"status":"success","checkedAt":"2026-10-15T10:35:27.981Z","error":null}},"steamMetadata":{"appId":"22450","links":{"store":"https://store.steampowered.com/app/22450/","officialWebsite":"http://huntedthegame.com/","support":"http://support.bethsoft.com/"},"storageRequirements":{"kind":"required_free_space","windows":{"minimum":{"value":12,"unit":"GB","display":"12 GB","approximateBytes":12000000000,"evidenceText":"Hard Disk Space: 12 GB"},"recommended":{"value":12,"unit":"GB","display":"12 GB","approximateBytes":12000000000,"evidenceText":"Hard Disk Space: 12 GB"}},"macos":{"minimum":null,"recommended":null},"linux":{"minimum":null,"recommended":null},"note":"Steam publishes required free space, not the exact installed or download size."},"controllerSupport":{"level":"partial","xboxCompatible":null,"xboxEvidence":null,"note":"Generic Steam controller support does not prove Xbox controller compatibility."},"playerModes":{"singlePlayer":false,"multiplayer":false,"coop":false,"onlineCoop":false,"localCoop":false,"lanCoop":false,"sharedOrSplitScreen":false,"pvp":false,"maximumPlayers":null,"maximumPlayersNote":"The public Steam app-details response does not provide a reliable exact player limit.","evidence":[]},"genres":["Action","Adventure"],"categories":[{"id":18,"description":"Partial Controller Support"},{"id":23,"description":"Steam Cloud"},{"id":62,"description":"Family Sharing"}]}},"content":{"status":"success","steamAppId":"22450","steamName":"Hunted: The Demon’s Forge™","sourceUrl":"https://store.steampowered.com/app/22450/","fetchedAt":"2026-10-16T08:31:17.271202+00:00","locales":{"en":{"status":"source","provider":"steam","shortDescription":"It will take the combined efforts of two great warriors to explore menacing dungeons, overgrown ruins, and downtrodden towns … and discover the secrets of the Demon’s Forge.","detailedDescription":"Powered by the Unreal 3 engine, Hunted: The Demon’s Forge™ is a fresh take on the classic fantasy game that delivers the intensity and action of a modern-day shooter. Taking control of either E’lara, a ranged weapon expert, or Caddoc, a master swordsman, you and your partner will descend into a dark and foreboding world for an unforgettable cooperative experience. As you travel deep within the world of Kala Moor, you will use a variety of deadly weapons, powerful spells, and cover tactics to face down wave after wave of vicious enemies.  It will take the combined efforts of two great warriors to explore menacing dungeons, overgrown ruins, and downtrodden towns … and discover the secrets of the Demon’s Forge.\n\n\t\t\t\t\t\t\t\t\t\t\t\nKey Features:\n\t\t\t\t\t\t\t\t\t\t\t\n\n• An Unreal Dark Fantasy: Powered by the Unreal 3 engine, the dark world of Hunted comes to life as a third-person fantasy game with the intensity and action of a modern-day shooter.  Hunted boasts stunning visuals with breath-taking vistas and foreboding underground worlds.\n\t\t\t\t\t\t\t\t\t\t\t\n\n• Co-op at a Distance: Combine E’lara’s ranged attacks with Caddoc’s melee expertise to pull off gruesome co-op kill moves, perform special attacks, and heal one another from anywhere on the battlefield.  The characters’ differing combat expertise allows a player’s strategy to vary from one play through to the next.\n\t\t\t\t\t\t\t\t\t\t\t\n\n• Descend into Dungeon Depths: Work with your co-op partner to discover hidden paths and solve the devious puzzles that block your way. Explore menacing dungeons, overgrown ruins, and terrorized towns to discover treasure and powerful upgrades.\n\t\t\t\t\t\t\t\t\t\t\t\n\n• Two Ways to Fight: Wade into the thick of the fight using deadly melee skills, or tactically use cover to dispatch hordes of creatures with bows and spells. Use powerful magic to boost your partner’s combat effectiveness and even the odds against increasingly formidable enemies.\n\t\t\t\t\t\t\t\t\t\t\t\n\n• Forge Your Own Levels: Create and share your own challenging dungeon designs with The Crucible, a powerful in-game editor that provides endless opportunities for exploration and battles for you and your friends.","aboutGame":null},"vi":{"status":"pending_translation","provider":null,"shortDescription":null,"detailedDescription":null,"aboutGame":null}},"media":{"images":[{"role":"header","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/22450/header.jpg?t=1572894032"},{"role":"capsule","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/22450/capsule_231x87.jpg?t=1572894032"}],"screenshots":[{"id":0,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/22450/ss_bec73ec82b1c2396436318226f760de7e4969037.600x338.jpg?t=1572894032","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/22450/ss_bec73ec82b1c2396436318226f760de7e4969037.1920x1080.jpg?t=1572894032"},{"id":1,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/22450/ss_e489f67d6914b6c9dc886d6312c4a7387716564a.600x338.jpg?t=1572894032","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/22450/ss_e489f67d6914b6c9dc886d6312c4a7387716564a.1920x1080.jpg?t=1572894032"},{"id":2,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/22450/ss_7701a4dcbbd86bfa1735328d9c534ad905858a5c.600x338.jpg?t=1572894032","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/22450/ss_7701a4dcbbd86bfa1735328d9c534ad905858a5c.1920x1080.jpg?t=1572894032"},{"id":3,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/22450/ss_4a48dc859267840d185947a9f0582b823c0cebac.600x338.jpg?t=1572894032","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/22450/ss_4a48dc859267840d185947a9f0582b823c0cebac.1920x1080.jpg?t=1572894032"},{"id":4,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/22450/ss_d96c6deef27dcdc5584073c5894f070ac80fd849.600x338.jpg?t=1572894032"