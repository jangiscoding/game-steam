{"id":"input-9dbbb9fe35f5","steamAppId":"38440","name":"Sacrifice","imageUrl":"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/38440/library_600x900.jpg","steamUrl":"https://store.steampowered.com/app/38440/","genres":[],"platforms":["windows"],"controllerSupport":"unknown","playerModes":{"singlePlayer":true,"multiplayer":false,"coop":false,"localCoop":false,"sharedOrSplitScreen":false,"onlineCoop":false,"maximumPlayers":null},"storage":{"windowsMinimumGB":0.65,"windowsMinimumDisplay":"650 MB"},"verificationStatus":"identified","supportsVietnamese":false,"vietnameseSupportStatus":"not_listed","steamTags":["Strategy","RTS","Classic","Third Person","Fantasy","Surreal","Real-Time","Magic","Singleplayer","RPG","Multiplayer","Action"],"sourceProfile":{"shortDescription":"Sacrifice is the acclaimed real-time strategy game that focuses on combat instead of resource gathering. The only two resources you'll need to worry about are mana and souls. Need more units? Capture the souls of your enemy. Cast spells of awesome power.","developers":["Shiny Entertainment"]},"content":{"status":"success","fetchedAt":"2026-10-16T09:07:50.194082+00:00","identityStatus":"verified","locales":{"en":{"status":"source","shortDescription":"Sacrifice is the acclaimed real-time strategy game that focuses on combat instead of resource gathering. The only two resources you'll need to worry about are mana and souls. Need more units? Capture the souls of your enemy. Cast spells of awesome power.","detailedDescription":"Sacrifice is the acclaimed real-time strategy game that focuses on combat instead of resource gathering. The only two resources you'll need to worry about are mana and souls. Need more units? Capture the souls of your enemy. Cast spells of awesome power. Choose which gods to support and you will be rewarded with a different selection of spells. \n\n\t\t\t\t\tBanish your enemy by sacrificing one of your allies at his altar..."},"vi":{"status":"translated","shortDescri