icationNotes":["The supplied name exactly matches the normalized official Steam name for the supplied App ID."],"research":{"steam":{"status":"success","checkedAt":"2026-10-15T10:44:49.082Z","error":null}},"steamMetadata":{"appId":"1837580","links":{"store":"https://store.steampowered.com/app/1837580/","officialWebsite":"http://www.walesinteractive.com/miaandthedragonprincess","support":null},"storageRequirements":{"kind":"required_free_space","windows":{"minimum":{"value":9,"unit":"GB","display":"9 GB","approximateBytes":9000000000,"evidenceText":"Storage: 9 GB"},"recommended":{"value":9,"unit":"GB","display":"9 GB","approximateBytes":9000000000,"evidenceText":"Storage: 9 GB"}},"macos":{"minimum":{"value":9,"unit":"GB","display":"9 GB","approximateBytes":9000000000,"evidenceText":"Storage: 9 GB"},"recommended":null},"linux":{"minimum":null,"recommended":null},"note":"Steam publishes required free space, not the exact installed or download size."},"controllerSupport":{"level":"full","xboxCompatible":null,"xboxEvidence":null,"note":"Generic Steam controller support does not prove Xbox controller compatibility."},"playerModes":{"singlePlayer":true,"multiplayer":false,"coop":false,"onlineCoop":false,"localCoop":false,"lanCoop":false,"sharedOrSplitScreen":false,"pvp":false,"maximumPlayers":null,"maximumPlayersNote":"The public Steam app-details response does not provide a reliable exact player limit.","evidence":["Single-player"]},"genres":["Action","Adventure"],"categories":[{"id":2,"description":"Single-player"},{"id":22,"description":"Steam Achievements"},{"id":28,"description":"Full controller support"},{"id":55,"description":"DualShock Controller Support"},{"id":56,"description":"DualShock Controller Support"},{"id":57,"description":"DualSense Controller Support"},{"id":58,"description":"DualSense Controller Support"},{"id":23,"description":"Steam Cloud"},{"id":62,"description":"Family Sharing"}]}},"content":{"status":"success","steamAppId":"1837580","steamName":"Mia and the Dragon Princess","sourceUrl":"https://store.steampowered.com/app/1837580/","fetchedAt":"2026-10-16T08:17:12.834490+00:00","locales":{"en":{"status":"source","provider":"steam","shortDescription":"A live-action, interactive action movie following Mia, a plucky barmaid whose life is thrown into chaos when a mysterious woman turns up at her workplace, on the run from a group of violent thugs and unable to speak English.","detailedDescription":"📢 WISHLIST THE ISLE TIDE HOTEL\n\nAbout the Game\n\nA live-action, interactive action movie following Mia, a plucky barmaid whose life is thrown into chaos when a mysterious woman turns up at her workplace, on the run from a group of violent thugs and unable to speak English.\n\n• Starring Paul McGann (Doctor Who) and MyAnna Buring (The Witcher)\n\n• Starring 'Chinese Kickboxing' Black Belt, Dita Tantang\n\n• Fight stunts by martial artist 'Ginger Ninja Trickster' aka Aaron Gassor\n\n• Action designed by Marcus Shakesheff (WonderWoman, Guardians of the Galaxy, Game of Thrones)\n\n• Real-time Attribute Tracking that evolves based on your choices and influences the story\n\n• Multi-optional storytelling with 10 different outcomes\n\nMia dreams of adventure, but her feeling of responsibility to her workmates – who have become her surrogate family – keeps her working at a job she’s bored of, living a life she didn’t want. When a mysterious woman (Marshanda) turns up scared and on the run, Mia’s decision to take her under her wing and try to discover her identity leads her down a path of intrigue, mystery and danger.\n\nThe viewer’s choices will guide Mia through the adventure and will determine her fate, as well as that of the whole group. Throughout the game, your interactions could increase your knowledge around the identity of the mysterious woman, but the way Mia deals with the rest of the group will also have an impact, so each choice needs to be carefully considered.","aboutGame":"A live-action, interactive action movie following Mia, a plucky barmaid whose life is thrown into chaos when a mysterious woman turns up at her workplace, on the run from a group of violent thugs and unable to speak English.\n\n• Starring Paul McGann (Doctor Who) and MyAnna Buring (The Witcher)\n\n• Starring 'Chinese Kickboxing' Black Belt, Dita Tantang\n\n• Fight stunts by martial artist 'Ginger Ninja Trickster' aka Aaron Gassor\n\n• Action designed by Marcus Shakesheff (WonderWoman, Guardians of the Galaxy, Game of Thrones)\n\n• Real-time Attribute Tracking that evolves based on your choices and influences the story\n\n• Multi-optional storytelling with 10 different outcomes\n\nMia dreams of adventure, but her feeling of responsibility to her workmates – who have become her surrogate family – keeps her working at a job she’s bored of, living a life she didn’t want. When a mysterious woman (Marshanda) turns up scared and on the run, Mia’s decision to take her under her wing and try to discover her identity leads her down a path of intrigue, mystery and danger.\n\nThe viewer’s choices will guide Mia through the adventure and will determine her fate, as well as that of the whole group. Throughout the game, your interactions could increase your knowledge around the identity of the mysterious woman, but the way Mia deals with the rest of the group will also have an impact, so each choice needs to be carefully considered."},"vi":{"status":"pending_translation","provider":null,"shortDescription":null,"detailedDescription":null,"aboutGame":null}},"media":{"images":[{"role":"header","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1837580/header.jpg?t=1780398148"},{"role":"capsule","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1837580/130065492f1b1b0bbbfbd4e17d814cfbd76ec83f/capsule_231x87.jpg?t=1780398148"}],"screenshots":[{"id":0,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1837580/ss_2723fc4088e33695e9bc0b434684c644