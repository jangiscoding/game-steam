-10-15T10:48:10.981Z","error":null}},"steamMetadata":{"appId":"430070","links":{"store":"https://store.steampowered.com/app/430070/","officialWebsite":null,"support":null},"storageRequirements":{"kind":"required_free_space","windows":{"minimum":{"value":1,"unit":"GB","display":"1 GB","approximateBytes":1000000000,"evidenceText":"Storage: 1 GB"},"recommended":{"value":1,"unit":"GB","display":"1 GB","approximateBytes":1000000000,"evidenceText":"Storage: 1 GB"}},"macos":{"minimum":null,"recommended":null},"linux":{"minimum":null,"recommended":null},"note":"Steam publishes required free space, not the exact installed or download size."},"controllerSupport":{"level":"full","xboxCompatible":null,"xboxEvidence":null,"note":"Generic Steam controller support does not prove Xbox controller compatibility."},"playerModes":{"singlePlayer":true,"multiplayer":false,"coop":false,"onlineCoop":false,"localCoop":false,"lanCoop":false,"sharedOrSplitScreen":false,"pvp":false,"maximumPlayers":null,"maximumPlayersNote":"The public Steam app-details response does not provide a reliable exact player limit.","evidence":["Single-player"]},"genres":["Adventure","Indie"],"categories":[{"id":2,"description":"Single-player"},{"id":22,"description":"Steam Achievements"},{"id":28,"description":"Full controller support"},{"id":29,"description":"Steam Trading Cards"},{"id":62,"description":"Family Sharing"}]}},"content":{"status":"success","steamAppId":"430070","steamName":"Never Again","sourceUrl":"https://store.steampowered.com/app/430070/","fetchedAt":"2026-10-16T09:15:01.138757+00:00","locales":{"en":{"status":"source","provider":"steam","shortDescription":"Never Again - Horror/first-person Quest. The main essence of the game is research locations and puzzles, plunging in the dramatic story of a little girl suffering from asthma.","detailedDescription":"Never Again - Horror/first-person Quest. The main essence of the game is research locations and puzzles, plunging in the dramatic story of a little girl suffering from asthma.\n\nThe main character - Sasha Anders, a thirteen year old girl who awakens from a nightmare. The world seems to be upside down for her. Everything becomes so strange. The house is imbued with loneliness and longing and it seems strange to our character considering it was always dominated by love and harmony. Everywhere except for the heroine's room, suspiciously darkens, without even a single sound. Her parents and younger brother have gone missing. The girl is smart and sensible beyond her years, but each person has their own fears, and sometimes they cannot cope. This is especially troubling Sasha, due to the slightest fear, she feels suffocated. \n\nThe story that we'll tell you penetrates deep in your heart and leaves the experience forever. The saddest part of this mystical tale, is that it is not a tale at all. This is the story of a little girl, the story of Sasha Anders.","aboutGame":null},"vi":{"status":"translated","provider":"argos-translate-en_vi-1.9-ctranslate2-int8","translatedAt":"2026-10-16T13:02:27.606657+00:00","sourceHash":"6fe03e390e33b41063017ffbccdc76bcced44eb6fe233e93a194762a92b4f164","reviewStatus":"machine_translation_unreviewed","shortDescription":"Không bao giờ nữa - Tìm kiếm người đầu tiên. Bản chất chính của trò chơi là các vị trí nghiên cứu và câu đố, nhấn mạnh vào câu chuyện đầy kịch tính về một cô bé bị hen suyễn.","detailedDescription":"Không bao giờ nữa - Tìm kiếm người đầu tiên. Bản chất chính của trò chơi là các vị trí nghiên cứu và câu đố, nhấn mạnh vào câu chuyện đầy kịch tính về một cô bé bị hen suyễn.\nNhân vật chính là Sasha Anders, một cô bé 13 tuổi tỉnh dậy sau cơn ác mộng. Thế giới dường như đảo lộn với cô ấy. Mọi thứ trở nên thật lạ lùng. Ngôi nhà ngập tràn sự cô đơn và khao khát và có vẻ lạ lẫm đối với nhân vật của chúng ta vì nó luôn bị chi phối bởi tình yêu và sự hòa hợp. Mọi nơi ngoại trừ phòng của nữ anh hùng, những bóng tối đáng ngờ, mà không hề có một âm thanh nào. Cha mẹ và em trai cô ấy đã mất tích. Cô gái thông minh và nhạy cảm hơn những năm qua, nhưng mỗi người đều có nỗi sợ riêng, và đôi khi họ không thể đối phó. Điều này đặc biệt làm Sasha lo lắng, vì nỗi sợ nhỏ nhất, cô ấy cảm thấy nghẹt thở.\nCâu chuyện mà chúng tôi sẽ kể cho bạn thấu sâu vào trái tim bạn và để lại trải nghiệm đó mãi mãi. Điều đáng buồn nhất của câu chuyện huyền bí này là nó không phải là một câu chuyện. Đây là câu chuyện về một cô bé, câu chuyện về Sasha Anders.","aboutGame":null}},"media":{"images":[{"role":"header","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/430070/header.jpg?t=1667031239"},{"role":"capsule","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/430070/capsule_231x87.jpg?t=1667031239"}],"screenshots":[{"id":0,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/430070/ss_b5fd8c8ae859540478ff5c25337eb9c2e8fe35fe.600x338.jpg?t=1667031239","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/430070/ss_b5fd8c8ae859540478ff5c25337eb9c2e8fe35fe.1920x1080.jpg?t=1667031239"},{"id":1,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/430070/ss_b0f7c2d624d1c97c327ab63f6e0483b38cebe385.600x338.jpg?t=1667031239","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/430070/ss_b0f7c2d624d1c97c327ab63f6e0483b38cebe385.1920x1080.jpg?t=1667031239"},{"id":2,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/430070/ss_28b1e215b22621f6610381d0600bb0a4111b675b.600x338.jpg?t=1667031239","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/430070/ss_28b1e215b22621f6610381d0600bb0a4111b675b.1920x1080.jpg?t=1667031239"},{"id":3,"thumbnailUrl":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/430070/ss_69f3691442fa66fbef023fefd982601dbbc41f65.600x338.jpg?t=1667031239","url":"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/430070/ss_69f3691